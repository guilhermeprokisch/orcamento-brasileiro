---
/**
 * PROTÓTIPO, versão 2, "Comece pela sua cidade": a primeira coisa é escolher um lugar e ver quanto chegou lá
 * (de /data/mapa/emendas.json, o mesmo arquivo do mapa); depois, seis perguntas com resposta curta; depois, o
 * Brasil inteiro num painel; no fim, as portas do explorador.
 */
import Termo from "../Termo.astro";
import SerieTipos from "./SerieTipos.astro";
import MapaEstados from "./MapaEstados.astro";
import Explorar from "./Explorar.astro";
import { moedaCurta, moedaExtenso } from "../../lib/formato";
import { ANO, cidades, nomeArea, panorama, POR_MORADOR, porEstado, resumo, TIPO, TIPOS, TOTAL, totalAno } from "../../lib/emendas-panorama";
import "../../styles/onde.css";

const p = panorama!;
const c = cidades()!;
const estados = porEstado();
const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
const ano = p.serie.find((x) => x.ano === ANO)!;
const pct = (v: number) => `${Math.round((v / totalAno(ano)) * 100)}%`;
const exemplos = [
  { ...c.maisPorHab[0], dica: "a que mais recebe por morador" },
  { ...c.meio, dica: "uma cidade no meio" },
  { ...c.maior, dica: "a maior do país" },
];
const medEstados = [...estados].sort((a, b) => a.porHab - b.porHab)[estados.length >> 1].porHab;
const base = { ano: ANO, brasil: c.mediana, faixas: c.faixas.map((f) => ({ rotulo: f.rotulo, de: f.de, ate: Number.isFinite(f.ate) ? f.ate : null, mediana: f.mediana })), estados: medEstados };
const [sp, ap] = [estados.find((e) => e.uf === "SP")!, estados[0]];
const relator = p.serie.map((x) => ({ ano: x.ano, v: x.Relator }));
const maxRel = Math.max(...relator.map((x) => x.v));
---

<div class="cidade-primeiro" data-cidade-primeiro data-base={JSON.stringify(base)}>
  <header class="abre">
    <span class="sobretitulo">Emendas parlamentares · {ANO}</span>
    <h1>Quanto os deputados e senadores mandaram para a sua cidade?</h1>
    <p>
      <Termo id="emenda-parlamentar">Emenda</Termo> é o dinheiro federal que um deputado ou senador escolhe para onde vai. Em {ANO} foram
      {" "}<strong>{moedaExtenso(TOTAL)}</strong>, quase todo para prefeituras. Veja o que chegou aí:
    </p>
    <div class="onde grande" data-onde>
      <span id="v2-onde-rotulo" class="visually-hidden">Sua cidade ou estado</span>
      <div class="onde-campo">
        <span class="chip" data-chip hidden><span data-chip-texto></span><button type="button" aria-label="Tirar o lugar" data-chip-tirar>✕</button></span>
        <input type="search" data-onde-input role="combobox" aria-labelledby="v2-onde-rotulo" aria-expanded="false" aria-controls="v2-onde-lista" aria-autocomplete="list" placeholder="Digite sua cidade ou seu estado" autocomplete="off" />
      </div>
      <div class="onde-lista" id="v2-onde-lista" role="listbox" data-onde-lista hidden></div>
    </div>
    <p class="exemplos">Ou veja: {exemplos.map((e, i) => <><button type="button" data-exemplo={e.ibge}>{e.nome} ({e.uf})</button> <small>{e.dica}</small>{i < exemplos.length - 1 ? " · " : ""}</>)}</p>
  </header>

  <section class="resposta" data-resposta hidden aria-live="polite"></section>

  <section class="perguntas">
    <h2>Entenda em seis perguntas</h2>
    <div class="cartas">
      <details open>
        <summary>O que é uma emenda?</summary>
        <p>Todo ano o governo escreve o orçamento e manda ao Congresso. Deputados e senadores mudam um pedaço dele: indicam uma cidade, uma entidade e uma finalidade (um posto de saúde, um trator, um asfalto). Essa mudança é a emenda, e o dinheiro sai do orçamento federal.</p>
      </details>
      <details>
        <summary>Quem escolhe, e quanto?</summary>
        <p>Os 513 deputados e 81 senadores, cada um com a sua cota, e também grupos: as bancadas de cada estado e as comissões do Congresso. Em {ANO}, um parlamentar mandou, no meio, {moedaCurta(p.contagem.mediana_individual)}.</p>
        <ul class="mini-tipos">{TIPOS.map((t) => <li><i style={`background:${t.cor}`}></i><Termo id={t.termo}>{t.nome}</Termo><span class="num">{pct(ano[t.id])}</span></li>)}</ul>
      </details>
      <details>
        <summary>O governo é obrigado a pagar?</summary>
        <p>Na maior parte, sim: são <Termo id="emenda-impositiva">impositivas</Termo>. Antes, o governo pagava se quisesse, e usava isso para negociar votos.</p>
        <ol class="linha-tempo">
          <li><b>2015</b> As individuais passam a ser obrigatórias, até 1,2% da receita da União; metade para a saúde.</li>
          <li><b>2019</b> As de bancada também.</li>
          <li><b>2022</b> A cota individual sobe para 2% da receita.</li>
        </ol>
      </details>
      <details>
        <summary>O que é a “emenda Pix”?</summary>
        <p>É a <Termo id="emenda-pix">transferência especial</Termo>: o dinheiro cai direto no caixa da prefeitura, sem um convênio que diga em que vai ser gasto. Em {ANO} foram {moedaCurta(ano.Pix)}, {pct(ano.Pix)} do total. Desde 2024 o Supremo exige que a prefeitura diga o que vai fazer.</p>
        <p><a href="/emendas?fonte=Plano%20de%20emenda%20Pix&q=pavimentação">Veja o que as prefeituras disseram que fariam →</a></p>
      </details>
      <details>
        <summary>O que foi o “orçamento secreto”?</summary>
        <p>De 2020 a 2022, bilhões saíram como <Termo id="emenda-de-relator">emendas de relator</Termo>: no papel, quem mandava era o relator do orçamento, e não se sabia que deputado ou senador tinha pedido. O Supremo proibiu em dezembro de 2022. Hoje só se pagam restos antigos.</p>
        <div class="mini-serie" aria-label="Emendas de relator pagas por ano">{relator.map((x) => <span><i style={`height:${(x.v / maxRel) * 100}%`}></i><small>{String(x.ano).slice(2)}</small></span>)}</div>
      </details>
      <details>
        <summary>Por que cidades pequenas recebem mais?</summary>
        <p>Todo estado tem pelo menos 8 deputados e 3 senadores, e as cotas são iguais. Então o dinheiro por morador é muito maior onde mora pouca gente: o Amapá recebeu R$ {nf0.format(ap.porHab)} por pessoa, São Paulo R$ {nf0.format(sp.porHab)}. Nas cidades de até 5 mil moradores, o meio foi R$ {nf0.format(c.faixas[0].mediana)}; nas de mais de 500 mil, R$ {nf0.format(c.faixas.at(-1)!.mediana)}.</p>
      </details>
    </div>
  </section>

  <section class="painel-brasil">
    <h2>O Brasil inteiro</h2>
    <div class="numeros">
      <div><span>Pago em {ANO}</span><strong>{moedaCurta(TOTAL)}</strong></div>
      <div><span>Por morador</span><strong>R$ {nf0.format(POR_MORADOR)}</strong></div>
      <div><span>Emendas pagas</span><strong>{nf0.format(p.contagem.emendas)}</strong></div>
      <div><span>Para a saúde</span><strong>{Math.round(((p.areas.find(([a]) => a === "Saúde")?.[1] ?? 0) / TOTAL) * 100)}%</strong></div>
    </div>
    <div class="grade-painel">
      <div class="bloco largo"><h3>Ano a ano, por tipo</h3><SerieTipos compacto /></div>
      <div class="bloco"><h3>Por morador, em cada estado</h3><MapaEstados /></div>
      <div class="bloco">
        <h3>Para quê</h3>
        <ol class="lista">{p.areas.slice(0, 6).map(([a, v]) => <li><span>{nomeArea(a)}</span><span class="num">{moedaCurta(v)}</span></li>)}</ol>
      </div>
      <div class="bloco">
        <h3>Quem mais mandou</h3>
        <ol class="lista">{resumo!.autores.slice(0, 6).map(([a, v]) => <li><a href={`/emendas?autor=${encodeURIComponent(a)}&ano=${ANO}`}>{a}</a><span class="num">{moedaCurta(v)}</span></li>)}</ol>
      </div>
      <div class="bloco">
        <h3>Comissões e bancadas</h3>
        <ol class="lista">{p.coletivos.slice(0, 6).map(([a, , v]) => <li><a href={`/emendas?autor=${encodeURIComponent(a)}&ano=${ANO}`}>{a}</a><span class="num">{moedaCurta(v)}</span></li>)}</ol>
      </div>
    </div>
  </section>

  <Explorar id="explore-2" titulo="Explore mais" />
</div>

<style>
  .abre { padding: 40px 0 28px; max-width: 900px; display: flex; flex-direction: column; gap: 14px; }
  .abre h1 { font-size: 54px; line-height: 1.02; letter-spacing: -0.025em; }
  .abre > p { margin: 0; font-size: 19px; line-height: 1.55; color: var(--texto-2); }
  .cidade-primeiro :global([hidden]) { display: none !important; }
  .onde.grande { max-width: 620px; flex: none; }
  .onde.grande .onde-campo { min-height: 56px; border-width: 2px; }
  .onde.grande input { font-size: 20px !important; padding: 12px 14px !important; }
  .exemplos { margin: 0; font-size: 15px; color: var(--texto-3); line-height: 1.8; }
  .exemplos button { font: inherit; font-size: 15px; font-weight: 600; color: var(--verde); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .resposta { border: 2px solid var(--tinta); background: #fff; padding: 24px; margin-bottom: 24px; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 24px 40px; }
  .resposta[hidden] { display: none; }
  .perguntas, .painel-brasil { border-top: 2px solid var(--tinta); padding: 28px 0; display: flex; flex-direction: column; gap: 16px; }
  .perguntas h2, .painel-brasil h2 { font-size: 34px; line-height: 1.1; }
  .cartas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; align-items: start; }
  details { border: 1px solid var(--tinta); background: #fff; padding: 0 16px; }
  details[open] { padding-bottom: 14px; }
  summary { cursor: pointer; list-style: none; padding: 14px 0; font-family: var(--serifa); font-weight: 700; font-size: 20px; line-height: 1.2; display: flex; justify-content: space-between; gap: 10px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-family: var(--sans); font-weight: 400; font-size: 22px; line-height: 1; }
  details[open] summary::after { content: "−"; }
  details p { margin: 0 0 10px; font-size: 15px; line-height: 1.55; color: var(--texto-2); }
  .mini-tipos { list-style: none; margin: 0; padding: 0; font-size: 14px; }
  .mini-tipos li { display: flex; align-items: center; gap: 8px; padding: 4px 0; border-bottom: 1px solid var(--regra-leve); }
  .mini-tipos i { width: 12px; height: 12px; }
  .mini-tipos .num { margin-left: auto; font-weight: 600; }
  .linha-tempo { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 14px; line-height: 1.45; color: var(--texto-2); }
  .linha-tempo b { display: inline-block; min-width: 44px; color: var(--verde); }
  .mini-serie { display: flex; align-items: flex-end; gap: 4px; height: 70px; }
  .mini-serie span { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; }
  .mini-serie i { display: block; background: #5c574c; min-height: 1px; }
  .mini-serie small { font-size: 10px; text-align: center; color: var(--texto-3); }
  .numeros { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; border-top: 1px solid var(--tinta); padding-top: 12px; }
  .numeros div { display: flex; flex-direction: column; gap: 2px; }
  .numeros span { font-size: 13px; color: var(--texto-3); }
  .numeros strong { font-family: var(--serifa); font-size: 34px; }
  .grade-painel { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 32px; }
  .bloco { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .bloco.largo { grid-column: span 2; }
  h3 { font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--texto-2); margin: 0; }
  .lista { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--tinta); }
  .lista li { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid var(--regra); font-size: 14.5px; }
  @media (max-width: 900px) {
    .abre { padding: 28px 0 20px; }
    .abre h1 { font-size: 34px; }
    .abre > p { font-size: 16.5px; }
    .resposta { grid-template-columns: minmax(0, 1fr); padding: 16px; }
    .perguntas h2, .painel-brasil h2 { font-size: 26px; }
    .cartas { grid-template-columns: minmax(0, 1fr); }
    summary { font-size: 18px; }
    .numeros { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .numeros strong { font-size: 26px; }
    .grade-painel { grid-template-columns: minmax(0, 1fr); }
    .bloco.largo { grid-column: auto; }
  }
</style>

<style is:global>
  /* A resposta é montada no navegador, fora do escopo do Astro. */
  [data-resposta] h2 { font-size: 34px; line-height: 1.1; }
  [data-resposta] .sobre { font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--texto-3); }
  [data-resposta] .grande { font-family: var(--serifa); font-size: 48px; font-weight: 700; line-height: 1; margin: 8px 0 4px; }
  [data-resposta] p { margin: 0 0 10px; font-size: 16px; line-height: 1.55; color: var(--texto-2); }
  [data-resposta] .comp { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  [data-resposta] .comp li { display: grid; grid-template-columns: 150px minmax(0, 1fr) 70px; gap: 10px; align-items: center; font-size: 14px; }
  [data-resposta] .comp i { display: block; height: 14px; background: var(--areia); }
  [data-resposta] .comp li.aqui i { background: var(--verde); }
  [data-resposta] .comp li.aqui { font-weight: 600; }
  [data-resposta] .comp strong { text-align: right; }
  [data-resposta] ol.autores { list-style: none; margin: 6px 0 12px; padding: 0; border-top: 1px solid var(--tinta); }
  [data-resposta] ol.autores li { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid var(--regra); font-size: 15px; }
  [data-resposta] .acoes { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  [data-resposta] .acoes a { font-weight: 600; padding: 9px 14px; background: var(--tinta); color: var(--papel); text-decoration: none; }
  [data-resposta] .acoes a.leve { background: transparent; color: var(--tinta); border: 1px solid var(--tinta); }
  @media (max-width: 900px) {
    [data-resposta] h2 { font-size: 26px; }
    [data-resposta] .grande { font-size: 38px; }
    [data-resposta] .comp li { grid-template-columns: 110px minmax(0, 1fr) 60px; font-size: 13px; }
  }
</style>

<script is:inline type="module">
  const raiz = document.querySelector("[data-cidade-primeiro]");
  const base = JSON.parse(raiz.dataset.base);
  const saida = raiz.querySelector("[data-resposta]");
  const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
  const nf1 = new Intl.NumberFormat("pt-BR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const curto = (v) => (v >= 1e9 ? `R$ ${nf1.format(v / 1e9)} bi` : v >= 1e6 ? `R$ ${nf1.format(v / 1e6)} mi` : `R$ ${nf0.format(v / 1e3)} mil`);
  const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
  let dados;
  const carregar = () => (dados ??= fetch("/data/mapa/emendas.json").then((r) => r.json()));

  async function mostrar(l) {
    if (!l) { saida.hidden = true; return; }
    const d = await carregar();
    const uf = l.tipo === "uf";
    const x = (uf ? d.uf : d.mun)[l.codigo];
    saida.hidden = false;
    if (!x || !x[0]) { saida.innerHTML = `<div><span class="sobre">${uf ? "Estado" : "Cidade"}</span><h2>${esc(l.rotulo)}</h2><p>Nenhuma emenda paga a quem fica aqui em ${base.ano}.</p></div>`; return; }
    const [total, pref, ent, est, porHab] = x;
    const pop = total / porHab;
    const faixa = base.faixas.find((f) => pop >= f.de && (f.ate === null || pop < f.ate));
    const comps = uf
      ? [["Aqui", porHab, true], ["Estado do meio", base.estados]]
      : [["Aqui", porHab, true], [`Cidades ${faixa.rotulo.replace(/^até/, "de até")}`, faixa.mediana], ["Cidade do meio do Brasil", base.brasil]];
    const max = Math.max(...comps.map((c) => c[1]));
    const vezes = porHab / comps[1][1];
    const autores = (d.autores[l.codigo] ?? []).map(([i, v]) => [d.nomesAutores[i], v]);
    saida.innerHTML = `
      <div>
        <span class="sobre">${uf ? "Estado" : "Cidade"} · ${base.ano}</span>
        <h2>${esc(l.rotulo)}</h2>
        <div class="grande">${curto(total)}</div>
        <p>em emendas, ou <strong>R$ ${nf0.format(porHab)} por morador</strong>: ${vezes >= 1.15 ? `${nf1.format(vezes)} vezes o` : vezes <= 0.87 ? `${nf0.format((1 - vezes) * 100)}% menos que o` : "perto do"} ${uf ? "estado do meio" : `meio das cidades ${faixa.rotulo.replace(/^até/, "de até")}`}.</p>
        <ol class="comp">${comps.map(([n, v, aqui]) => `<li class="${aqui ? "aqui" : ""}"><span>${esc(n)}</span><i style="width:${(v / max) * 100}%"></i><strong>R$ ${nf0.format(v)}</strong></li>`).join("")}</ol>
        <p style="margin-top:12px">${uf ? `${curto(pref)} para as prefeituras, ${curto(est)} para o governo do estado e outros órgãos, ${curto(ent)} para entidades e empresas.` : `${curto(pref)} para a prefeitura${ent > 0 ? ` e ${curto(ent)} para entidades e empresas da cidade` : ""}.`}</p>
      </div>
      <div>
        ${autores.length ? `<h3 style="font-family:var(--sans);font-size:15px;margin:0">Quem mais mandou</h3><ol class="autores">${autores.map(([a, v]) => `<li><a href="/emendas?autor=${encodeURIComponent(a)}&ano=${base.ano}">${esc(a)}</a><span>${curto(v)}</span></li>`).join("")}</ol>` : ""}
        <div class="acoes">
          <a href="/emendas?ente=${l.codigo}&ano=${base.ano}">Ver emenda por emenda →</a>
        </div>
      </div>`;
  }

  const { ligarOnde, carregarLugares } = await import("/explorador/onde.js");
  const campo = ligarOnde(raiz.querySelector("[data-onde]"), mostrar, { prefixo: "v2-onde" });
  const escolher = async (codigo) => { await campo.definir(codigo); mostrar((await carregarLugares()).porCodigo.get(codigo)); };
  raiz.querySelectorAll("[data-exemplo]").forEach((b) => b.addEventListener("click", () => escolher(b.dataset.exemplo)));
  // ?lugar=código já abre um lugar (para mandar o link).
  const pedido = new URLSearchParams(location.search).get("lugar");
  if (pedido) escolher(pedido);
</script>
