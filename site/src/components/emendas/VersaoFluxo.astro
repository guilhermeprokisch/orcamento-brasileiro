---
/**
 * PROTÓTIPO, versão 3, "Siga o dinheiro": o diagrama do ano inteiro (tipo → quem recebe → para quê) é a página.
 * Clicar num pedaço acende as faixas dele e abre, ao lado, a explicação, os números e por onde continuar no
 * explorador. Perguntas prontas acendem os pedaços mais pedidos. Embaixo, o ano a ano e os estados, em abas.
 */
import Termo from "../Termo.astro";
import Fluxo from "./Fluxo.astro";
import SerieTipos from "./SerieTipos.astro";
import MapaEstados from "./MapaEstados.astro";
import Explorar from "./Explorar.astro";
import { moedaCurta, moedaExtenso } from "../../lib/formato";
import { ANO, cidades, nomeArea, nomeGrupo, panorama, POR_MORADOR, porEstado, resumo, TIPO, TIPOS, TOTAL, type Tipo } from "../../lib/emendas-panorama";

const p = panorama!;
const c = cidades()!;
const estados = porEstado();
const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
const cruz = p.cruzado;
const total = cruz.reduce((t, x) => t + x[3], 0);
const pct = (v: number) => `${Math.round((v / total) * 100)}%`;
const somaPor = (filtro: (x: (typeof cruz)[number]) => boolean, col: 0 | 1 | 2) => {
  const m = new Map<string, number>();
  cruz.filter(filtro).forEach((x) => m.set(x[col], (m.get(x[col]) ?? 0) + x[3]));
  return [...m].sort((a, b) => b[1] - a[1]);
};
const autorLink = (a: string) => `/emendas?autor=${encodeURIComponent(a)}&ano=${ANO}`;

const TEXTO_TIPO: Record<Tipo, string> = {
  Individual: "Cada um dos 513 deputados e 81 senadores tem uma cota igual e escolhe para onde vai. A Constituição manda que metade vá para a saúde, e o governo é obrigado a pagar.",
  Pix: "Uma parte da cota individual que cai direto no caixa da prefeitura ou do estado, sem um convênio que diga em que será gasta. Por isso não tem área: a prefeitura decide depois. Desde 2024 o Supremo exige um plano de uso.",
  Bancada: "Os deputados e senadores de cada estado se juntam e indicam emendas maiores, em geral para obras e hospitais no próprio estado. Também é de pagamento obrigatório.",
  "Comissão": "Indicadas pelas comissões da Câmara e do Senado. Não são obrigatórias e cresceram de R$ 0,3 bi em 2023 para mais de R$ 8 bi em 2024, depois do fim das de relator. Quem pediu cada uma nem sempre aparece.",
  Relator: "O antigo “orçamento secreto”: de 2020 a 2022, bilhões saíram em nome do relator do orçamento, sem dizer que parlamentar tinha pedido. O Supremo proibiu em dezembro de 2022. O que aparece agora são restos de anos anteriores.",
};
const TEXTO_GRUPO: Record<string, string> = {
  "Prefeitura": "A maior parte do dinheiro vai para as prefeituras, inclusive para os fundos municipais de saúde. A prefeitura é quem compra, contrata e presta contas.",
  "Governo estadual": "Secretarias e fundos dos governos estaduais, em geral para hospitais, estradas e segurança.",
  "Entidade sem fins lucrativos": "Associações, fundações, Santas Casas e organizações sociais. O dinheiro sai do governo, e acompanhar o que foi feito fica mais difícil.",
  "Empresa": "Pagamentos diretos a empresas: máquinas, veículos e obras que um órgão federal compra com o dinheiro da emenda e entrega ao lugar.",
  "Outros órgãos públicos": "Universidades, institutos federais, Forças Armadas e outros órgãos federais.",
};
const TEXTO_AREA: Record<string, string> = {
  "Saúde": "Postos de saúde, hospitais, equipamentos e o dia a dia da saúde da cidade. É o maior destino porque metade das individuais tem de ir para ela.",
  "Encargos especiais": "Não é uma área de verdade: é como o orçamento classifica as emendas Pix, que chegam sem dizer para quê. O que a prefeitura declarou que faria está nos planos das emendas Pix.",
  "Urbanismo": "Asfalto, calçamento, praças, iluminação e outras obras na cidade.",
  "Agricultura": "Tratores, máquinas agrícolas, estradas rurais e apoio a produtores.",
  "Educação": "Escolas, creches, ônibus escolares e equipamentos.",
  "Desporto e lazer": "Quadras, campos, ginásios e eventos esportivos.",
  "Outras áreas": "Assistência social, segurança, cultura, defesa, transporte e as que juntam várias áreas, somadas.",
};
const BUSCA_AREA: Record<string, string> = { "Saúde": "ambulância", "Urbanismo": "pavimentação", "Agricultura": "trator", "Educação": "creche", "Desporto e lazer": "quadra", "Encargos especiais": "pavimentação" };

type Painel = { id: string; titulo: string; cor?: string; termo?: string; valor: number; texto: string; listas: { titulo: string; itens: [string, number, string?][] }[]; link?: [string, string] };
const paineis: Painel[] = [
  ...TIPOS.map((t) => {
    const coletivos = p.coletivos.filter(([, x]) => x === t.id).slice(0, 5).map(([a, , v]) => [a, v, autorLink(a)] as [string, number, string]);
    const autores = t.id === "Individual" ? resumo!.autores.slice(0, 5).map(([a, v]) => [a, v, autorLink(a)] as [string, number, string]) : [];
    const painel: Painel = {
      id: `t:${t.id}`, titulo: t.nome, cor: t.cor, termo: t.termo, valor: cruz.filter((x) => x[0] === t.id).reduce((s, x) => s + x[3], 0), texto: TEXTO_TIPO[t.id],
      listas: [
        { titulo: "Para quem foi", itens: somaPor((x) => x[0] === t.id, 1).slice(0, 4).map(([k, v]) => [nomeGrupo(k), v] as [string, number]) },
        ...(autores.length ? [{ titulo: "Quem mais mandou (individuais e Pix)", itens: autores }] : []),
        ...(coletivos.length ? [{ titulo: t.id === "Bancada" ? "As bancadas que mais mandaram" : "As comissões que mais mandaram", itens: coletivos }] : []),
      ],
      link: t.id === "Pix" ? ["/emendas?fonte=Plano%20de%20emenda%20Pix&q=pavimentação", "O que as prefeituras disseram que fariam com as emendas Pix"] : undefined,
    };
    return painel;
  }),
  ...["Prefeitura", "Governo estadual", "Entidade sem fins lucrativos", "Empresa", "Outros órgãos públicos"].map((g) => ({
    id: `g:${g}`, titulo: nomeGrupo(g), valor: cruz.filter((x) => x[1] === g).reduce((s, x) => s + x[3], 0), texto: TEXTO_GRUPO[g],
    listas: [
      { titulo: "De que tipo", itens: somaPor((x) => x[1] === g, 0).map(([k, v]) => [TIPO[k as Tipo].nome, v] as [string, number]) },
      ...(g === "Entidade sem fins lucrativos" ? [{ titulo: "As entidades que mais receberam", itens: resumo!.entidades.slice(0, 5).map((e) => [e.nome.length > 48 ? `${e.nome.slice(0, 46)}…` : e.nome, e.valor, `/emendas?entidade=${e.codigo}`] as [string, number, string]) }]
        : [{ titulo: "Para quê", itens: somaPor((x) => x[1] === g, 2).slice(0, 4).map(([k, v]) => [nomeArea(k), v] as [string, number]) }]),
    ],
  })),
  ...[...new Set(cruz.map((x) => x[2]))].map((a) => ({
    id: `a:${a}`, titulo: nomeArea(a), valor: cruz.filter((x) => x[2] === a).reduce((s, x) => s + x[3], 0), texto: TEXTO_AREA[a] ?? "",
    listas: [{ titulo: "De que tipo", itens: somaPor((x) => x[2] === a, 0).map(([k, v]) => [TIPO[k as Tipo].nome, v] as [string, number]) }],
    link: BUSCA_AREA[a] ? [`/emendas?q=${encodeURIComponent(BUSCA_AREA[a])}${a === "Encargos especiais" ? "&fonte=Plano%20de%20emenda%20Pix" : ""}`, `Procurar “${BUSCA_AREA[a]}” nas emendas`] as [string, string] : undefined,
  })),
];
const PERGUNTAS: [string, string][] = [
  ["t:Pix", "O que é a emenda Pix?"], ["t:Relator", "O que foi o orçamento secreto?"], ["a:Saúde", "Quanto vai para a saúde?"],
  ["g:Entidade sem fins lucrativos", "Quanto vai para entidades?"], ["t:Comissão", "Por que as de comissão cresceram?"],
];
const [sp, ap] = [estados.find((e) => e.uf === "SP")!, estados[0]];
---

<div class="siga" data-fluxo-raiz>
  <header class="abre">
    <span class="sobretitulo">Emendas parlamentares · Brasil · {ANO}</span>
    <h1>Siga o dinheiro das emendas</h1>
    <p>
      <Termo id="emenda-parlamentar">Emenda</Termo> é a parte do orçamento federal que deputados e senadores escolhem para onde vai. Em {ANO} foram
      {" "}<strong class="marca">{moedaExtenso(TOTAL)}</strong> (R$ {nf0.format(POR_MORADOR)} por morador). Abaixo, todo esse dinheiro, de que tipo de emenda veio,
      quem recebeu e para quê. <strong>Clique em qualquer pedaço.</strong>
    </p>
  </header>

  <div class="perguntas" role="group" aria-label="Perguntas prontas">
    {PERGUNTAS.map(([id, t]) => <button type="button" data-pergunta={id}>{t}</button>)}
  </div>

  <div class="mesa">
    <div class="desenho">
      <Fluxo forma="largo" classe="so-largo" />
      <Fluxo forma="estreito" classe="so-estreito" />
    </div>
    <aside class="painel" aria-live="polite">
      <div data-painel="" class="ativo">
        <span class="sobre">Como ler</span>
        <h2>Cada faixa é um pedaço do dinheiro</h2>
        <p>A largura é o valor. As faixas saem do tipo de emenda (à esquerda), passam por quem recebeu (no meio) e chegam ao que se fez com o dinheiro (à direita). A cor é sempre a do tipo.</p>
        <ul class="leg">{TIPOS.map((t) => <li><i style={`background:${t.cor}`}></i><span><Termo id={t.termo}>{t.nome}</Termo></span><span class="num">{moedaCurta(cruz.filter((x) => x[0] === t.id).reduce((s, x) => s + x[3], 0))}</span></li>)}</ul>
        <p class="menor">Por que isso é obrigatório? Desde 2015, a maior parte das emendas é <Termo id="emenda-impositiva">impositiva</Termo>: o governo tem de pagar.</p>
      </div>
      {paineis.map((x) => (
        <div data-painel={x.id} hidden>
          <span class="sobre">{x.id.startsWith("t:") ? "Tipo de emenda" : x.id.startsWith("g:") ? "Quem recebeu" : "Para quê"}</span>
          <h2>{x.cor && <i class="cor" style={`background:${x.cor}`}></i>}{x.termo ? <Termo id={x.termo}>{x.titulo}</Termo> : x.titulo}</h2>
          <p class="valor"><strong>{moedaCurta(x.valor)}</strong> em {ANO} · {pct(x.valor)} do total</p>
          <p>{x.texto}</p>
          {x.listas.map((l) => (
            <>
              <h3>{l.titulo}</h3>
              <ol>{l.itens.map(([n, v, href]) => <li>{href ? <a href={href}>{n}</a> : <span>{n}</span>}<span class="num">{moedaCurta(v)}</span></li>)}</ol>
            </>
          ))}
          {x.link && <p><a class="seguir" href={x.link[0]}>{x.link[1]} →</a></p>}
          <button type="button" class="voltar" data-limpar>← Ver tudo de novo</button>
        </div>
      ))}
    </aside>
  </div>

  <section class="abas-sec">
    <div class="abas" role="tablist">
      <button type="button" role="tab" aria-selected="true" data-aba="anos">Ano a ano</button>
      <button type="button" role="tab" aria-selected="false" data-aba="estados">Por estado e cidade</button>
    </div>
    <div data-aba-corpo="anos">
      <p class="sub">As emendas quadruplicaram desde 2019, e o dinheiro trocou de tipo no caminho.</p>
      <SerieTipos />
    </div>
    <div data-aba-corpo="estados" hidden>
      <p class="sub">
        Todo estado tem pelo menos 8 deputados e 3 senadores, com cotas iguais: onde mora pouca gente, chega muito mais por pessoa (Amapá, R$ {nf0.format(ap.porHab)};
        São Paulo, R$ {nf0.format(sp.porHab)}). Em {nf0.format(c.peso.acima10)} cidades, as emendas passaram de 10% do que a prefeitura gastou.
      </p>
      <div class="duas">
        <MapaEstados />
        <div>
          <h3>O meio por morador, por tamanho de cidade</h3>
          <ol class="lista">{c.faixas.map((f) => <li><span>{f.rotulo}</span><span class="num">R$ {nf0.format(f.mediana)}</span></li>)}</ol>
          <h3 style="margin-top:16px">As que mais receberam por morador</h3>
          <ol class="lista">{c.maisPorHab.map((x) => <li><a href={`/emendas?ente=${x.ibge}&ano=${ANO}`}>{x.nome} ({x.uf})</a><span class="num">R$ {nf0.format(x.porHab)} · {nf0.format(x.pop)} moradores</span></li>)}</ol>
        </div>
      </div>
    </div>
  </section>

  <Explorar id="explore-3" />
</div>

<style>
  .abre { padding: 40px 0 16px; max-width: 900px; display: flex; flex-direction: column; gap: 14px; }
  .abre h1 { font-size: 60px; line-height: 1; letter-spacing: -0.025em; }
  .abre p { margin: 0; font-size: 19px; line-height: 1.55; color: var(--texto-2); }
  .perguntas { display: flex; flex-wrap: wrap; gap: 8px; padding: 6px 0 16px; }
  .perguntas button { font: inherit; font-size: 14px; padding: 7px 12px; border: 1px solid var(--tinta); background: var(--marca-texto-fundo); cursor: pointer; color: var(--tinta); }
  .perguntas button[aria-pressed="true"] { background: var(--tinta); color: var(--papel); }
  .mesa { display: grid; grid-template-columns: minmax(0, 8fr) minmax(300px, 4fr); gap: 28px; border-top: 2px solid var(--tinta); padding-top: 16px; align-items: start; }
  .siga :global(.so-estreito) { display: none; }
  .painel { position: sticky; top: 12px; background: #fff; border: 1px solid var(--tinta); padding: 18px; }
  .painel > div { display: flex; flex-direction: column; gap: 8px; }
  .painel > div[hidden] { display: none; }
  .painel .sobre { font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--texto-3); }
  .painel h2 { font-size: 26px; line-height: 1.15; display: flex; align-items: center; gap: 10px; }
  .painel .cor { width: 16px; height: 16px; flex: none; }
  .painel p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--texto-2); }
  .painel .valor strong { font-family: var(--serifa); font-size: 24px; color: var(--tinta); }
  .painel h3 { font-family: var(--sans); font-size: 14px; font-weight: 600; color: var(--texto-2); margin: 8px 0 0; }
  .painel ol, .lista, .leg { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--tinta); }
  .painel ol li, .lista li, .leg li { display: flex; justify-content: space-between; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--regra-leve); font-size: 14px; }
  .leg li { justify-content: flex-start; align-items: center; }
  .leg li .num { margin-left: auto; }
  .leg i { width: 12px; height: 12px; flex: none; }
  .painel .menor { font-size: 13.5px; color: var(--texto-3); }
  .painel .seguir { font-weight: 600; }
  .voltar { align-self: flex-start; font: inherit; font-size: 14px; padding: 6px 0; background: none; border: 0; color: var(--verde); cursor: pointer; text-decoration: underline; }
  .abas-sec { border-top: 2px solid var(--tinta); margin-top: 28px; padding: 20px 0 28px; display: flex; flex-direction: column; gap: 14px; }
  .abas { display: flex; gap: 0; border-bottom: 1px solid var(--tinta); }
  .abas button { font: inherit; font-family: var(--serifa); font-weight: 700; font-size: 20px; padding: 8px 16px; background: none; border: 1px solid transparent; border-bottom: 0; cursor: pointer; color: var(--texto-3); margin-bottom: -1px; }
  .abas button[aria-selected="true"] { color: var(--tinta); border-color: var(--tinta); background: var(--papel); }
  .sub { margin: 0; font-size: 16px; line-height: 1.55; color: var(--texto-2); max-width: 820px; }
  .duas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; align-items: start; }
  h3 { font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--texto-2); margin: 0 0 6px; }
  @media (max-width: 900px) {
    .abre { padding: 28px 0 12px; }
    .abre h1 { font-size: 38px; }
    .abre p { font-size: 16.5px; }
    .mesa { grid-template-columns: minmax(0, 1fr); }
    .siga :global(.so-largo) { display: none !important; }
    .siga :global(.so-estreito) { display: block !important; }
    .painel { position: static; }
    .abas button { font-size: 16px; padding: 8px 10px; }
    .duas { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>("[data-fluxo-raiz]");
  if (raiz) {
    const paineis = [...raiz.querySelectorAll<HTMLElement>("[data-painel]")];
    const perguntas = [...raiz.querySelectorAll<HTMLButtonElement>("[data-pergunta]")];
    const mandar = (id: string | null) => raiz.dispatchEvent(new CustomEvent("escolher", { detail: id }));
    raiz.addEventListener("escolher", (e) => {
      const id = (e as CustomEvent<string | null>).detail ?? "";
      paineis.forEach((p) => { p.hidden = p.dataset.painel !== id; });
      perguntas.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.pergunta === id)));
      // No celular o painel fica embaixo do desenho: leva a pessoa até ele.
      if (id && matchMedia("(max-width: 900px)").matches) raiz.querySelector(".painel")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    perguntas.forEach((b) => b.addEventListener("click", () => mandar(b.getAttribute("aria-pressed") === "true" ? null : b.dataset.pergunta!)));
    raiz.querySelectorAll("[data-limpar]").forEach((b) => b.addEventListener("click", () => mandar(null)));
    const abas = [...raiz.querySelectorAll<HTMLButtonElement>("[data-aba]")];
    abas.forEach((a) => a.addEventListener("click", () => {
      abas.forEach((x) => x.setAttribute("aria-selected", String(x === a)));
      raiz.querySelectorAll<HTMLElement>("[data-aba-corpo]").forEach((c) => { c.hidden = c.dataset.abaCorpo !== a.dataset.aba; });
    }));
  }
</script>
