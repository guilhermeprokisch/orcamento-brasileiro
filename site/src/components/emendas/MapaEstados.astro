---
/**
 * O mapa do Brasil por estado (lib/mapa-estados.ts, o mesmo de /quem-publica), cada estado pintado pelo que chegou de
 * emendas por morador e levando ao explorador já filtrado nele. Sem o arquivo do mapa, cai nos quadradinhos.
 * É um mapa simples de propósito: o mapa das emendas cidade por cidade fica para a seção de mapas.
 */
import { ANO, GRADE_UF, porEstado } from "../../lib/emendas-panorama";
import { MAPA_ESTADOS } from "../../lib/mapa-estados";
import { corDaRampa, LIMIAR_TEXTO_ESCURO } from "../../lib/cores";

interface Props { ano?: number; /** para onde leva o clique num estado (recebe a sigla e o código) */ link?: (uf: string, codigo: string) => string }
const { ano = ANO, link = (_uf: string, codigo: string) => `/emendas/buscar?ente=${codigo}&ano=${ano}` } = Astro.props;
const estados = porEstado(ano);
const por = new Map(estados.map((e) => [e.uf, e]));
const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
const [lo, hi] = [Math.log(Math.min(...estados.map((e) => e.porHab))), Math.log(Math.max(...estados.map((e) => e.porHab)))];
const t = (v: number) => 1 - (Math.log(v) - lo) / (hi - lo || 1);   // 0 = mais escuro = mais por morador
const escuro = (v: number) => t(v) < LIMIAR_TEXTO_ESCURO + 0.25;
// A legenda: cinco marcas na escala (que é logarítmica: cada passo multiplica o valor).
const marcas = [0, 0.25, 0.5, 0.75, 1].map((f) => Math.exp(lo + f * (hi - lo)));
const arred = (v: number) => (v >= 500 ? Math.round(v / 100) * 100 : Math.round(v / 10) * 10);
const mais = estados.slice(0, 3), menos = estados.slice(-3).reverse();
---

<figure class="mapa-estados">
  {MAPA_ESTADOS ? (
    <svg class="brasil" viewBox={`0 0 ${MAPA_ESTADOS.largura} ${MAPA_ESTADOS.altura}`} role="img" aria-label={`Emendas pagas em ${ano} por morador, em cada estado`}>
      {MAPA_ESTADOS.estados.map((s) => {
        const e = por.get(s.uf);
        return (
          <a href={e ? link(s.uf, e.codigo) : undefined} class="est">
            <title>{e ? `${e.nome}: R$ ${nf0.format(e.porHab)} por morador em ${ano}` : s.uf}</title>
            <path d={s.d} fill={e ? corDaRampa(t(e.porHab)) : "var(--areia-clara)"} />
          </a>
        );
      })}
      {MAPA_ESTADOS.estados.map((s) => {
        const e = por.get(s.uf);
        const claro = e && !s.linha && escuro(e.porHab);
        return (
          <g class:list={["rot", { claro, fora: !!s.linha }]} aria-hidden="true">
            {s.linha && <line x1={s.linha[0]} y1={s.linha[1]} x2={s.linha[2]} y2={s.linha[3]} />}
            <text x={s.rx} y={s.ry} text-anchor={s.linha ? "start" : "middle"} dominant-baseline="central" class:list={{ df: s.uf === "DF" }}>{s.uf}</text>
          </g>
        );
      })}
    </svg>
  ) : (
    <div class="grade">
      {estados.map((e) => {
        const [col, lin] = GRADE_UF[e.uf] ?? [0, 0];
        return (
          <a href={link(e.uf, e.codigo)} style={`grid-column:${col + 1};grid-row:${lin + 1};background:${corDaRampa(t(e.porHab))};color:${escuro(e.porHab) ? "#fff" : "var(--tinta)"}`}
            title={`${e.nome}: R$ ${nf0.format(e.porHab)} por morador em ${ano}`}><b>{e.uf}</b><span>{nf0.format(e.porHab)}</span></a>
        );
      })}
    </div>
  )}
  <figcaption>
    <div class="escala" aria-hidden="true">
      <div class="faixa" style={`background:linear-gradient(to right, ${[1, 0.75, 0.5, 0.25, 0].map((x) => corDaRampa(x)).join(", ")})`}></div>
      <div class="marcas">{marcas.map((m) => <span>{nf0.format(arred(m))}</span>)}</div>
    </div>
    <p>R$ por morador em {ano}. Mais: {mais.map((e, i) => <>{e.nome} (R$ {nf0.format(e.porHab)}){i < 2 ? ", " : ""}</>)}. Menos: {menos.map((e, i) => <>{e.nome} (R$ {nf0.format(e.porHab)}){i < 2 ? ", " : ""}</>)}.</p>
    <p class="dica">Clique num estado para explorar as emendas dele.</p>
  </figcaption>
</figure>

<style>
  .mapa-estados { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .brasil { width: 100%; max-width: 520px; height: auto; display: block; overflow: visible; }
  .est path { stroke: var(--papel); stroke-width: 1.2; transition: opacity .15s; }
  .est:hover path, .est:focus-visible path { stroke: var(--tinta); stroke-width: 2.5; }
  .rot text { font-family: var(--sans); font-size: 15px; font-weight: 600; fill: var(--tinta); pointer-events: none; }
  .rot.claro text { fill: #fff; }
  .rot .df { font-size: 11px; }
  .rot line { stroke: var(--texto-3); stroke-width: 1; }
  .rot.fora text { font-size: 13px; }
  .escala { max-width: 320px; }
  .faixa { height: 10px; }
  .marcas { display: flex; justify-content: space-between; font-size: 12px; color: var(--texto-3); padding-top: 2px; }
  figcaption p { margin: 4px 0 0; font-size: 13.5px; line-height: 1.5; color: var(--texto-3); max-width: 520px; }
  figcaption .dica { margin: 0; }
  .grade { display: grid; grid-template-columns: repeat(6, minmax(0, 64px)); grid-auto-rows: 56px; gap: 4px; }
  .grade a { display: flex; flex-direction: column; justify-content: center; align-items: center; text-decoration: none; line-height: 1.1; }
  .grade b { font-size: 15px; }
  .grade span { font-size: 12px; }
</style>
