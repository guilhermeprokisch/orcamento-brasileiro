---
/**
 * Saneamento: o gasto por habitante ao lado de quantos moradores têm água da rede e esgoto
 * ligado à rede (Censo 2022), com a mediana dos comparáveis e o Brasil.
 */
import { moedaCurta } from "../../lib/formato";
import { docCidades, docEstados, medianaDa, porPessoa, type Cidade } from "../../lib/cidades";
import { saneamentoDe } from "../../lib/indicadores";

interface Props {
  ente: Cidade;
  esfera: "mun" | "uf";
  /** "a prefeitura de Fortaleza", "o governo do Ceará" */
  quem: string;
  /** "das cidades de 100 a 500 mil habitantes", "dos estados"; null sem comparação */
  grupo: string | null;
  /** "em Fortaleza", "no Ceará" */
  onde: string;
}
const { ente, esfera, quem, grupo, onde } = Astro.props;
const s = saneamentoDe(ente, esfera);
const gasto = ente.f?.["17"]?.[0] ?? 0;
const porHab = gasto > 0 ? gasto / ente.pop : null;
const medGasto = grupo ? medianaDa(ente, "17", esfera === "uf" ? docEstados : docCidades) : null;
const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
const p = (v: number) => `${nf0.format(v * 100)}%`;
const comparaveis = esfera === "uf" ? "Mediana dos estados" : "Cidades parecidas";
---

{s && (
  <section class="saneamento">
    <div class="texto">
      <span class="sobretitulo verde">Gasto e situação</span>
      <h2>Saneamento: quanto se gasta e quem tem água e esgoto</h2>
      <p>
        No Censo de {s.ano}, <strong>{p(s.agua)} dos moradores</strong> {onde} recebiam água da rede geral e{" "}
        <strong>{p(s.esgoto)}</strong> tinham o esgoto ligado à rede.
        {s.medianaAgua !== null && s.medianaEsgoto !== null && grupo && <> A mediana {grupo} é {p(s.medianaAgua)} com água e {p(s.medianaEsgoto)} com esgoto.</>}
        {" "}No Brasil, {p(s.brasilAgua)} e {p(s.brasilEsgoto)}.
      </p>
      <p>
        {porHab !== null
          ? <>Em {ente.ano}, {quem} gastou <strong>{porPessoa(porHab)} por habitante</strong> em saneamento ({moedaCurta(gasto)}).{medGasto !== null && grupo && <> A mediana {grupo} é {porPessoa(medGasto)}.</>}</>
          : <>Em {ente.ano}, {quem} não registrou gasto em saneamento.</>}
      </p>
      <p class="menor">
        Na maior parte do país, água e esgoto são serviço de uma empresa estadual, de uma autarquia ou de uma concessionária
        privada, paga pela conta de água. Por isso o gasto {esfera === "uf" ? "do governo" : "da prefeitura"} em saneamento
        costuma ser pequeno e não mostra tudo o que se investe {onde}. Esgoto ligado à rede também não quer dizer esgoto
        tratado: o Censo não mede o tratamento.
      </p>
    </div>
    <div class="numeros-san">
      <p class="unidade">Moradores com o serviço, Censo {s.ano}</p>
      <span></span><span class="cab">{esfera === "uf" ? "Este estado" : "Esta cidade"}</span><span class="cab">{grupo ? comparaveis : ""}</span><span class="cab">Brasil</span>
      <span class="rot">Água da rede</span><strong class="num">{p(s.agua)}</strong><strong class="num muted">{grupo && s.medianaAgua !== null ? p(s.medianaAgua) : ""}</strong><strong class="num muted">{p(s.brasilAgua)}</strong>
      <span class="rot">Esgoto na rede</span><strong class="num">{p(s.esgoto)}</strong><strong class="num muted">{grupo && s.medianaEsgoto !== null ? p(s.medianaEsgoto) : ""}</strong><strong class="num muted">{p(s.brasilEsgoto)}</strong>
    </div>
    <p class="fonte">Fonte: {s.fonte}. Gasto: função Saneamento na prestação de contas ao Tesouro.</p>
  </section>
)}

<style>
  .saneamento { border-top: 2px solid var(--tinta); padding: 32px 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 20px 32px; }
  .texto { grid-column: span 6; display: flex; flex-direction: column; gap: 12px; }
  .texto h2 { font-size: 30px; line-height: 1.1; }
  .texto p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--texto-2); }
  .texto p strong { color: var(--tinta); }
  .texto .menor { font-size: 14px; color: var(--texto-3); }
  .numeros-san { grid-column: span 6; align-self: center; display: grid; grid-template-columns: minmax(0, 1.3fr) repeat(3, minmax(0, 1fr)); gap: 10px 12px; align-items: baseline; border-top: 1px solid var(--tinta); border-bottom: 1px solid var(--regra); padding-bottom: 14px; }
  .unidade { grid-column: 1 / -1; margin: 0; padding: 12px 0 0; font-size: 14px; font-weight: 600; color: var(--texto-2); }
  .cab { font-size: 13px; line-height: 1.3; color: var(--texto-3); }
  .rot { font-size: 14px; color: var(--texto-2); }
  .numeros-san strong { font-family: var(--serifa); font-size: 28px; font-weight: 700; }
  .fonte { grid-column: 1 / -1; margin: 0; font-size: 13px; color: var(--texto-3); }

  @media (max-width: 900px) {
    .saneamento { display: flex; flex-direction: column; gap: 20px; padding: 28px 0; }
    .texto h2 { font-size: 26px; }
    .numeros-san strong { font-size: 22px; }
  }
</style>
