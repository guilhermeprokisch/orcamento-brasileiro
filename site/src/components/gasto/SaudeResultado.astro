---
/**
 * Saúde: o gasto por habitante ao lado da mortalidade infantil, com a mediana dos comparáveis
 * (cidades do mesmo porte ou os estados). Mostra os dois números juntos, sem concluir que um
 * causa o outro.
 */
import { moedaCurta, pct } from "../../lib/formato";
import { docCidades, docEstados, medianaDa, porPessoa, type Cidade } from "../../lib/cidades";
import { mortalidadeDe, NASCIDOS_MINIMO } from "../../lib/indicadores";

interface Props {
  ente: Cidade;
  esfera: "mun" | "uf";
  /** "a prefeitura de Fortaleza", "o governo do Ceará" */
  quem: string;
  /** "das cidades de 100 a 500 mil habitantes", "dos estados"; null sem comparação */
  grupo: string | null;
  /** "em Fortaleza", "no Ceará" */
  onde: string;
}
const { ente, esfera, quem, grupo, onde } = Astro.props;
const m = mortalidadeDe(ente, esfera);
const gasto = ente.f?.["10"]?.[0] ?? 0;
const porHab = gasto > 0 ? gasto / ente.pop : null;
const medGasto = medianaDa(ente, "10", esfera === "uf" ? docEstados : docCidades);
const total = ente.total?.[0] ?? 0;
const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
const nf1 = new Intl.NumberFormat("pt-BR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const anos = m ? (m.anos.length > 1 ? `${m.anos.slice(0, -1).join(", ")} e ${m.anos.at(-1)}` : `${m.anos[0]}`) : "";
const frente = m && m.taxa !== null && m.mediana !== null ? m.taxa / m.mediana - 1 : null;
---

{m && (
  <section class="saude">
    <div class="texto">
      <span class="sobretitulo verde">Gasto e resultado</span>
      <h2>Saúde: quanto se gasta e quantos bebês sobrevivem</h2>
      {porHab !== null && (
        <p>
          Em {ente.ano}, {quem} gastou <strong>{porPessoa(porHab)} por habitante</strong> em saúde
          ({moedaCurta(gasto)}{total > 0 && <>, {pct(gasto / total)} de tudo o que gastou</>}).
          {medGasto !== null && grupo && <> A mediana {grupo} é {porPessoa(medGasto)}.</>}
        </p>
      )}
      {m.taxa !== null ? (
        <p>
          Em {anos}, morreram <strong>{nf0.format(m.obitos)} bebês</strong> antes de completar 1 ano, entre{" "}
          {nf0.format(m.nascidos)} nascidos de mães que moram {onde}:{" "}
          <strong>{nf1.format(m.taxa)} a cada mil</strong>.
          {m.mediana !== null && grupo && <> A mediana {grupo} é {nf1.format(m.mediana)}</>}
          {m.brasil !== null && <>{m.mediana !== null && grupo ? "; " : " "}no Brasil, {nf1.format(m.brasil)}.</>}
        </p>
      ) : (
        <p>
          Em {anos}, nasceram {nf0.format(m.nascidos)} bebês de mães que moram {onde} e {m.obitos === 0 ? "nenhum morreu" : m.obitos === 1 ? "1 morreu" : `${nf0.format(m.obitos)} morreram`} antes
          de completar 1 ano. Com menos de {NASCIDOS_MINIMO} nascimentos, a taxa muda muito de um ano para outro e não é comparada.
        </p>
      )}
      <p class="menor">
        Mortalidade infantil é a parte dos bebês que morrem antes de 1 ano. Depende do pré-natal, do parto e do atendimento
        no primeiro ano, mas também de saneamento e renda. Por isso os dois números aparecem lado a lado para você comparar;
        um não explica o outro sozinho. {esfera === "mun" ? "A saúde da cidade também é paga pelo governo do estado e pela União (SUS)." : "A saúde no estado também é paga pelas prefeituras e pela União (SUS)."}
        {" "}Os dados de {m.anos.at(-1)} ainda são preliminares.
      </p>
    </div>
    {m.taxa !== null && (
      <div class="numeros-saude">
        <p class="unidade">Mortes antes de 1 ano, a cada mil nascidos</p>
        <div><span>{esfera === "uf" ? "Este estado" : "Esta cidade"}</span><strong class="num">{nf1.format(m.taxa)}</strong></div>
        <div><span>{esfera === "uf" ? "Mediana dos estados" : "Cidades parecidas"}</span><strong class="num muted">{m.mediana === null ? "—" : nf1.format(m.mediana)}</strong></div>
        <div><span>Brasil</span><strong class="num muted">{m.brasil === null ? "—" : nf1.format(m.brasil)}</strong></div>
        {frente !== null && Math.abs(frente) >= 0.1 && <p class="frente">{nf0.format(Math.abs(frente) * 100)}% {frente > 0 ? "acima" : "abaixo"} {esfera === "uf" ? "da mediana dos estados" : "das cidades parecidas"}</p>}
      </div>
    )}
    <p class="fonte">Fonte: {m.fonte}, {anos}, somados.</p>
  </section>
)}

<style>
  .saude { border-top: 2px solid var(--tinta); padding: 32px 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 20px 32px; }
  .texto { grid-column: span 6; display: flex; flex-direction: column; gap: 12px; }
  .texto h2 { font-size: 30px; line-height: 1.1; }
  .texto p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--texto-2); }
  .texto p strong { color: var(--tinta); }
  .texto .menor { font-size: 14px; color: var(--texto-3); }
  .numeros-saude { grid-column: span 6; align-self: center; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--tinta); border-bottom: 1px solid var(--regra); }
  .numeros-saude div { padding: 12px 16px 16px 0; display: flex; flex-direction: column; justify-content: space-between; gap: 4px; }
  .numeros-saude span { font-size: 13px; line-height: 1.3; color: var(--texto-3); }
  .numeros-saude strong { font-family: var(--serifa); font-size: 32px; font-weight: 700; }
  .unidade { grid-column: 1 / -1; margin: 0; padding: 12px 0 0; font-size: 14px; font-weight: 600; color: var(--texto-2); }
  .frente { grid-column: 1 / -1; margin: 0; padding: 0 0 12px; font-size: 14px; color: var(--texto-2); }
  .fonte { grid-column: 1 / -1; margin: 0; font-size: 13px; color: var(--texto-3); }

  @media (max-width: 900px) {
    .saude { display: flex; flex-direction: column; gap: 20px; padding: 28px 0; }
    .texto h2 { font-size: 26px; }
    .numeros-saude strong { font-size: 26px; }
  }
</style>
