---
/**
 * Na página de um órgão federal (/orgaos/[cod]): os servidores civis que passaram do teto, pelos órgãos de
 * exercício do SIAPE cujo nome casa com o órgão ou com uma das suas unidades no orçamento
 * (lib/supersalarios.ts). Some quando nenhum casa ou quando nenhum tem pelo menos 5 servidores acima do teto.
 */
import { moedaExtenso } from "../../lib/formato";
import { EXTRA_EVENTUAL, MOSTRA_NOME, NOMES_FEDERAL, docFederal, federalDoOrgao, legislativoDoOrgao, mesExtenso, periodoFederal, tetoAtual } from "../../lib/supersalarios";

interface Props { cod: string }
const { cod } = Astro.props;
const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
const nf1 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 1 });
/** "19%", e "0,5%" abaixo de 1%. */
const pct0 = (v: number) => `${(v < 0.01 ? nf1 : nf0).format(v * 100)}%`;
// Pelo nome, só os órgãos com pelo menos 5 servidores acima do teto num mês típico; os outros entram na soma do fim.
const todos = federalDoOrgao(cod).filter((l) => l.excesso !== null);
const ls = todos.filter(MOSTRA_NOME).slice(0, 5);
const resto = todos.filter((l) => !ls.includes(l));
// Câmara, Senado e TCU: a folha do próprio órgão (supersalarios-legislativo).
const leg = legislativoDoOrgao(cod);
const legOk = leg && leg.resumo.acima !== null && leg.resumo.acima >= 5;
const legGrupos = leg ? Object.values(leg.grupos_funcionais).filter(MOSTRA_NOME) : [];
/** A maior parte do que o órgão paga por cima do salário (a todos os servidores, não só aos que passam do teto). */
const maiorParte = (g: Record<string, number>) => {
  const extra = Object.entries(g).filter(([k]) => k !== "base").sort((a, b) => b[1] - a[1]);
  return extra[0] && extra[0][1] > 0 ? NOMES_FEDERAL[extra[0][0]].toLowerCase() : null;
};
---

{docFederal && ls.length > 0 && (
  <section class="teto">
    <h2>Acima do teto</h2>
    <p class="abre">
      Servidores civis na ativa que receberam mais que o <a href="/supersalarios#federal">teto constitucional</a>, R$ {nf0.format(tetoAtual())} por
      mês, {periodoFederal()}, somando salário, pagamentos eventuais, honorários, jetons e auxílios (sem 13º e férias).
    </p>
    <ul>
      {ls.map((l) => (
        <li>
          <strong>{l.nome}</strong>:{" "}
          {nf0.format(l.acima!)} dos {nf0.format(l.servidores)} servidores ({pct0(l.parte!)}) passaram do teto num mês típico;
          o que passou somou {moedaExtenso(l.excesso!)} em {l.meses} meses
          {(l.eventuaisParte ?? 0) >= EXTRA_EVENTUAL && <>, mais da metade disso em pagamentos eventuais</>}
          {(l.eventuaisParte ?? 0) < EXTRA_EVENTUAL && maiorParte(l.grupos) && <>. Do que o órgão paga além do salário, a maior parte são {maiorParte(l.grupos)}</>}.
        </li>
      ))}
      {resto.length > 0 && (
        <li>Outros {resto.length} órgãos ligados a este, com alguém acima do teto, somam {moedaExtenso(resto.reduce((t, l) => t + (l.excesso ?? 0), 0))} (só aparece pelo nome quem tem pelo menos 5 servidores acima do teto num mês típico).</li>
      )}
    </ul>
    {ls.some((l) => (l.eventuaisParte ?? 0) >= EXTRA_EVENTUAL) && (
      <p class="menor">
        Pagamentos eventuais: a coluna "outras remunerações eventuais" da folha, que o Portal não detalha. Pode ser pagamento atrasado, decisão
        judicial ou outra parcela fora do salário; por isso o valor pode ser alto para pouca gente.
      </p>
    )}
    <p class="menor">Fonte: Portal da Transparência (CGU). Só somas: nenhum servidor aparece. <a href="/supersalarios#federal">Todo o Executivo federal →</a></p>
  </section>
)}

{legOk && leg && (
  <section class="teto">
    <h2>Acima do teto</h2>
    <p class="abre">
      Servidores e autoridades na ativa que receberam mais que o <a href="/supersalarios#legislativo">teto constitucional</a>, R$ {nf0.format(tetoAtual())} por
      mês, de {mesExtenso(leg.de)} a {mesExtenso(leg.ate)}, somando salário, pagamentos eventuais, atrasados, auxílios e indenizações (sem 13º, férias
      e abono de permanência): <strong>{nf0.format(leg.resumo.acima!)} dos {nf0.format(leg.resumo.vinculos)}</strong> ({pct0(leg.resumo.parte!)}) passaram do teto
      num mês típico, e o que passou somou <strong>{moedaExtenso(leg.resumo.excesso ?? 0)}</strong> em {leg.meses} meses
      {leg.partes.auxilios >= EXTRA_EVENTUAL && <>, mais da metade disso em auxílios e indenizações (quase todos chegam ao teto com o salário e passam dele pelo auxílio-alimentação e pelo ressarcimento do plano de saúde)</>}
      {leg.partes.eventuais >= EXTRA_EVENTUAL && <>, mais da metade disso em pagamentos eventuais</>}
      {leg.partes.atrasados >= EXTRA_EVENTUAL && <>, mais da metade disso em pagamentos atrasados</>}.
    </p>
    {legGrupos.length > 0 && (
      <ul>
        {legGrupos.map((g) => (
          <li><strong>{g.nome}</strong>: {nf0.format(g.acima!)} de {nf0.format(g.vinculos)} ({pct0(g.parte!)}) acima do teto num mês típico; {moedaExtenso(g.excesso ?? 0)} em {g.meses} meses.</li>
        ))}
      </ul>
    )}
    <p class="menor">Fonte: <a href={leg.url}>{leg.fonte}</a>. Só somas: ninguém aparece; um grupo só aparece com pelo menos 5 pessoas acima do teto num mês típico. <a href="/supersalarios#legislativo">Todo o Legislativo federal →</a></p>
  </section>
)}

<style>
  .teto { border-top: 2px solid var(--tinta); padding: 32px 0; display: flex; flex-direction: column; gap: 14px; max-width: 880px; }
  .teto h2 { font-size: 34px; }
  .teto p, .teto li { margin: 0; font-size: 16px; line-height: 1.6; color: var(--texto-2); }
  .teto ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
  .teto strong { color: var(--tinta); }
  .teto .menor { font-size: 14px; color: var(--texto-3); }
  @media (max-width: 900px) { .teto h2 { font-size: 28px; } }
</style>
