---
/**
 * Na página de um órgão federal (/orgaos/[cod]): os servidores civis que passaram do teto, pelos órgãos de
 * exercício do SIAPE cujo nome casa com o órgão ou com uma das suas unidades no orçamento
 * (lib/supersalarios.ts). Some quando nenhum casa ou quando nenhum tem pelo menos 5 servidores acima do teto.
 */
import { moedaExtenso } from "../../lib/formato";
import { NOMES_FEDERAL, docFederal, federalDoOrgao, periodoFederal, tetoAtual } from "../../lib/supersalarios";

interface Props { cod: string }
const { cod } = Astro.props;
const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
const pct0 = (v: number) => `${nf0.format(v * 100)}%`;
const todos = federalDoOrgao(cod).filter((l) => l.excesso !== null);
const ls = todos.slice(0, 5);
const resto = todos.slice(5);
/** A maior parte do que o órgão paga por cima do salário (a todos os servidores, não só aos que passam do teto). */
const maiorParte = (g: Record<string, number>) => {
  const extra = Object.entries(g).filter(([k]) => k !== "base").sort((a, b) => b[1] - a[1]);
  return extra[0] && extra[0][1] > 0 ? NOMES_FEDERAL[extra[0][0]].toLowerCase() : null;
};
---

{docFederal && ls.length > 0 && (
  <section class="teto">
    <h2>Acima do teto</h2>
    <p class="abre">
      Servidores civis na ativa que receberam mais que o <a href="/supersalarios#federal">teto constitucional</a>, R$ {nf0.format(tetoAtual())} por
      mês, {periodoFederal()}, somando salário, pagamentos eventuais, honorários, jetons e auxílios (sem 13º e férias).
    </p>
    <ul>
      {ls.map((l) => (
        <li>
          <strong>{l.nome}</strong>: {nf0.format(l.acima!)} dos {nf0.format(l.servidores)} servidores ({pct0(l.parte!)}) passaram do teto num mês
          típico; o que passou somou {moedaExtenso(l.excesso!)} em {l.meses} meses
          {maiorParte(l.grupos) && <>. Do que o órgão paga além do salário, a maior parte são {maiorParte(l.grupos)}</>}.
        </li>
      ))}
      {resto.length > 0 && (
        <li>Outros {resto.length} órgãos ligados a este, com pelo menos 5 servidores acima do teto, somam {moedaExtenso(resto.reduce((t, l) => t + (l.excesso ?? 0), 0))}.</li>
      )}
    </ul>
    <p class="menor">Fonte: Portal da Transparência (CGU). Só somas: nenhum servidor aparece. <a href="/supersalarios#federal">Todo o Executivo federal →</a></p>
  </section>
)}

<style>
  .teto { border-top: 2px solid var(--tinta); padding: 32px 0; display: flex; flex-direction: column; gap: 14px; max-width: 880px; }
  .teto h2 { font-size: 34px; }
  .teto p, .teto li { margin: 0; font-size: 16px; line-height: 1.6; color: var(--texto-2); }
  .teto ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
  .teto strong { color: var(--tinta); }
  .teto .menor { font-size: 14px; color: var(--texto-3); }
  @media (max-width: 900px) { .teto h2 { font-size: 28px; } }
</style>
