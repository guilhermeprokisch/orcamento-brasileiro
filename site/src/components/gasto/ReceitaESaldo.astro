---
/**
 * Seções comuns das páginas de cidade e de estado além do gasto por área: com o
 * quê se gasta, de onde veio a receita, se sobrou ou faltou no ano, o que havia em
 * caixa e em dívidas e o que o INSS paga direto às pessoas. Os dados são os da
 * página /mapa; cada seção só aparece se o dado existe.
 */
import { moedaCompleta, moedaCurta, moedaExtenso, pct } from "../../lib/formato";
import { corDaRampa } from "../../lib/cores";
import { porPessoa, type Cidade } from "../../lib/cidades";
import { balancoDe, caminhoNoMapa, contasDe, inssDe, naturezaDe, parcialDe, type Esfera } from "../../lib/contas";

interface Props {
  ente: Cidade;
  esfera: Esfera;
  /** "a prefeitura de Fortaleza", "o governo do Ceará" */
  quem: string;
  /** "em Fortaleza", "no estado" */
  onde: string;
}
const { ente, esfera, quem, onde } = Astro.props;
const ehDF = ente.ibge === 53;
const municipal = esfera === "mun" && !ehDF;
const deQuem = ehDF ? "do governo do Distrito Federal" : municipal ? "da prefeitura" : "do governo estadual";

const contas = await contasDe(ente, esfera);
const inss = await inssDe(ente, esfera);
const natureza = await naturezaDe(ente, esfera);
const balanco = await balancoDe(ente, esfera);
const parcial = await parcialDe(ente, esfera);

// O ano em andamento: quanto do previsto para o ano inteiro já aconteceu.
const NUMEROS = ["", "", "dois", "", "quatro", "", "seis", "", "oito", "", "dez", "", "doze"];
const andamento = parcial
  ? [
      { rotulo: "Receita arrecadada", de: "do previsto para o ano", v: parcial.receita, total: parcial.receitaPrevista },
      { rotulo: "Gasto comprometido", de: "do orçamento do ano", v: parcial.empenhado, total: parcial.dotacao },
      { rotulo: "Gasto já pago", de: "do orçamento do ano", v: parcial.pago, total: parcial.dotacao },
    ]
  : [];
const variacao = (agora: number, antes: number) => {
  const d = agora / antes - 1;
  return `${pct(Math.abs(d))} ${d >= 0 ? "maior" : "menor"}`;
};

// Com o quê gasta. Nos estados, o custeio inclui os repasses aos municípios.
const tipos = natureza
  ? [
      { rotulo: "Salários e encargos dos servidores", v: natureza.pessoal },
      { rotulo: municipal ? "Serviços, materiais e outros custeios" : "Serviços, materiais, repasses a municípios e outros custeios", v: natureza.custeio },
      { rotulo: "Obras e equipamentos", v: natureza.investimentos },
      { rotulo: "Pagamento de dívida", v: natureza.amortizacao },
      { rotulo: "Juros da dívida", v: natureza.juros },
      { rotulo: "Compra de imóveis e participações", v: natureza.inversoes },
    ].filter((t) => t.v > 0).sort((a, b) => b.v - a.v)
  : [];
const emCemDe = (v: number) => (natureza ? Math.round((v / natureza.total) * 100) : 0);

// O que tinha e o que devia em 31/12.
const sinal = (v: number) => (v < 0 ? `−${moedaCurta(-v)}` : moedaCurta(v));
const semPagar = natureza && natureza.restos > 0 ? natureza.restos : ente.total ? Math.max(0, ente.total[0] - ente.total[1]) : 0;
const linhasBalanco = balanco
  ? [
      { rotulo: "Dinheiro em caixa", v: moedaCurta(balanco.caixa), mostra: true },
      { rotulo: `${(balanco.sobra ?? 0) >= 0 ? "Sobra" : "Falta"} acumulada`, dica: "dinheiro e aplicações menos contas de curto prazo", v: sinal(balanco.sobra ?? 0), mostra: balanco.sobra !== null },
      { rotulo: "A mesma conta um ano antes", v: sinal(balanco.sobraAntes ?? 0), mostra: balanco.sobraAntes !== null },
      { rotulo: "Gasto do ano que ficou sem pagar", v: moedaCurta(semPagar), mostra: semPagar > 0 },
      { rotulo: "Dívida com empréstimos e financiamentos", v: moedaCurta(balanco.emprestimos), mostra: balanco.emprestimos > 0 },
      { rotulo: "Compromissos de longo prazo", dica: "em geral, aposentadorias futuras dos servidores", v: moedaCurta(balanco.provisoes), mostra: balanco.provisoes > 0 },
    ].filter((l) => l.mostra)
  : [];
const lista = new Intl.ListFormat("pt-BR", { style: "long", type: "conjunction" });

// De onde veio a receita. Partes abaixo de 0,05% ficam de fora (resíduos de classificação).
const origens = contas
  ? [
      { rotulo: "Arrecadação própria", dica: municipal ? "ISS, IPTU, taxas e outras receitas da prefeitura" : ehDF ? "ICMS, IPVA, ISS, IPTU e outras receitas do DF" : "ICMS, IPVA e outras receitas do estado", v: contas.propria },
      { rotulo: "Repasses da União", dica: municipal ? "FPM, SUS e outros" : "FPE, SUS e outros", v: contas.uniao },
      { rotulo: municipal ? "Repasses do governo estadual" : "Repasses de outros estados", dica: municipal ? "parte do ICMS e do IPVA, entre outros" : "", v: contas.estado },
      { rotulo: "FUNDEB", dica: "fundo da educação básica, com dinheiro de estados, municípios e União", v: contas.fundeb },
      { rotulo: "Empréstimos", dica: "dinheiro que terá de ser devolvido", v: contas.credito },
    ].filter((o) => o.v > contas.receita * 0.0005).sort((a, b) => b.v - a.v)
  : [];
const maiorOrigem = Math.max(1, ...origens.map((o) => o.v));
const emCem = contas ? Math.round((contas.propria / contas.receita) * 100) : 0;

// O que moradores e empresas pagam direto à prefeitura.
const tributos = contas && municipal
  ? [
      ["ISS (imposto sobre serviços)", contas.iss], ["IPTU", contas.iptu], ["ITBI (compra de imóveis)", contas.itbi],
      ["taxas", contas.taxas], ["contribuição de iluminação pública", contas.cosip],
    ].filter((t): t is [string, number] => (t[1] as number) > 0).sort((a, b) => b[1] - a[1])
  : [];

const sobrou = contas ? contas.saldo >= 0 : true;
const parteDaReceita = contas ? Math.abs(contas.saldo) / contas.receita : 0;
const maiorLado = contas ? Math.max(contas.receita, contas.despesa) : 1;

const partesInss = inss
  ? [
      ["Aposentadorias", inss.aposentadorias], ["Pensões por morte", inss.pensoes],
      ["Auxílios e outros benefícios", inss.total - inss.aposentadorias - inss.pensoes],
    ].filter((p): p is [string, number] => (p[1] as number) > 0)
  : [];
const frenteAoGasto = inss && ente.total ? inss.total / ente.total[0] : null;
---

{natureza && (
  <section class="bloco">
    <div class="texto">
      <h2>Com o quê gasta</h2>
      <p>
        De cada R$ 100 que {quem} gastou em {natureza.ano}, <strong>R$ {emCemDe(natureza.pessoal)}</strong> foram para
        salários e encargos dos servidores e <strong>R$ {emCemDe(natureza.investimentos)}</strong> para obras e equipamentos.
      </p>
      <p class="menor">
        A soma, {moedaCurta(natureza.total)}, é maior que o total por área porque aqui entram também os pagamentos entre
        órgãos {municipal ? "da própria prefeitura" : "do próprio governo"}, como a contribuição ao fundo de previdência dos servidores.
      </p>
    </div>
    <ul class="barras">
      {tipos.map((t, k) => (
        <li>
          <span class="lb-linha">
            <span>{t.rotulo}</span>
            <strong class="num" title={moedaCompleta(t.v)}>{moedaCurta(t.v)} · {pct(t.v / natureza.total)}</strong>
          </span>
          <span class="lb-barra" style={`width:${(t.v / tipos[0].v) * 100}%;background:${corDaRampa(Math.min(1, k / 4))}`}></span>
        </li>
      ))}
    </ul>
  </section>
)}

{contas && (
  <section class="bloco">
    <div class="texto">
      <h2>De onde vem o dinheiro</h2>
      <p>
        Em {contas.ano}, {quem} recebeu <strong>{moedaExtenso(contas.receita)}</strong>,
        ou {porPessoa(contas.receita / ente.pop)} por habitante. De cada R$ 100,{" "}
        <strong>R$ {emCem}</strong> {emCem === 1 ? "foi arrecadado" : "foram arrecadados"} por {municipal ? "ela mesma" : "ele mesmo"};
        o resto veio de fora.
      </p>
      {tributos.length > 0 && (
        <p class="menor">
          Direto à prefeitura, moradores e empresas pagaram {lista.format(tributos.map(([nome, v]) => `${moedaCurta(v)} de ${nome}`))}.
        </p>
      )}
    </div>
    <ul class="barras">
      {origens.map((o, k) => (
        <li>
          <span class="lb-linha">
            <span>{o.rotulo}{o.dica && <small class="so-largo"> · {o.dica}</small>}</span>
            <strong class="num" title={moedaCompleta(o.v)}>{moedaCurta(o.v)} · {pct(o.v / contas.receita)}</strong>
          </span>
          <span class="lb-barra" style={`width:${(o.v / maiorOrigem) * 100}%;background:${corDaRampa(Math.min(1, k / 4))}`}></span>
        </li>
      ))}
    </ul>
  </section>
)}

{contas && (
  <section class="bloco">
    <div class="texto">
      <h2>{sobrou ? "Sobrou" : "Faltou"} dinheiro no ano</h2>
      <p>
        Entraram {moedaExtenso(contas.receita)} e os gastos comprometidos somaram {moedaExtenso(contas.despesa)}:{" "}
        uma {sobrou ? "sobra" : "falta"} de <strong class="marca">{moedaExtenso(Math.abs(contas.saldo))}</strong>,{" "}
        {pct(parteDaReceita)} da receita.
      </p>
      <p class="menor">
        {sobrou
          ? "É a conta simples do ano, não o resultado fiscal oficial: não considera dívidas antigas nem o dinheiro que já estava em caixa."
          : "Quem gasta mais do que recebe cobre a diferença com dinheiro guardado de anos anteriores ou deixando contas para o ano seguinte."}
        {parteDaReceita > 0.3 && " Uma diferença tão grande costuma indicar erro na declaração enviada ao Tesouro."}
      </p>
    </div>
    <ul class="barras">
      <li>
        <span class="lb-linha"><span>Receita</span><strong class="num" title={moedaCompleta(contas.receita)}>{moedaCurta(contas.receita)}</strong></span>
        <span class="lb-barra" style={`width:${(contas.receita / maiorLado) * 100}%;background:${corDaRampa(0)}`}></span>
      </li>
      <li>
        <span class="lb-linha"><span>Despesa <small class="so-largo">· gasto comprometido (empenhado)</small></span><strong class="num" title={moedaCompleta(contas.despesa)}>{moedaCurta(contas.despesa)}</strong></span>
        <span class="lb-barra" style={`width:${(contas.despesa / maiorLado) * 100}%;background:${corDaRampa(0.6)}`}></span>
      </li>
      <li class="saldo">
        <span class="lb-linha"><span>{sobrou ? "Sobrou" : "Faltou"}</span><strong class="num" title={moedaCompleta(contas.saldo)}>{moedaCurta(Math.abs(contas.saldo))}</strong></span>
      </li>
    </ul>
  </section>
)}

{balanco && (
  <section class="bloco">
    <div class="texto">
      <h2>O que tinha e o que devia</h2>
      <p>
        Em 31 de dezembro de {balanco.ano}, {quem} tinha <strong>{moedaExtenso(balanco.caixa)}</strong> em caixa
        {balanco.emprestimos > 0
          ? <> e devia <strong>{moedaExtenso(balanco.emprestimos)}</strong> em empréstimos e financiamentos.</>
          : <> e não declarou dívida com empréstimos.</>}
      </p>
      <p class="menor">
        Números do balanço patrimonial, o retrato do fim do ano. A sobra acumulada é o que explica como
        um governo consegue gastar mais do que recebe num ano: ele usa o que guardou nos anteriores.
      </p>
    </div>
    <ul class="linhas">
      {linhasBalanco.map((l) => (
        <li>
          <span>{l.rotulo}{l.dica && <small class="so-largo"> · {l.dica}</small>}</span>
          <strong class="num">{l.v}</strong>
        </li>
      ))}
    </ul>
  </section>
)}

{parcial && (
  <section class="bloco">
    <div class="texto">
      <h2>E em {parcial.ano}, até {parcial.ate}</h2>
      <p>
        Nos {NUMEROS[parcial.meses]} primeiros meses de {parcial.ano}, {quem} arrecadou{" "}
        <strong>{moedaExtenso(parcial.receita)}</strong>, {pct(parcial.receita / parcial.receitaPrevista)} do previsto para o
        ano, e comprometeu <strong>{moedaExtenso(parcial.empenhado)}</strong> em gastos, {pct(parcial.empenhado / parcial.dotacao)} do orçamento.
        {parcial.receitaAntes > 0 && parcial.empenhadoAntes > 0 && (
          <> Frente ao mesmo período de {parcial.ano - 1}, a receita foi {variacao(parcial.receita, parcial.receitaAntes)} e
          o gasto comprometido, {variacao(parcial.empenhado, parcial.empenhadoAntes)}, sem descontar a inflação.</>
        )}
      </p>
      <p class="menor">
        Números parciais do relatório bimestral (RREO), que ainda podem ser corrigidos. O traço marca quanto do ano já passou.
        O gasto comprometido costuma andar à frente porque contratos do ano inteiro são comprometidos de uma vez.
      </p>
    </div>
    <ul class="barras">
      {andamento.map((a, k) => (
        <li>
          <span class="lb-linha">
            <span>{a.rotulo}<small class="so-largo"> · {pct(a.v / a.total)} {a.de}</small></span>
            <strong class="num" title={moedaCompleta(a.v)}>{moedaCurta(a.v)} de {moedaCurta(a.total)}</strong>
          </span>
          <span class="trilho">
            <span class="lb-barra" style={`width:${Math.min(100, (a.v / a.total) * 100)}%;background:${corDaRampa(k / 3)}`}></span>
            <span class="marca-ano" style={`left:${(parcial.meses / 12) * 100}%`} title={`${parcial.meses} de 12 meses`}></span>
          </span>
        </li>
      ))}
    </ul>
  </section>
)}

{inss && (
  <section class="bloco">
    <div class="texto">
      <h2>O que chega direto às pessoas</h2>
      <p>
        Além do que {quem} gasta, o governo federal paga aposentadorias, pensões e auxílios do INSS direto a quem tem direito.
        Em {inss.ano}, foram <strong>{moedaExtenso(inss.total)}</strong> {onde}, ou {porPessoa(inss.total / ente.pop)} por habitante.
        {frenteAoGasto !== null && (
          frenteAoGasto >= 1
            ? <> É mais do que todo o gasto {deQuem} no ano.</>
            : <> Equivale a {pct(frenteAoGasto)} de todo o gasto {deQuem} no ano.</>
        )}
      </p>
      <p class="menor">
        Valor líquido pago pelas agências do INSS {municipal ? "da cidade" : ehDF ? "do Distrito Federal" : "do estado"}; quem recebe numa agência de outro lugar
        conta lá. Não inclui BPC nem Bolsa Família.
      </p>
    </div>
    <ul class="barras">
      {partesInss.map(([nome, v], k) => (
        <li>
          <span class="lb-linha"><span>{nome}</span><strong class="num" title={moedaCompleta(v)}>{moedaCurta(v)} · {pct(v / inss.total)}</strong></span>
          <span class="lb-barra" style={`width:${(v / partesInss[0][1]) * 100}%;background:${corDaRampa(Math.min(1, k / 3))}`}></span>
        </li>
      ))}
    </ul>
  </section>
)}

{(contas || inss || natureza || balanco || parcial) && (
  <p class="fonte">
    <a href={caminhoNoMapa(ente, esfera)}>Ver no mapa</a>: impostos pagos, repasses federais, comparação com {municipal ? "cidades parecidas" : "outros estados"} e outros anos.
    Fontes: {(contas || natureza || balanco) && <>contas declaradas ao Tesouro Nacional (DCA, Anexos I-C, I-D e I-AB){(parcial || inss) && "; "}</>}
    {parcial && <>relatório bimestral de {parcial.ano} (RREO, Anexo 01){inss && "; "}</>}
    {inss && <>INSS pelo Ministério da Previdência Social (Estatísticas Municipais)</>}.
  </p>
)}

<style>
  .bloco { border-top: 2px solid var(--tinta); padding: 32px 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 32px; }
  .texto { grid-column: span 5; display: flex; flex-direction: column; gap: 12px; }
  .texto h2 { font-size: 34px; }
  .texto p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--texto-2); }
  .texto p strong { color: var(--tinta); }
  .texto .menor { font-size: 14px; color: var(--texto-3); }
  .barras { grid-column: span 7; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; align-self: center; }
  .barras li { display: flex; flex-direction: column; gap: 4px; }
  .lb-linha { display: flex; justify-content: space-between; gap: 12px; font-size: 15px; }
  .lb-linha > span { min-width: 0; font-weight: 600; }
  .lb-linha small { font-size: 13px; font-weight: 400; color: var(--texto-3); }
  .lb-linha strong { white-space: nowrap; font-weight: 600; }
  .lb-barra { display: block; height: 10px; min-width: 2px; }
  .saldo { border-top: 1px solid var(--tinta); padding-top: 10px; }
  .trilho { position: relative; display: block; height: 10px; background: var(--regra-leve); }
  .trilho .lb-barra { height: 100%; }
  .marca-ano { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background: var(--tinta); }
  .linhas { grid-column: span 7; list-style: none; margin: 0; padding: 0; align-self: center; border-top: 1px solid var(--tinta); }
  .linhas li { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--regra-leve); font-size: 15px; }
  .linhas li > span { min-width: 0; font-weight: 600; }
  .linhas small { font-size: 13px; font-weight: 400; color: var(--texto-3); }
  .linhas strong { white-space: nowrap; font-weight: 600; }
  .fonte { margin: 0 0 28px; font-size: 13px; line-height: 1.5; color: var(--texto-3); max-width: 860px; }

  @media (max-width: 900px) {
    .bloco { display: flex; flex-direction: column; gap: 20px; padding: 28px 0; }
    .texto h2 { font-size: 28px; line-height: 1.1; }
    .barras, .linhas { align-self: stretch; }
  }
</style>
