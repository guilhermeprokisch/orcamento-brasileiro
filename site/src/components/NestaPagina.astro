---
/**
 * A lista "Nesta página" das páginas de cidade e de estado: os grupos de seções, na ordem em que
 * aparecem. Cada item aponta para o `id` de uma seção; no navegador, some o item cuja seção está
 * vazia ou escondida (outro ano escolhido), e o grupo inteiro, com o rótulo `.grupo-pagina` dele
 * na página, quando não sobra nenhum item.
 */
export interface GrupoDaPagina {
  /** O id do rótulo do grupo na página (`<p class="grupo-pagina" id=… data-grupo=…>`). */
  id: string;
  n: number;
  titulo: string;
  /** [id da seção, nome na lista] */
  itens: [string, string][];
}

interface Props {
  grupos: GrupoDaPagina[];
}
const { grupos } = Astro.props;
---

<nav class="nesta-pagina" aria-labelledby="nesta-pagina" style={`--grupos:${grupos.length}`}>
  <h2 id="nesta-pagina">Nesta página</h2>
  <div class="grupos">
    {grupos.map((g) => (
      <div class="grupo" data-grupo={g.id}>
        <a class="titulo-grupo" href={`#${g.id}`}>{g.n}. {g.titulo}</a>
        {g.itens.length > 1 && <ul>{g.itens.map(([id, nome]) => <li><a href={`#${id}`}>{nome}</a></li>)}</ul>}
        {g.itens.length === 1 && <ul hidden>{g.itens.map(([id, nome]) => <li><a href={`#${id}`}>{nome}</a></li>)}</ul>}
      </div>
    ))}
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>(".nesta-pagina");
  // Só mexe quando muda: trocar `hidden` dispara o observador abaixo de novo.
  const esconder = (el: HTMLElement, sim: boolean) => { if (el.hidden !== sim) el.hidden = sim; };
  function atualizar() {
    if (!nav) return;
    for (const grupo of nav.querySelectorAll<HTMLElement>(".grupo")) {
      let algum = false;
      for (const li of grupo.querySelectorAll<HTMLElement>("li")) {
        const alvo = document.getElementById(li.querySelector("a")!.hash.slice(1));
        const filhos = alvo ? ([...alvo.children] as HTMLElement[]) : [];
        const vazio = !alvo || !alvo.textContent?.trim() || !!alvo.closest("[hidden]") || (filhos.length > 0 && filhos.every((f) => f.hidden));
        esconder(li, vazio);
        algum ||= !vazio;
      }
      esconder(grupo, !algum);
      const rotulo = document.querySelector<HTMLElement>(`.grupo-pagina[data-grupo="${grupo.dataset.grupo}"]`);
      if (rotulo) esconder(rotulo, !algum);
    }
  }
  atualizar();
  if (nav) new MutationObserver(atualizar).observe(document.querySelector("main") ?? document.body, { subtree: true, attributes: true, attributeFilter: ["hidden"], childList: true });
</script>

<style>
  .nesta-pagina { border-top: 2px solid var(--tinta); border-bottom: 1px solid var(--regra); padding: 16px 0 20px; margin-top: 8px; display: flex; flex-direction: column; gap: 14px; }
  .nesta-pagina h2 { font-family: var(--sans); font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--texto-3); }
  .grupos { display: grid; grid-template-columns: repeat(var(--grupos), minmax(0, 1fr)); gap: 16px 32px; }
  .grupo { display: flex; flex-direction: column; gap: 2px; }
  .titulo-grupo { font-family: var(--serifa); font-size: 19px; font-weight: 700; color: var(--tinta); text-decoration: none; padding-bottom: 4px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  li a { display: block; padding: 5px 0; font-size: 15px; line-height: 1.35; }
  /* `display` acima ganharia do atributo hidden */
  .grupo[hidden], ul[hidden], li[hidden] { display: none; }
  :global(.grupo-pagina) { margin: 40px 0 0; padding-top: 10px; border-top: 4px solid var(--tinta); font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--verde); }
  :global(main [id]) { scroll-margin-top: 16px; }

  @media (max-width: 900px) {
    .grupos { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    li a { padding: 8px 0 8px 16px; }
  }
</style>
