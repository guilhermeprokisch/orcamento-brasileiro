---
/**
 * A página de um governador, deputado estadual ou distrital eleito em 2022: o salário pela lei, a verba da Assembleia
 * (onde ela publica nota a nota), os assessores e a eleição. Onde a fonte não existe, a seção diz o que a Assembleia
 * publica. Usada por pages/politicos/[uf]/[nome].astro, que cuida do topo da página e do script que troca o ano.
 */
import Termo from "../Termo.astro";
import { moedaCurta, moedaExtenso } from "../../lib/formato";
import { anoPadrao, caminhoCidadeNome, docPoliticos, nomePartido, type Ano, type Politico } from "../../lib/politicos";
import { caminhoCidade, caminhoEstado } from "../../lib/cidades";
import { cidadeDoIbge, cotaDoEstado, docEmendasEstaduais, emendasDoDeputado, estadosComEmendas } from "../../lib/emendas-estaduais";

interface Props { p: Politico }
const { p } = Astro.props;
const doc = docPoliticos!;
const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
const nf2 = new Intl.NumberFormat("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const MESES = ["janeiro", "fevereiro", "março", "abril", "maio", "junho", "julho", "agosto", "setembro", "outubro", "novembro", "dezembro"];
const MES3 = MESES.map((m) => m.slice(0, 3));
const governo = p.casa === "governo";
const distrital = p.cargo.includes("distrital");
const f = p.feminino;
const ela = f ? "ela" : "ele", Ela = f ? "Ela" : "Ele", dela = f ? "dela" : "dele";
const o_a = f ? "a" : "o";
const estado = doc.ufs[p.uf] ?? p.uf;
const PREP: Record<string, string> = { AC: "do", AL: "de", AM: "do", AP: "do", BA: "da", CE: "do", DF: "do", ES: "do", GO: "de", MA: "do", MG: "de", MS: "de", MT: "de", PA: "do", PB: "da", PE: "de", PI: "do", PR: "do", RJ: "do", RN: "do", RO: "de", RR: "de", RS: "do", SC: "de", SE: "de", SP: "de", TO: "do" };
const deEstado = `${PREP[p.uf] ?? "de"} ${estado}`;
const ales = doc.assembleias?.[p.uf];
const casaNome = ales?.nome ?? "Assembleia Legislativa";
const casaCurta = distrital ? "a Câmara Legislativa" : "a Assembleia";
const CasaCurta = distrital ? "A Câmara Legislativa" : "A Assembleia";
const nomeVerba = ales?.verba ?? "verba de gabinete";
const NomeVerba = nomeVerba.charAt(0).toUpperCase() + nomeVerba.slice(1);
const colegas = distrital ? "deputados distritais" : `deputados estaduais ${deEstado}`;
const t = p.tse;
const anos = Object.keys(p.anos).sort();
const padrao = anos.length ? anoPadrao(p) : null;
const milhoes = (v: number) => moedaExtenso(v);
const largura = (v: number, max: number) => `width:${max > 0 ? Math.max(0.5, (v / max) * 100).toFixed(1) : 0}%`;
const partidoHoje = p.partido ? (/^s\/ ?partido$/i.test(p.partido) ? "sem partido" : nomePartido(p.partido)) : null;
const cargoMin = p.cargo.toLowerCase();
const situacaoId: Record<string, string> = { "eleito por QP": "eleito-por-qp", "eleito por média": "eleito-por-media" };
const situacao = t?.situacao ? (f ? t.situacao.replace(/^eleito/, "eleita") : t.situacao) : null;

/** Até que mês vai o ano. */
function ultimoMes(a: Ano): number {
  const m = a.verba?.mes ?? [];
  for (let i = 11; i >= 0; i--) if (Math.abs(m[i] ?? 0) > 0) return i + 1;
  if (a.meses && a.meses < 12) return Math.ceil(a.meses);
  return 12;
}
const anoCorrente = String(new Date().getFullYear());
const rotuloAno = (ano: string) => {
  const a = p.anos[ano];
  if (ano !== anoCorrente) return ano;
  const ate = governo && p.saida?.data && Number(p.saida.data.slice(0, 4)) === Number(ano) ? Number(p.saida.data.slice(5, 7)) : a.verba ? ultimoMes(a) : new Date().getMonth();
  return ate ? `${ano} (até ${MESES[ate - 1]})` : ano;
};
const quando = (ano: string) => {
  const r = rotuloAno(ano);
  return r === ano ? `Em ${ano}` : `Em ${ano}, até ${r.match(/até (\w+)/)![1]}`;
};
const mais = (texto: string) => texto.charAt(0).toUpperCase() + texto.slice(1);

// O governador que recebe por outro cargo (em PE, a governadora recebe como procuradora do Estado).
const recebeOutro = governo && !!p.nota && /recebe pelo cargo/.test(p.nota);
// A eleição: a frase curta do topo, quando foi a mais votada; e a de baixo.
const maisVotado = t?.posicao?.[0] === 1;
const fraseEleicao = !t ? "" : governo
  ? `Foi eleit${o_a} em 2022 no ${t.votos2 ? "segundo" : "primeiro"} turno, com <strong>${nf0.format(t.votos2 ?? t.votos ?? 0)} votos</strong>.`
  : maisVotado ? `Em 2022, ${ela} foi ${o_a} ${cargoMin} mais votad${o_a} ${distrital ? "do Distrito Federal" : deEstado}, com <strong>${nf0.format(t.votos ?? 0)} votos</strong>.` : "";
function frase(ano: string, a: Ano) {
  const partes: string[] = [];
  const q = quando(ano);
  if (governo) {
    if (a.salario && recebeOutro) partes.push(`${q}, o salário de ${cargoMin}, pela lei, somou <strong>${milhoes(a.salario)}</strong>. ${Ela} recebe por outro cargo.`);
    else if (a.salario) partes.push(`${q}, ${ela} recebeu ${a.meses && a.meses < 12 && ano === anoCorrente ? "cerca de " : ""}<strong>${milhoes(a.salario)}</strong> de salário como ${cargoMin}.`);
  } else if (a.verba && a.salario) {
    partes.push(`${q}, o mandato ${dela} custou <strong>${milhoes(a.salario + a.verba.total)}</strong>, somando salário e ${nomeVerba}.`);
  } else if (a.salario) {
    partes.push(`${q}, ${ela} recebeu <strong>${milhoes(a.salario)}</strong> de salário.`);
  }
  if (fraseEleicao && (ano === padrao || !partes.length)) partes.push(fraseEleicao);
  return partes.join(" ");
}

// O salário do governador mês a mês no ano escolhido (para a nota do cartão).
const tabelaGov = doc.governadores?.[p.uf];
function notaSalarioGov(ano: string) {
  const tab = tabelaGov?.subsidio ?? [];
  const vigente = (m: string) => [...tab].filter(([d]) => d <= m).at(-1)?.[1];
  const ini = vigente(`${ano}-01`);
  const mudancas = tab.filter(([d]) => d.startsWith(ano) && d > `${ano}-01`);
  const lei = tabelaGov?.lei ? ` (${tabelaGov.lei})` : "";
  if (!mudancas.length) return `R$ ${nf2.format(ini ?? 0)} por mês${lei}, mais 13º.`;
  const partes = [`R$ ${nf2.format(ini ?? mudancas[0][1])} por mês até ${MESES[Number(mudancas[0][0].slice(5, 7)) - 2] ?? "dezembro"}`];
  mudancas.forEach(([d, v], i) => partes.push(`R$ ${nf2.format(v)} desde ${MESES[Number(d.slice(5, 7)) - 1]}${i === mudancas.length - 1 ? lei : ""}`));
  return `${partes.join(", ")}, mais 13º.`;
}
// O salário de cada governador hoje, para a comparação.
const govs = Object.entries(doc.governadores ?? {})
  .filter(([, g]) => !g.aConferir && g.subsidio.length)
  .map(([uf, g]) => ({ uf, nome: doc.ufs[uf] ?? uf, v: g.subsidio.at(-1)![1] }))
  .sort((a, b) => b.v - a.v);
const meuGov = govs.find((g) => g.uf === p.uf);
const posGov = meuGov ? 1 + govs.filter((g) => g.v > meuGov.v).length : 0;
const empatados = meuGov ? govs.filter((g) => g.v === meuGov.v && g.uf !== p.uf) : [];
const maxGov = govs[0]?.v ?? 1;

const mil = (v: number) => `R$ ${(v / 1000).toLocaleString("pt-BR", { maximumFractionDigits: 1 })} mil`;
const deUf = (uf: string) => `${PREP[uf] ?? "de"} ${doc.ufs[uf] ?? uf}`;
const fraseGovs = (() => {
  if (!govs.length) return "";
  const partes = ["Cada estado fixa por lei o salário do governador."];
  const empate = empatados.length ? `, empatado com o ${empatados.map((g) => deUf(g.uf)).join(" e o ")}` : "";
  if (!meuGov) return partes.join(" ");
  if (posGov === 1) partes.push(`O ${deEstado} é <strong>o maior</strong> do país${empate}: ${mil(meuGov.v)} por mês.`);
  else if (meuGov.v === govs.at(-1)!.v) partes.push(`O ${deEstado} é <strong>o menor</strong> do país${empate}: ${mil(meuGov.v)} por mês. O maior é o ${deUf(govs[0].uf)}, ${mil(govs[0].v)}.`);
  else {
    partes.push(`O ${deEstado} é o <strong>${posGov}º maior</strong> do país${empate}: ${mil(meuGov.v)} por mês. O maior é o ${deUf(govs[0].uf)}, ${mil(govs[0].v)}.`);
    const menor = govs.at(-1)!;
    partes.push(`O menor é o ${deUf(menor.uf)}, ${mil(menor.v)}${menor.uf === "RJ" ? ", que não muda desde 2015" : ""}.`);
  }
  return partes.join(" ");
})();
/** A frase da verba quando a Assembleia não a publica nota a nota (ou ainda não lemos). */
function verbaSemDado() {
  const tipo = ales?.tipo;
  if (tipo === "nada") return `${CasaCurta} não publica em que cada deputado gasta a verba. Por isso não há números aqui.`;
  if (tipo === "naoLida") return `${CasaCurta} publica as notas de cada deputado, mas ainda não lemos esses dados.`;
  if (tipo === "nota") return `${CasaCurta} não publicou notas em nome ${dela} neste período.`;
  if (ales?.frase) return `${CasaCurta} ${ales.frase}. Por isso não há números aqui.`;
  return "Ainda não temos esses dados.";
}
// As emendas ao orçamento do estado (emendas_estaduais.py), onde o estado publica com o deputado e a cidade.
const emEst = governo ? null : emendasDoDeputado(p.chave, p.uf);
const estEmendas = docEmendasEstaduais?.estados[p.uf];
const estadoTemEmendas = estadosComEmendas().includes(p.uf);
const nomeCurto = p.nome;
const listaEstados = (() => {
  const xs = estadosComEmendas().map((u) => doc.ufs[u] ?? u).sort((a, b) => a.localeCompare(b, "pt-BR"));
  return xs.length > 1 ? `${xs.slice(0, -1).join(", ")} e ${xs.at(-1)}` : xs[0] ?? "";
})();
const dataSaida = p.saida?.data ? new Date(p.saida.data + "T12:00:00") : null;
const fraseSaida = p.saida
  ? `Governou de janeiro de 2023 ${dataSaida ? `até ${dataSaida.getDate()} de ${MESES[dataSaida.getMonth()]} de ${dataSaida.getFullYear()}` : "até 2026"}, quando deixou o cargo. ${p.saida.frase}`
  : null;
---

{fraseSaida && <p class="outro-cargo">{fraseSaida}</p>}

{anos.length
  ? anos.map((ano) => <p class="frase" data-ano={ano} hidden={ano !== padrao} set:html={frase(ano, p.anos[ano])} />)
  : fraseEleicao && <p class="frase" set:html={fraseEleicao} />}

{anos.length > 1 && (
  <div class="anos" role="group" aria-label="Ano">
    <span>Ano:</span>
    {anos.map((ano) => <button type="button" data-escolhe={ano} aria-pressed={ano === padrao ? "true" : "false"}>{rotuloAno(ano)}</button>)}
  </div>
)}

{!anos.length && (
  <section>
    <h2>Quanto custa</h2>
    <p class="texto">{governo ? `${mais(tabelaGov?.aConferir ?? "não achamos a lei que fixa o salário do governador")}. Por isso o salário fica de fora.` : `Ainda não mostramos o salário: ${ales?.salarioAConferir ?? "falta conferir o valor"}.`}</p>
    {!governo && <p class="texto">{verbaSemDado()}</p>}
  </section>
)}

{anos.map((ano) => {
  const a = p.anos[ano];
  const v = a.verba;
  const comp = v?.comparacao;
  const dif = comp ? v!.porMes / comp.mediana - 1 : null;
  const total = (a.salario ?? 0) + (v?.total ?? 0);
  const maxMes = Math.max(...(v?.mes ?? [0]), 1);
  const maxCat = v?.categorias[0]?.[1] ?? 1;
  const escala = comp?.colegas ? Math.ceil(Math.max(...comp.colegas, v!.porMes) / 10000) * 10000 : 0;
  let marcado = false;
  const pontos = (comp?.colegas ?? []).map((x, i) => {
    const eu = !marcado && x === v!.porMes;
    if (eu) marcado = true;
    return { left: (x / escala) * 100, top: eu ? 30 : 8 + ((i * 37) % 60), eu };
  });
  return (
    <div class="bloco-ano" data-ano={ano} hidden={ano !== padrao}>
      <section>
        <h2>{governo ? "Quanto recebeu" : "Quanto custou"} em {rotuloAno(ano)}</h2>
        {v && a.salario && (
          <div class="pilha" aria-hidden="true"><i class="c1" style={largura(a.salario, total)}></i><i class="c2" style={largura(v.total, total)}></i></div>
        )}
        <div class="cartoes">
          <div>
            <p class="rot"><i class="c1"></i>Salário</p>
            <p class="grande">{a.salario ? moedaCurta(a.salario) : "—"}</p>
            {governo
              ? <p class="nota">{notaSalarioGov(ano)}{a.meses && a.meses < 12 ? ` Conta só os meses no cargo.` : ""}{p.nota ? ` ${p.nota}` : ""}</p>
              : a.salario
                ? <p class="nota">R$ {nf2.format(a.salarioMensal ?? 0)} por mês, mais 13º e férias. É igual para todos os {colegas}: 75% do salário de deputado federal.{a.mesesEstimados ? ` Contamos o ano inteiro: quem se afastou do mandato, para ser secretário ou prefeito, por exemplo, recebeu menos.` : " Valor aproximado: contamos como meses no cargo os meses com gasto na verba."}{p.nota ? ` ${p.nota}` : ""}</p>
                : <p class="nota">Ainda não mostramos: {ales?.salarioAConferir ?? "falta conferir o valor"}.</p>}
          </div>
          {governo ? (
            <div>
              <p class="rot">Gastos do cargo</p>
              <p class="grande apagado">—</p>
              <p class="nota">{f ? "A governadora" : "O governador"} não tem verba de gabinete nem cota. O palácio, a segurança e a equipe são pagos pelo orçamento do estado, que {ela} administra. <a href={caminhoEstado(p.uf)}>Ver o orçamento {deEstado} ›</a></p>
            </div>
          ) : (
            <>
              <div>
                <p class="rot"><i class="c2"></i><Termo id="verba-estadual">{NomeVerba}</Termo></p>
                <p class={v ? "grande" : "grande apagado"}>{v ? moedaCurta(v.total) : "—"}</p>
                <p class="nota">{v ? "Reembolso de gastos do mandato, com nota fiscal." : verbaSemDado()}</p>
              </div>
              <div>
                <p class="rot"><i class="c0"></i>Assessores</p>
                <p class={p.assessores ? "grande" : "grande apagado"}>{p.assessores ? `${p.assessores} pessoas` : "—"}</p>
                <p class="nota">{p.assessores ? `Trabalham no gabinete ${dela} hoje. ${CasaCurta} publica quem está em cada gabinete, mas não quanto cada gabinete custa: esse valor não entra na soma.` : "Ainda não temos o número de assessores deste gabinete."}</p>
              </div>
            </>
          )}
        </div>
        {!governo && <p class="nota">Ficam de fora o plano de saúde e a estrutura d{distrital ? "a Câmara Legislativa" : "a Assembleia Legislativa"}.</p>}
      </section>

      {governo && govs.length > 3 && (
        <section>
          <h2>{f ? "Comparada" : "Comparado"} com os outros governadores</h2>
          <p class="texto" set:html={fraseGovs} />
          <div class="barras govs" role="img" aria-label={`Salário mensal do governador em cada estado, de ${moedaCurta(govs.at(-1)!.v)} a ${moedaCurta(govs[0].v)}.`}>
            {govs.map((g) => <div class={g.uf === p.uf ? "lin eu" : "lin"}><span>{g.nome}</span><i style={largura(g.v, maxGov)}></i><b>R$ {nf2.format(g.v)}</b></div>)}
          </div>
          <p class="nota">O salário fixado na lei, hoje. Fica de fora Mato Grosso, onde não achamos a lei. A folha de pagamento pode ter outros valores.{tabelaGov?.semLei ? ` Aqui, o salário ${tabelaGov.semLei}.` : ""}</p>
        </section>
      )}

      {v && (
        <section>
          <h2>{f ? "Comparada" : "Comparado"} com os {colegas}</h2>
          {comp ? (
            <>
              <p class="texto">{Ela} gastou em média <strong>{mil(v.porMes)} por mês</strong> da verba. A <Termo id="mediana">mediana</Termo> dos {comp.n} {colegas} foi {mil(comp.mediana)}. {Ela} ficou{" "}
                <strong>{Math.abs(dif!) < 0.03 ? "perto da mediana" : `${nf0.format(Math.abs(dif!) * 100)}% ${dif! > 0 ? "acima" : "abaixo"}`}</strong>.</p>
              <div class="faixa" role="img" aria-label={`Gasto médio por mês dos ${comp.n} ${colegas}. ${p.nome}: R$ ${nf0.format(v.porMes)}. Mediana: R$ ${nf0.format(comp.mediana)}.`}>
                {pontos.map((d) => <span class={d.eu ? "ponto eu" : "ponto"} style={`left:${d.left.toFixed(2)}%;top:${d.top}px`}></span>)}
                <span class="linha-mediana" style={`left:${((comp.mediana / escala) * 100).toFixed(2)}%`}><b>mediana</b></span>
                <span class="rot-eu" style={`left:${((v.porMes / escala) * 100).toFixed(2)}%`}>{p.nome.split(" ")[0]}</span>
              </div>
              <div class="eixo"><span>R$ 0</span><span>R$ {nf0.format(escala / 2000)} mil</span><span>R$ {nf0.format(escala / 1000)} mil por mês</span></div>
              <p class="nota">Cada ponto é um deputado {distrital ? "distrital" : `estadual ${deEstado}`} com pelo menos 6 meses de gasto em {ano}, suplentes incluídos. Cada Assembleia tem as próprias regras, por isso só comparamos com o mesmo estado.</p>
            </>
          ) : (
            <p class="texto">Em {ano}, {ela} teve gasto na verba em só {v.meses} {v.meses === 1 ? "mês" : "meses"}: fica fora da comparação, que usa quem teve pelo menos 6.</p>
          )}
        </section>
      )}

      {v && (
        <section>
          <h2>Em que gastou a verba</h2>
          <div class="duas">
            <div>
              <h3>Por tipo de gasto</h3>
              <div class="barras">
                {v.categorias.filter(([, x]) => x > 0).map(([nome, x]) => <div class="lin"><span>{nome}</span><i style={largura(x, maxCat)}></i><b>{moedaCurta(x)}</b></div>)}
              </div>
            </div>
            <div>
              <h3>Mês a mês</h3>
              <div class="meses" role="img" aria-label={`Gasto da verba em cada mês de ${ano}.`}>
                {v.mes.map((x, i) => <div class="m"><i style={`height:${Math.max(0, (x / maxMes) * 150).toFixed(0)}px`}></i><span>{MES3[i]}</span></div>)}
              </div>
              <p class="nota">O valor de cada mês, como {casaCurta} publica.</p>
            </div>
          </div>
          <h3>Quem mais recebeu</h3>
          <ol class="lista">
            {v.fornecedores.map(([nome, cnpj, cat, x]) => <li><span>{nome}<small>CNPJ {cnpj} · {cat.toLowerCase()}</small></span><span>{moedaCurta(x)}</span></li>)}
            {v.pessoaEmpresa[1] > 0 && <li class="soma"><span>Empresas em nome de uma pessoa ({v.pessoaEmpresa[0]})<small>MEI, empresário individual e sociedade de uma pessoa só, somados, sem nome</small></span><span>{moedaCurta(v.pessoaEmpresa[1])}</span></li>}
            <li class="soma"><span>Pessoas físicas<small>somadas, sem nome e sem CPF{v.pessoas[0] ? ` · ${v.pessoas[0]} ${v.pessoas[0] === 1 ? "nota" : "notas"}` : ""}</small></span><span>{moedaCurta(v.pessoas[1])}</span></li>
          </ol>
        </section>
      )}

      {!governo && (() => {
        const em = emEst?.anos[ano];
        const orcamento = distrital ? "do Distrito Federal" : deEstado;
        if (!em) return (
          <section>
            <h2>Para onde mandou emendas</h2>
            <p class="texto">
              {estadoTemEmendas
                ? (estEmendas && Number(ano) < estEmendas.anos[0]
                    ? <>{mais(deEstado.replace(/^(de|do|da) /, (m) => ({ "de ": "", "do ": "o ", "da ": "a " } as Record<string, string>)[m]))} só publica as emendas com o nome do deputado a partir de {estEmendas.anos[0]}.</>
                    : <>Nos dados de emendas {orcamento}, não há emendas em nome {dela} em {ano}.</>)
                : <>Deputados {distrital ? "distritais" : "estaduais"} também indicam <Termo id="emenda-estadual">emendas</Termo>, ao orçamento {orcamento}. Ainda não temos as emendas {deEstado}: cada estado publica de um jeito, e por enquanto a conta tem {listaEstados}.</>}
            </p>
          </section>
        );
        const cota = cotaDoEstado(p.uf, ano);
        const maxCid = em.cid[0]?.[1] ?? 1;
        const g = em.g;
        const maxG = g ? Math.max(...g, 1) : 1;
        return (
          <section>
            <h2>Para onde mandou emendas</h2>
            <p class="texto">
              {quando(ano)}, {nomeCurto} indicou <strong>{milhoes(em.i)}</strong> em <Termo id="emenda-estadual">emendas</Termo> ao orçamento {orcamento}.{" "}
              {em.p !== null
                ? <>O governo {distrital ? "do Distrito Federal" : "do estado"} já pagou <strong>{milhoes(em.p)}</strong> dessas emendas{!distrital && em.nc > 0 && <>, para {em.nc} {em.nc === 1 ? "cidade" : "cidades"}</>}.</>
                : <>{emEst!.estado.pago ? "Os dados do estado não trazem o pago completo desse ano." : "O governo do estado não publica quanto já pagou."}{!distrital && em.nc > 0 && <> As emendas foram para {em.nc} {em.nc === 1 ? "cidade" : "cidades"}.</>}</>}
              {em.pix && em.pix > 0 && <> {mais(moedaCurta(em.pix))} foram por transferência especial, a <Termo id="emenda-pix">emenda Pix</Termo>, que cai direto no caixa da prefeitura.</>}
              {em.est > 0 && !distrital && <> {mais(moedaCurta(em.est))} foram para o estado inteiro, sem uma cidade.</>}
            </p>
            {cota && (cota.igual
              ? <p class="nota">{({ do: "No", da: "Na", de: "Em" } as Record<string, string>)[PREP[p.uf] ?? "de"]} {estado}, cada deputado tem quase a mesma cota de emendas, perto de {moedaCurta(cota.mediana)} no ano. O que muda é para onde manda.</p>
              : <p class="nota">A mediana dos {colegas} foi {moedaCurta(cota.mediana)} indicados no ano.</p>)}
            <div class="tres">
              {!distrital && em.cid.length > 0 && (
                <div>
                  <h3>As cidades que mais receberam</h3>
                  <div class="barras">
                    {em.cid.map(([ibge, x]) => {
                      const cid = cidadeDoIbge(ibge);
                      return <div class="lin">{cid ? <a href={caminhoCidade(cid)}>{cid.nome}</a> : <span>{ibge}</span>}<i style={largura(x, maxCid)}></i><b>{moedaCurta(x)}</b></div>;
                    })}
                  </div>
                  {em.nc > em.cid.length && <p class="nota">E mais {em.nc - em.cid.length} {em.nc - em.cid.length === 1 ? "cidade" : "cidades"}.</p>}
                </div>
              )}
              {g && !distrital && (
                <div>
                  <h3>Para quem</h3>
                  <div class="barras">
                    {([["Prefeituras", g[0]], ["Entidades", g[1]], ["Órgãos do estado", g[2]]] as [string, number][]).filter(([, x]) => x > 0).map(([n, x]) => <div class="lin"><span>{n}</span><i class="areia" style={largura(x, maxG)}></i><b>{moedaCurta(x)}</b></div>)}
                  </div>
                  <p class="nota">Prefeituras inclui os fundos municipais; entidades são associações, caixas escolares e outras sem fins lucrativos.</p>
                </div>
              )}
              {em.areas.length > 0 && (
                <div>
                  <h3>Para quê</h3>
                  <div class="barras">
                    {em.areas.map(([n, x]) => <div class="lin"><span>{n}</span><i class="azul" style={largura(x, em.areas[0][1])}></i><b>{moedaCurta(x)}</b></div>)}
                  </div>
                </div>
              )}
            </div>
            <p class="nota">{em.p !== null ? "Os valores das cidades e das áreas são os já pagos." : "Os valores das cidades e das áreas são os indicados."} Fonte: <a href={emEst!.estado.url} rel="noopener">{emEst!.estado.fonte}</a>.{emEst!.estado.nota && <> {emEst!.estado.nota}</>}</p>
          </section>
        );
      })()}
    </div>
  );
})}

{t && (
  <section>
    <h2>A eleição de 2022</h2>
    <p class="texto">
      {Ela} se candidatou a {cargoMin} {distrital ? "do Distrito Federal" : deEstado} pelo {t.partido}.{" "}
      {governo && t.votos2
        ? <>Teve <strong>{nf0.format(t.votos ?? 0)} votos</strong> no primeiro turno e <strong>{nf0.format(t.votos2)}</strong> no segundo, e foi eleit{o_a}.</>
        : <>Teve <strong>{nf0.format(t.votos ?? 0)} votos</strong> e foi {situacao && situacaoId[t.situacao] ? <Termo id={situacaoId[t.situacao]}>{situacao}</Termo> : (situacao ?? `eleit${o_a}`)}{governo ? " no primeiro turno" : ""}.</>}
      {t.posicao && !governo && <> {t.posicao[0] === 1 ? <>Foi <strong>{o_a} mais votad{o_a}</strong> dos {t.posicao[1]} eleitos {distrital ? "do Distrito Federal" : "do estado"}.</> : <>Foi {o_a} {t.posicao[0]}º mais votad{o_a} dos {t.posicao[1]} eleitos.</>}</>}
      {t.partido && partidoHoje && t.partido !== partidoHoje && <> Hoje está {partidoHoje === "sem partido" ? "sem partido" : `no ${partidoHoje}`}.</>}
    </p>
    <div class="tres">
      {t.cidades && t.cidades.length > 0 && (
        <div>
          <h3>Onde teve mais votos{governo && t.votos2 ? " no primeiro turno" : ""}</h3>
          <div class="barras">
            {t.cidades.map(([mun, uf, , x]) => {
              const href = caminhoCidadeNome(mun, uf);
              return <div class="lin">{href ? <a href={href}>{mun}</a> : <span>{mun}</span>}<i class="azul" style={largura(x, t.cidades![0][3])}></i><b>{nf0.format(x)}</b></div>;
            })}
          </div>
          <p class="nota">{nf0.format(t.cidades[0][4] * 100)}% dos votos vieram de {t.cidades[0][0] === estado ? `${t.cidades[0][0]}, a capital` : t.cidades[0][0]}.{t.nCidades ? ` Teve votos em ${nf0.format(t.nCidades)} ${t.nCidades === 1 ? "cidade" : "cidades"}.` : ""}</p>
        </div>
      )}
      <div>
        <h3>Bens declarados ao TSE</h3>
        {t.bens ? (
          <>
            <p class="grande">{moedaCurta(t.bens.total)}</p>
            <div class="barras">
              {t.bens.tipos.map(([tipo, x]) => <div class="lin"><span>{tipo}</span><i class="areia" style={largura(x, t.bens!.tipos[0][1])}></i><b>{moedaCurta(x)}</b></div>)}
            </div>
            <p class="nota">É o valor que {ela} declarou ao se candidatar, em geral o preço de compra, não o de mercado.</p>
          </>
        ) : <p class="nota">Não declarou bens ao TSE.</p>}
      </div>
      <div>
        <h3>De onde veio o dinheiro da campanha</h3>
        {t.receitas ? (
          <>
            <p class="grande">{moedaCurta(t.receitas.total)}</p>
            <div class="barras">
              {t.receitas.origens.map(([o, x]) => (
                <div class="lin"><span>{o === "Fundo eleitoral" ? <Termo id="fundo-eleitoral">Fundo eleitoral</Termo> : o === "Fundo partidário" ? <Termo id="fundo-partidario">Fundo partidário</Termo> : o}</span><i style={largura(x, t.receitas!.origens[0][1])}></i><b>{moedaCurta(x)}</b></div>
              ))}
            </div>
            {t.receitas.partidos.length > 0 && <p class="nota">Partidos que mais repassaram: {t.receitas.partidos.map(([n, x]) => `${n} (${moedaCurta(x)})`).join("; ")}.</p>}
            {t.receitas.pf[0] > 0 && <p class="nota">Doações de pessoas: {nf0.format(t.receitas.pf[0])}, somadas, sem nome.</p>}
          </>
        ) : <p class="nota">Sem prestação de contas no TSE.</p>}
      </div>
    </div>
  </section>
)}

<section class="nao-diz">
  <h2>O que esta conta não diz</h2>
  <ul>
    {governo ? (
      <>
        <li>O salário não é tudo: {f ? "a governadora" : "o governador"} tem residência oficial, carro, segurança e equipe, pagos pelo orçamento do estado.</li>
        <li>O valor é o da lei. A folha de pagamento pode ter descontos, como o teto, ou outros valores.</li>
      </>
    ) : (
      <>
        <li>A verba é, na maior parte dos estados, um reembolso: o deputado gasta, apresenta a nota fiscal e {casaCurta} devolve, até um teto.</li>
        <li>Gastar muito da verba não é ilegal, e gastar pouco não quer dizer que trabalhou mais ou menos. O que vale olhar é em que foi gasto.</li>
        <li>Cada Assembleia tem regras próprias: o teto, o que a verba paga e o que é publicado mudam de um estado para outro. Por isso só comparamos deputados do mesmo estado.</li>
        <li>O salário do ano é aproximado. O número de assessores é o de hoje, não o de cada ano.</li>
        {emEst && <li>A emenda é uma indicação: só vira dinheiro quando o governo {distrital ? "do Distrito Federal" : "do estado"} paga, e pode ser paga no ano seguinte. Emendas de blocos e bancadas, indicadas em grupo, não entram na conta de um deputado só.</li>}
        {emEst && <li>O lugar da emenda é o de quem recebeu. Cada estado publica as emendas de um jeito; por enquanto a conta tem {listaEstados}.</li>}
      </>
    )}
    <li>Os bens são os que {ela} declarou ao TSE em 2022, pelo valor declarado, que em geral é o de compra.</li>
  </ul>
</section>

<p class="fonte">
  Fontes: {governo ? doc.fontes.governador : <>{p.assembleia ? `${casaNome} (verba, deputados e lotações, dados abertos)` : casaNome}; {doc.fontes.subsidioEstadual}</>}; {doc.fontes.tse}.
  {!governo && " Fornecedores pessoa física e empresas em nome de uma pessoa aparecem só somados."} Nenhum CPF é guardado. <a href="/data/politicos/politicos.json">Baixe os dados de todos (JSON)</a>.
</p>

<style>
  .apagado { color: var(--texto-3); }
  .c0 { background: transparent; border: 1px solid var(--texto-4); }
  .tres { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 40px; }
  .tres > div { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .govs .lin { grid-template-columns: 150px minmax(0, 1fr) 100px; padding: 4px 0; font-size: 14px; }
  .govs .lin i { height: 10px; background: var(--clara, #8fc1a3); }
  .govs .lin.eu i { background: var(--destaque, #a8461f); }
  @media (max-width: 640px) {
    .govs .lin { grid-template-columns: minmax(0, 1fr) 96px; }
  }
</style>
