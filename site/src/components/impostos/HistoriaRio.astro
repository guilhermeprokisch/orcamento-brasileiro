---
/**
 * Parte 1 da página /impostos, "A história": o diagrama de fluxos vai se montando passo a passo enquanto a pessoa
 * rola (o desenho fica parado ao lado do texto; no celular, ocupa a tela com o texto do passo embaixo dele, e os passos
 * da lista viram só o espaço da rolagem). Sem JavaScript, o desenho aparece
 * inteiro ao lado dos textos.
 */
import Diagrama from "./Diagrama.astro";
import Termo from "../Termo.astro";
import { fantasmas } from "../../lib/caminho-explica";
import { bi, biExtenso, soma, totalPago, type DocCaminho } from "../../lib/caminho-impostos";

interface Props { doc: DocCaminho; deixa: { uniao: number; estados: number } | null }
const { doc, deixa } = Astro.props;
const total = totalPago(doc);
const g = doc.governos;
const em100 = (v: number) => Math.round((v / total) * 100);
const f = (chave: string, de?: string, para?: string) => soma(doc, (x) => x.chave === chave && (!de || x.de === de) && (!para || x.para === para));
const imposto = (id: string) => soma(doc, (x) => x.de === `t-${id}`);
const obrigUniao = soma(doc, (x) => x.de === "c-uniao" && x.tipo === "obrigatorio");
const progUniao = soma(doc, (x) => x.de === "c-uniao" && x.tipo === "programa");
const progEstados = soma(doc, (x) => x.de === "c-estados" && x.tipo === "programa");
const fb = doc.fundeb;
const perde = fantasmas(doc).perde;
const sus = Object.values(doc.programas ?? {}).flat().filter((i) => i.nome.startsWith("Saúde")).reduce((t, i) => t + i.valor, 0);
---

<div class="historia-rio">
  <div class="rolagem">
    <div class="palco">
      <div class="desenho">
        <Diagrama doc={doc} forma="largo" historia deixa={deixa} classe="so-largo" />
        <Diagrama doc={doc} forma="estreito" historia deixa={deixa} classe="so-estreito" />
      </div>
      {/* No celular, o texto do passo atual fica aqui, embaixo do desenho, em vez de passar por cima dele (o script copia do passo). */}
      <div class="legenda-passo" aria-hidden="true"></div>
    </div>
    <ol class="passos">
      <li data-passo="1">
        <h2>O que se paga</h2>
        <p>Cada barra é um imposto, do tamanho do que se arrecadou. Os maiores são o <strong>imposto de renda</strong> ({bi(imposto("ir"))}), o <Termo id="icms" />, embutido no preço das coisas ({bi(imposto("icms"))}), e a <strong>contribuição ao INSS</strong> ({bi(imposto("inss"))}).</p>
      </li>
      <li data-passo="2">
        <h2>Quem cobra</h2>
        <p>De cada R$ 100, a <strong>União</strong> cobra R$ {em100(g.uniao.cobra)}, os <strong>estados</strong> R$ {em100(g.estados.cobra)} e as <strong>prefeituras</strong> só R$ {em100(g.prefeituras.cobra)}. O imposto de renda dos servidores de estados e prefeituras fica com eles mesmos: é a faixa fina que desce da primeira barra.</p>
      </li>
      <li data-passo="3">
        <h2>A União divide</h2>
        <p>A Constituição manda a União dar parte do imposto de renda e do IPI aos estados (o <Termo id="fpe" />, {bi(f("fpe"))}) e às prefeituras (o <Termo id="fpm" />, {bi(f("fpm"))}), e uma fatia aos <Termo id="fundos-regionais" /> ({bi(f("fundos"))}). Somando os <Termo id="royalties" />, o salário-educação e a parte dela no <Termo id="fundeb" />, são {biExtenso(obrigUniao)} repassados por obrigação.</p>
      </li>
      <li data-passo="4">
        <h2>Os estados também dividem</h2>
        <p>Um quarto do ICMS ({bi(f("cota-icms"))}) e metade do <Termo id="ipva" /> ({bi(f("cota-ipva"))}) de cada estado vão para as prefeituras dele.</p>
      </li>
      <li data-passo="5">
        <h2>O fundo da educação</h2>
        <p>No Fundeb, cada estado e suas prefeituras põem 20% de vários impostos num fundo e tiram pelo número de alunos. Os estados puseram {bi(fb.estados_poem)} e tiraram {bi(fb.estados_tiram)}; as prefeituras, que têm mais alunos, puseram {bi(fb.prefeituras_poem)} e tiraram {bi(fb.prefeituras_tiram)}. No fim, {bi(f("fundeb"))} passaram dos estados para as prefeituras.</p>
      </li>
      <li data-passo="6">
        <h2>E os programas</h2>
        <p>Fora a divisão dos impostos, a União manda {bi(progUniao)} para programas e os estados mandam {bi(progEstados)} às prefeituras. Esse dinheiro vem com destino certo: a maior parte, {bi(sus)}, é do SUS (consultas, exames, hospitais, agentes de saúde); o resto vai para merenda e transporte escolar, assistência social, convênios para obras e emendas de deputados e senadores.</p>
      </li>
      <li data-passo="7">
        <h2>Quem fica com o dinheiro</h2>
        <p>No fim, a União fica com R$ {em100(g.uniao.fica)} de cada R$ 100, os estados com R$ {em100(g.estados.fica)} e as prefeituras com R$ {em100(g.prefeituras.fica)}: elas cobram pouco, mas são as que mais recebem. É com esse dinheiro que pagam postos de saúde, escolas e a coleta do lixo.</p>
      </li>
      {deixa && (
        <li data-passo="8">
          <h2>O que deixa de entrar</h2>
          <p>Isenções e regimes especiais (os <Termo id="beneficio-fiscal">benefícios fiscais</Termo>) fazem a União deixar de cobrar perto de {biExtenso(deixa.uniao)} por ano{deixa.estados > 0 && <>, e os estados, {biExtenso(deixa.estados)} de ICMS</>}. O pedaço tracejado embaixo de cada imposto mostra quanto dele deixou de ser cobrado: o maior pedaço é do imposto de renda e da Cofins (o Simples Nacional, a cesta básica, as deduções de saúde). E o tracejado continua até quem deixa de receber: pelas mesmas regras de divisão, as prefeituras perdem {bi(perde.prefeituras)} sem decidir nenhum desses benefícios (o FPM e a cota do ICMS diminuem), e os estados, {bi(perde.estados)}.</p>
        </li>
      )}
    </ol>
  </div>

</div>

<style>
  .rolagem { position: relative; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 40px; }
  .palco { grid-column: 2; grid-row: 1; position: sticky; top: 12px; height: calc(100vh - 24px); display: flex; align-items: center; }
  .passos { grid-column: 1; grid-row: 1; list-style: none; margin: 0; padding: 20vh 0 40vh; display: flex; flex-direction: column; gap: 60vh; }
  .passos li { display: flex; flex-direction: column; gap: 10px; padding: 20px 0; border-top: 1px solid var(--regra); opacity: 0.35; transition: opacity 0.4s; }
  .passos li[data-atual] { opacity: 1; }
  .passos h2 { font-size: 28px; }
  .passos p { margin: 0; font-size: 17px; line-height: 1.6; color: var(--texto-2); }

  .historia-rio :global(.so-estreito) { display: none; }

  .desenho { width: 100%; }
  .legenda-passo { display: none; }

  @media (max-width: 900px) {
    .rolagem { display: block; }
    .palco { height: 100vh; height: 100svh; top: 0; z-index: 1; background: var(--papel); padding: 8px 0 12px; flex-direction: column; align-items: stretch; gap: 10px; }
    .desenho { flex: 1 1 auto; min-height: 0; }
    .palco :global(svg) { width: 100%; height: 100%; }
    .legenda-passo { display: flex; flex: none; flex-direction: column; gap: 6px; max-height: 46%; overflow-y: auto; padding: 12px 14px; border: 1px solid var(--regra); border-left: 3px solid var(--tinta); background: var(--papel); }
    .legenda-passo :global(h2) { font-size: 20px; }
    .legenda-passo :global(p) { margin: 0; font-size: 15px; line-height: 1.5; color: var(--texto-2); }
    /* Os passos continuam na página (para quem usa leitor de tela e para medir a rolagem), mas sem aparecer. */
    .passos { padding: 0 0 20vh; gap: 70vh; margin-top: -60vh; position: relative; z-index: 0; }
    .passos li { opacity: 0 !important; pointer-events: none; }
    .passos h2 { font-size: 22px; }
    .passos p { font-size: 15.5px; }
    :global(.historia-rio .so-largo) { display: none !important; }
    :global(.historia-rio .so-estreito) { display: block !important; }
  }
</style>

<script>
  // A história: o passo cujo texto já passou de um ponto da tela manda no desenho.
  function iniciar(raiz: HTMLElement) {
    const passos = [...raiz.querySelectorAll<HTMLElement>(".passos li")];
    const desenhos = [...raiz.querySelectorAll<SVGSVGElement>(".palco svg")];
    const legenda = raiz.querySelector<HTMLElement>(".legenda-passo")!;
    // No celular o desenho ocupa o espaço acima da legenda: encostado embaixo, junto do texto.
    desenhos.forEach((svg) => svg.setAttribute("preserveAspectRatio", "xMidYMax meet"));
    const mostrar = (n: number) => {
      passos.forEach((p) => p.toggleAttribute("data-atual", Number(p.dataset.passo) === n));
      // A legenda do celular é uma cópia do passo, sem os ids (que ficariam repetidos na página).
      const atual = passos.find((p) => Number(p.dataset.passo) === n);
      if (atual) {
        legenda.replaceChildren(...[...atual.children].map((c) => c.cloneNode(true) as HTMLElement));
        legenda.querySelectorAll("[id]").forEach((el) => el.removeAttribute("id"));
        legenda.querySelectorAll("[aria-describedby]").forEach((el) => el.removeAttribute("aria-describedby"));
        legenda.scrollTop = 0;
      }
      for (const svg of desenhos) {
        svg.classList.add("com-destaque");
        svg.querySelectorAll<SVGElement>("[data-desde]").forEach((el) => {
          el.toggleAttribute("data-oculto", Number(el.dataset.desde) > n);
          el.toggleAttribute("data-em-destaque", Number(el.dataset.destaque) === n);
        });
        if (!svg.querySelector("[data-em-destaque]")) svg.classList.remove("com-destaque");
      }
    };
    // O passo atual é o último cujo texto já passou de 60% da altura da tela.
    let ultimo = 0, pedido = false;
    const medir = () => {
      pedido = false;
      let n = Number(passos[0].dataset.passo);
      // No celular os passos não aparecem: o passo muda quando o espaço dele chega à metade da tela.
      const limite = innerWidth <= 900 ? 0.5 : 0.6;
      for (const p of passos) if (p.getBoundingClientRect().top < innerHeight * limite) n = Number(p.dataset.passo);
      if (n !== ultimo) { ultimo = n; mostrar(n); }
    };
    addEventListener("scroll", () => { if (!pedido) { pedido = true; requestAnimationFrame(medir); } }, { passive: true });
    addEventListener("resize", () => requestAnimationFrame(medir));
    medir();
  }
  document.querySelectorAll<HTMLElement>(".historia-rio").forEach(iniciar);
</script>
