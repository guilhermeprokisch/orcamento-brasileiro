---
/**
 * Protótipo, versões 4 e 5: as formas numa página só, cada uma respondendo uma pergunta. A versão 4 começa pelos
 * quadradinhos (inicio="cem"); a 5, pela história do diagrama de fluxos (inicio="rio", VersaoRio).
 *   1. De cada R$ 100 (VersaoCem, a única contada rolando a página): quem fica com quanto.
 *   2. O caminho inteiro (o diagrama de fluxos, já montado): como o dinheiro anda; botões acendem um pedaço.
 *   3. Siga o seu imposto (a lista de VersaoRotas): o dia a dia vira filtros; cada imposto leva ao diagrama.
 * As partes se ligam: o quadradinho e o imposto escolhidos acendem a faixa deles no diagrama.
 */
import Diagrama from "./Diagrama.astro";
import Painel from "./Painel.astro";
import VersaoCem from "./VersaoCem.astro";
import VersaoRio from "./VersaoRio.astro";
import VersaoRotas from "./VersaoRotas.astro";
import { bi, biExtenso, partesInteiras, porMorador, totalPago, type DocCaminho } from "../../lib/caminho-impostos";

interface Props { doc: DocCaminho; deixa: { uniao: number; estados: number } | null; inicio?: "cem" | "rio" }
const { doc, deixa, inicio = "cem" } = Astro.props;
const rio = inicio === "rio";
const itr = doc.composicao?.["outros-federais"]?.find((i) => i.nome.startsWith("ITR"))?.valor ?? 0;
const total = totalPago(doc);
const g = doc.governos;
const fundos = doc.fluxos.filter((f) => f.para === "f-fundos").reduce((t, f) => t + f.valor, 0);
const [cU, cE, cM] = partesInteiras([g.uniao.cobra, g.estados.cobra, g.prefeituras.cobra]);
const [fU, , fE, fM] = partesInteiras([g.uniao.fica, fundos, g.estados.fica, g.prefeituras.fica]);
const ATALHOS = [
  { id: "g-uniao", nome: "A divisão da União" }, { id: "g-icms", nome: "O caminho do ICMS" }, { id: "g-fundeb", nome: "O Fundeb" },
  { id: "g-programas", nome: "Os programas" }, { id: "g-fica", nome: "O que cada um guarda" },
];
---

<section class="v-junta">
  <header class="abre">
    <span class="sobretitulo">Brasil, todos os governos somados · {doc.ano}</span>
    <h1>Eu pago imposto para quem?</h1>
    <p>
      Para três governos, e o dinheiro não fica onde foi pago. Em {doc.ano}, quem mora no Brasil pagou <strong class="marca">{biExtenso(total)}</strong>
      {porMorador(doc, total) && <> ({porMorador(doc, total)} por pessoa)</>}. De cada R$ 100, a União cobrou R$ {cU} e ficou com R$ {fU}; os estados
      cobraram R$ {cE} e ficaram com R$ {fE}; as prefeituras cobraram R$ {cM} e ficaram com R$ {fM}.
    </p>
  </header>

  <nav class="indice" aria-label="Nesta página">
    {rio
      ? <a href="#a-historia"><b>1.</b> A história <span>o caminho, passo a passo</span></a>
      : <a href="#de-cada-100"><b>1.</b> De cada R$ 100 <span>quem fica com quanto</span></a>}
    <a href="#caminho-inteiro"><b>2.</b> O caminho inteiro <span>{rio ? "para explorar, clicando" : "como o dinheiro anda"}</span></a>
    <a href="#siga-o-seu-imposto"><b>3.</b> Siga o seu imposto <span>o que você paga</span></a>
  </nav>

  {rio ? (
    <>
      <div class="titulo-parte" id="a-historia">
        <span class="n">1</span>
        <div><h2>A história: do imposto pago a quem fica com ele</h2><p>Role a página: o desenho vai se montando, imposto por imposto, até cada governo.</p></div>
      </div>
      <VersaoRio doc={doc} deixa={deixa} parte />
    </>
  ) : (
    <>
      <div class="titulo-parte" id="de-cada-100">
        <span class="n">1</span>
        <div><h2>De cada R$ 100, quem fica com quanto</h2><p>Cada quadradinho é R$ 1 de cada R$ 100 pagos. Role para ver ele mudar de mão.</p></div>
      </div>
      <VersaoCem doc={doc} deixa={deixa} parte />
    </>
  )}

  <section class="parte-caminho" id="caminho-inteiro">
    <div class="titulo-parte">
      <span class="n">2</span>
      <div><h2>O caminho inteiro</h2><p>Todos os impostos, quem cobra e quem fica com o dinheiro. Clique numa barra ou numa faixa, ou acenda um pedaço:</p></div>
    </div>
    <div class="atalhos" role="group" aria-label="Mostrar">
      {ATALHOS.map((a) => <button type="button" data-grupo={a.id}>{a.nome}</button>)}
    </div>
    <div class="explorar-grade">
      <div>
        <Diagrama doc={doc} forma="largo" deixa={deixa} classe="so-largo explorar-svg" />
        <Diagrama doc={doc} forma="estreito" deixa={deixa} classe="so-estreito explorar-svg" />
      </div>
      <Painel doc={doc} deixa={deixa} inicial="g-uniao" />
    </div>
    <p class="cobertura">
      <strong>Estão todos os impostos do país.</strong> Os menores aparecem somados: o ITR (das terras rurais, {bi(itr)}), a CIDE dos
      combustíveis e o salário-educação em "Outros federais"; as taxas e a contribuição de iluminação pública em "Taxas". O Simples Nacional não
      aparece à parte porque o que se paga nele já está dividido entre o imposto de renda, a Cofins, o INSS, o ICMS e o ISS. Ficam de fora o FGTS
      (que é do trabalhador), as contribuições ao Sistema S (Sesi, Senai, Sesc…) e a previdência própria dos servidores públicos.
    </p>
  </section>

  <div class="titulo-parte" id="siga-o-seu-imposto">
    <span class="n">3</span>
    <div><h2>Siga o seu imposto</h2><p>Para onde vai cada imposto que você paga. Escolha onde você paga, ou clique num imposto.</p></div>
  </div>
  <VersaoRotas doc={doc} deixa={deixa} parte />
</section>

<style>
  .v-junta .abre { padding: 40px 0 20px; max-width: 880px; display: flex; flex-direction: column; gap: 14px; }
  .v-junta .abre h1 { font-size: 64px; line-height: 0.98; letter-spacing: -0.025em; }
  .v-junta .abre p { margin: 0; font-size: 20px; line-height: 1.55; color: var(--texto-2); }
  .indice { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 2px solid var(--tinta); border-bottom: 1px solid var(--regra); margin-bottom: 8px; }
  .indice a { display: flex; flex-direction: column; gap: 2px; padding: 14px 16px 14px 0; color: var(--tinta); text-decoration: none; font-size: 17px; font-family: var(--serifa); font-weight: 600; }
  .indice a + a { padding-left: 16px; border-left: 1px solid var(--regra); }
  .indice a:hover { text-decoration: underline; }
  .indice span { font-family: var(--sans); font-weight: 400; font-size: 14px; color: var(--texto-3); }
  .titulo-parte { display: flex; gap: 16px; align-items: flex-start; padding: 36px 0 12px; scroll-margin-top: 12px; }
  .titulo-parte .n { flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--tinta); color: var(--papel); display: grid; place-items: center; font-family: var(--serifa); font-weight: 700; font-size: 22px; }
  .titulo-parte h2 { font-size: 36px; line-height: 1.1; }
  .titulo-parte p { margin: 6px 0 0; font-size: 17px; line-height: 1.5; color: var(--texto-2); max-width: 760px; }
  .parte-caminho { border-top: 2px solid var(--tinta); padding-bottom: 28px; display: flex; flex-direction: column; gap: 12px; scroll-margin-top: 12px; }
  .parte-caminho .titulo-parte { padding-top: 28px; }
  .atalhos { display: flex; flex-wrap: wrap; gap: 6px; padding-left: 56px; }
  .atalhos button { padding: 6px 12px; border: 1px solid var(--tinta); background: var(--papel); font: inherit; font-size: 14px; cursor: pointer; }
  .atalhos button[aria-pressed="true"] { background: var(--tinta); color: var(--papel); }
  .explorar-grade { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 32px; align-items: start; }
  .v-junta :global(.so-estreito) { display: none; }
  #siga-o-seu-imposto { border-top: 2px solid var(--tinta); }
  .cobertura { margin: 4px 0 0; font-size: 14px; line-height: 1.55; color: var(--texto-3); max-width: 880px; }
  .cobertura strong { color: var(--tinta); }

  @media (max-width: 900px) {
    .v-junta .abre h1 { font-size: 40px; }
    .v-junta .abre p { font-size: 17px; }
    .indice a { font-size: 14px; padding: 10px 8px 10px 0; line-height: 1.25; }
    .indice a + a { padding-left: 8px; }
    .indice span { display: none; }
    .titulo-parte { gap: 12px; padding-top: 28px; }
    .titulo-parte .n { width: 32px; height: 32px; font-size: 18px; }
    .titulo-parte h2 { font-size: 26px; }
    .titulo-parte p { font-size: 15.5px; }
    .atalhos { padding-left: 0; }
    .explorar-grade { display: flex; flex-direction: column; align-items: stretch; gap: 16px; }
    :global(.v-junta .so-largo) { display: none !important; }
    :global(.v-junta .so-estreito) { display: block !important; }
  }
</style>

<script>
  // Os botões "acenda um pedaço" pedem ao painel do diagrama o conjunto de faixas.
  document.querySelectorAll<HTMLElement>(".v-junta .parte-caminho").forEach((secao) => {
    const botoes = [...secao.querySelectorAll<HTMLButtonElement>(".atalhos button")];
    botoes.forEach((b) => b.addEventListener("click", () => {
      botoes.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      secao.dispatchEvent(new CustomEvent("escolher", { detail: b.dataset.grupo }));
    }));
    // Escolher outro pedaço (clicando no desenho ou vindo das outras partes) desliga o botão.
    secao.addEventListener("escolher", (e) => {
      const id = (e as CustomEvent<string>).detail;
      botoes.forEach((x) => x.setAttribute("aria-pressed", String(x.dataset.grupo === id)));
    });
    secao.querySelectorAll("svg").forEach((svg) => svg.addEventListener("click", () => botoes.forEach((x) => x.setAttribute("aria-pressed", "false"))));
  });
  // Para as capturas de tela: &escolher=g-icms acende um pedaço do diagrama; &dia=compras aperta um filtro da parte 3.
  const q = new URLSearchParams(location.search);
  requestAnimationFrame(() => {
    const escolha = q.get("escolher"), dia = q.get("dia");
    if (escolha) document.querySelector(".v-junta .parte-caminho")?.dispatchEvent(new CustomEvent("escolher", { detail: escolha }));
    if (dia) [...document.querySelectorAll<HTMLButtonElement>(".v-junta .dia button")].find((b) => b.textContent!.toLowerCase().includes(dia))?.click();
  });
</script>
