---
import { moedaCurta } from "../../lib/formato";
import { corDaRampa } from "../../lib/cores";
import type { Item } from "../../lib/dados";

interface Props {
  titulo: string;
  itens: Item[];
  total: number;
  link: (item: Item) => string;
  limite?: number;
}
const { titulo, itens, total, link, limite = 5 } = Astro.props;
const mostrados = itens.slice(0, limite);
const resto = itens.slice(limite);
const valorResto = resto.reduce((s, i) => s + i.valores.atualizado, 0);
const max = Math.max(1, ...mostrados.map((i) => i.valores.atualizado));
const pct = (v: number) => `${Math.round((v / Math.max(1, total)) * 100)}%`;
---

<section class="lb">
  <h3>{titulo}</h3>
  {mostrados.map((i, k) => (
    <a href={link(i)}>
      <span class="lb-linha"><span>{i.nome}</span><strong class="num">{moedaCurta(i.valores.atualizado)}</strong></span>
      <span class="lb-barra" style={`width:${(i.valores.atualizado / max) * 100}%;background:${corDaRampa(Math.min(1, k / 4))}`}></span>
    </a>
  ))}
  {resto.length > 0 && <span class="lb-resto">+ {resto.length} itens ({moedaCurta(valorResto)}, {pct(valorResto)})</span>}
</section>

<style>
  .lb { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .lb h3 {
    font-family: var(--sans); font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--texto-3); border-bottom: 1px solid var(--tinta); padding-bottom: 6px;
  }
  .lb a { display: flex; flex-direction: column; gap: 4px; color: var(--tinta); text-decoration: none; }
  .lb a:hover .lb-linha span { text-decoration: underline; }
  .lb-linha { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; }
  .lb-linha strong { white-space: nowrap; }
  .lb-barra { display: block; height: 8px; min-width: 2px; }
  .lb-resto { font-size: 13px; color: var(--texto-3); }
</style>
