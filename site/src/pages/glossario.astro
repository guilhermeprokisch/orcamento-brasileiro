---
import Base from "../layouts/Base.astro";
import { GLOSSARIO, palavraDoDia } from "../lib/glossario";

const doDia = palavraDoDia();
const termos = [...GLOSSARIO].sort((a, b) => a.termo.localeCompare(b.termo, "pt-BR"));
---

<Base title="Glossário · Orçamento Brasileiro" description="O que significam empenho, dotação, restos a pagar e outros termos do orçamento federal.">
  <div class="wrap">
    <section class="topo">
      <h1>Glossário do orçamento</h1>
      <p>As palavras que aparecem no Explorer e nos perfis, explicadas sem juridiquês.</p>
    </section>

    <section class="destaque" aria-labelledby="palavra-do-dia">
      <span class="sobretitulo verde" id="palavra-do-dia">Palavra do dia</span>
      <h2><span class="marca">{doDia.termo}</span></h2>
      <p>{doDia.definicao}</p>
    </section>

    <dl class="lista">
      {termos.map((t) => (
        <div id={t.id}>
          <dt>{t.termo}</dt>
          <dd>{t.definicao}</dd>
        </div>
      ))}
    </dl>
  </div>
</Base>

<style>
  .topo { padding: 44px 0 28px; display: flex; flex-direction: column; gap: 12px; max-width: 820px; }
  .topo h1 { font-size: 60px; line-height: 1; letter-spacing: -0.025em; }
  .topo p { margin: 0; font-size: 18px; color: var(--texto-2); }
  .destaque { border-top: 2px solid var(--tinta); padding: 28px 0; display: flex; flex-direction: column; gap: 10px; max-width: 820px; }
  .destaque h2 { font-size: 40px; }
  .destaque p { margin: 0; font-size: 19px; line-height: 1.6; color: var(--texto-2); }
  .lista { margin: 0; border-top: 2px solid var(--tinta); }
  .lista div {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px;
    padding: 18px 0; border-bottom: 1px solid var(--regra);
  }
  .lista div:target { background: var(--marca-texto-fundo); }
  .lista dt { grid-column: span 4; font-family: var(--serifa); font-size: 24px; font-weight: 700; line-height: 1.2; }
  .lista dd { grid-column: span 8; margin: 0; font-size: 16px; line-height: 1.6; color: var(--texto-2); }
  @media (max-width: 900px) {
    .topo { padding: 28px 0 20px; }
    .topo h1 { font-size: 38px; }
    .destaque h2 { font-size: 30px; }
    .destaque p { font-size: 16px; }
    .lista div { display: flex; flex-direction: column; gap: 6px; }
    .lista dt { font-size: 21px; }
  }
</style>
