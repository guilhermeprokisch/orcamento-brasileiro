---
import Base from "../../layouts/Base.astro";
import ListaBarras from "../../components/perfil/ListaBarras.astro";
import EvolucaoPerfil from "../../components/perfil/EvolucaoPerfil";
import { agrupar, taxaRealizacao, type Filtro } from "../../lib/dados";
import { moedaCompleta, moedaExtenso, pct } from "../../lib/formato";
import {
  anoBase, anoCorrente, docBase, linkExplorer, maiores, orgaosComPerfil, resumo, serieHistorica,
} from "../../lib/perfis";

export function getStaticPaths() {
  return orgaosComPerfil().map((o) => ({ params: { cod: o.cod }, props: { nome: o.nome } }));
}

const { cod } = Astro.params as { cod: string };
const { nome } = Astro.props as { nome: string };
const filtro: Filtro[] = [{ dim: "orgao", cod }];

const totalFederal = docBase ? agrupar(docBase, [], null).total : null;
const v = docBase ? agrupar(docBase, filtro, null).total : null;
const existeNoBase = !!v && (v.atualizado !== 0 || v.realizado !== 0);
const parcela = v && totalFederal ? v.atualizado / totalFederal.atualizado : null;
const taxa = v ? taxaRealizacao(v) : null;
const taxaEmpenho = v && v.atualizado > 0 ? v.empenhado / v.atualizado : null;

const serie = serieHistorica(filtro);
const nominal = serie.map((p) => ({ ano: p.ano, valores: p.nominal }));
const real = serie.map((p) => ({ ano: p.ano, valores: p.real }));
const anosComValor = serie.filter((p) => p.nominal.atualizado > 0).map((p) => p.ano);

const uos = maiores(filtro, "uo");
const programas = maiores(filtro, "programa");
const gnds = maiores(filtro, "gnd");
const funcoes = maiores(filtro, "funcao");
const total = v?.atualizado ?? 0;

const explorerOrgao = linkExplorer(filtro);
const explorerSemAno = explorerOrgao.replace(/ano=\d+&?/, "");
const descricao = existeNoBase
  ? `Orçamento do ${nome} em ${anoBase}: ${moedaExtenso(v!.atualizado)} autorizados, ${moedaExtenso(v!.realizado)} realizados.`
  : `Orçamento do ${nome}.`;
---

<Base title={`${nome} · Orçamento BR`} description={descricao}>
  <div class="faixa-titulo"><h1>Perfil do órgão</h1></div>

  <div class="wrap perfil">
    <nav class="migalha small" aria-label="Caminho">
      <a href="/orgaos">Órgãos</a> <span aria-hidden="true">›</span> <span>{nome}</span>
    </nav>

    <header class="perfil-cabeca">
      <div>
        <h2>{nome}</h2>
        <p class="muted">Órgão superior <code>{cod}</code> · dados de {anoBase}</p>
      </div>
      <a class="btn-explorar" href={explorerOrgao}>Abrir no Explorer →</a>
    </header>

    {existeNoBase ? (
      <>
        <p class="resumo">
          Em {anoBase}, o {nome} teve <strong>{moedaExtenso(v!.atualizado)}</strong> autorizados para gastar
          {parcela !== null && <>, ou <strong>{pct(parcela)}</strong> do orçamento federal</>}.
          Empenhou {pct(taxaEmpenho)} desse valor e realizou <strong>{pct(taxa)}</strong>.
        </p>

        <section class="numeros" aria-label={`Totais de ${anoBase}`}>
          <div><span>Dotação inicial</span><strong class="num" title={moedaCompleta(v!.inicial)}>{moedaExtenso(v!.inicial)}</strong></div>
          <div><span>Dotação atualizada</span><strong class="num" title={moedaCompleta(v!.atualizado)}>{moedaExtenso(v!.atualizado)}</strong></div>
          <div><span>Empenhado</span><strong class="num" title={moedaCompleta(v!.empenhado)}>{moedaExtenso(v!.empenhado)}</strong></div>
          <div><span>Realizado</span><strong class="num" title={moedaCompleta(v!.realizado)}>{moedaExtenso(v!.realizado)}</strong></div>
        </section>
      </>
    ) : (
      <p class="resumo">
        Este órgão não tem valores em {anoBase}; ele aparece no orçamento de {anoCorrente}, ainda em execução.
      </p>
    )}

    <section class="bloco">
      <h3 class="titulo-secao">Evolução de {serie[0]?.ano} a {serie.at(-1)?.ano}</h3>
      {anosComValor.length < serie.length && (
        <p class="muted small aviso">
          Com este código, o órgão aparece em {anosComValor.length} de {serie.length} anos.
        </p>
      )}
      <div class="cartao">
        <EvolucaoPerfil
          client:visible
          nominal={nominal}
          real={real}
          baseIpca={resumo?.ipca?.base ?? null}
          anoSelecionado={anoBase}
          anoCorrente={anoCorrente}
          explorer={explorerSemAno}
        />
      </div>
    </section>

    {existeNoBase && (
      <section class="bloco">
        <h3 class="titulo-secao">Para onde vai o dinheiro em {anoBase}</h3>
        <p class="muted small">Dotação atualizada. Clique num item para abri-lo no Explorer.</p>
        <div class="grade">
          <ListaBarras titulo="Unidades orçamentárias" itens={uos} total={total}
            link={(i) => linkExplorer([...filtro, { dim: "uo", cod: i.codigo }])} />
          <ListaBarras titulo="Programas" itens={programas} total={total}
            link={(i) => linkExplorer([...filtro, { dim: "programa", cod: i.codigo }])} />
          <ListaBarras titulo="Tipo de gasto (grupo de despesa)" itens={gnds} total={total}
            link={(i) => linkExplorer([...filtro, { dim: "gnd", cod: i.codigo }])} />
          <ListaBarras titulo="Áreas de governo (funções)" itens={funcoes} total={total} limite={6}
            link={(i) => linkExplorer([...filtro, { dim: "funcao", cod: i.codigo }])} />
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .perfil { padding-top: 20px; padding-bottom: 56px; }
  .migalha { color: var(--text-2); margin-bottom: 20px; }
  .migalha a { text-decoration: none; }
  .perfil-cabeca { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  .perfil-cabeca h2 { margin: 0; font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 600; line-height: 1.15; color: var(--link); }
  .perfil-cabeca p { margin: 6px 0 0; }
  .perfil-cabeca code { font-size: 0.875em; }
  .btn-explorar {
    flex: none; background: #005ea2; color: #ffffff; text-decoration: none; font-weight: 600;
    padding: 10px 18px; border-radius: 4px;
  }
  .btn-explorar:hover { background: #1a4480; }
  .resumo { font-size: 1.25rem; line-height: 1.55; max-width: 68ch; margin: 24px 0; }
  .numeros { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .numeros div { border: 1px solid var(--border); background: var(--surface); padding: 16px 18px; display: grid; gap: 4px; }
  .numeros span { font-size: 0.875rem; font-weight: 600; text-transform: uppercase; color: var(--text-2); letter-spacing: 0.02em; }
  .numeros strong { font-size: 1.5rem; font-weight: 600; color: var(--total); }
  .bloco { margin-top: 48px; }
  .titulo-secao { margin: 0 0 6px; font-size: 1.5rem; font-weight: 600; }
  .aviso { margin: 0 0 12px; }
  .cartao { border: 1px solid var(--border); background: var(--surface); padding: 16px 24px 18px; margin-top: 12px; }
  .grade { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 16px; }
  :global(.perfil-ev-controles) { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; margin-bottom: 12px; }
  :global(.perfil-ev-controles .ex-seg) { margin-left: 0; }
  @media (max-width: 900px) {
    .numeros { grid-template-columns: repeat(2, 1fr); }
    .grade { grid-template-columns: 1fr; }
    .cartao { padding: 12px 8px; }
    .resumo { font-size: 1.125rem; }
    .numeros strong { font-size: 1.25rem; }
  }
</style>
