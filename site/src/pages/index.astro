---
import Base from "../layouts/Base.astro";
import { moedaCurta, pct } from "../lib/formato";
import type { ResumoAnos } from "../lib/dados";

// Gerado pelo pipeline; o glob devolve {} se ele ainda não rodou.
const arquivos = import.meta.glob<ResumoAnos>("../../public/data/explorer/anos.json", {
  eager: true,
  import: "default",
});
const resumo: ResumoAnos | null = Object.values(arquivos)[0] ?? null;
const corrente = new Date().getFullYear();
const ultimo = resumo?.anos.filter((a) => a.ano < corrente).at(-1) ?? resumo?.anos.at(-1);

const fases = [
  ["Dotação", "O valor autorizado na Lei Orçamentária Anual (LOA), ajustado por créditos ao longo do ano."],
  ["Empenho", "O governo reserva o dinheiro para uma despesa específica, como um contrato."],
  ["Liquidação", "Confere que o serviço foi prestado ou o bem foi entregue."],
  ["Pagamento", "O dinheiro sai do caixa do Tesouro para quem prestou o serviço."],
];
---

<Base title="Orçamento BR · O orçamento federal, explicado">
  <section class="hero">
    <div class="wrap">
      {ultimo ? (
        <>
          <p class="eyebrow">Orçamento federal de {ultimo.ano}</p>
          <h1>
            <span class="num">{moedaCurta(ultimo.atualizado)}</span>
            <span class="sub">autorizados para gastar</span>
          </h1>
          <div class="tiles">
            <div class="tile"><div class="small muted">Empenhado</div><div class="v num">{moedaCurta(ultimo.empenhado)}</div></div>
            <div class="tile"><div class="small muted">Realizado</div><div class="v num">{moedaCurta(ultimo.realizado)}</div></div>
            <div class="tile"><div class="small muted">Realizado / dotação</div><div class="v num">{pct(ultimo.realizado / ultimo.atualizado)}</div></div>
          </div>
        </>
      ) : (
        <h1>O orçamento federal, explicado</h1>
      )}
      <a class="cta" href={`/explorer${ultimo ? `?ano=${ultimo.ano}` : ""}`}>Explorar o orçamento →</a>
    </div>
  </section>

  <section class="wrap fases">
    <h2>Como o dinheiro anda</h2>
    <ol>
      {fases.map(([t, d], i) => (
        <li>
          <span class="passo num">{i + 1}</span>
          <div><strong>{t}</strong><p class="muted">{d}</p></div>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .hero { padding: 56px 0 40px; border-bottom: 1px solid var(--border); background: var(--surface); }
  .eyebrow { margin: 0 0 8px; color: var(--text-2); font-weight: 600; }
  h1 { margin: 0; font-size: clamp(2.25rem, 7vw, 4rem); line-height: 1.05; letter-spacing: -0.03em; }
  h1 .sub { display: block; font-size: 0.4em; font-weight: 500; letter-spacing: -0.01em; color: var(--text-2); margin-top: 8px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin: 28px 0; max-width: 640px; }
  .tile { border: 1px solid var(--border); border-radius: var(--radius); padding: 12px 14px; background: var(--bg); }
  .tile .v { font-size: 1.375rem; font-weight: 650; }
  .cta {
    display: inline-block; background: var(--accent); color: var(--accent-ink); text-decoration: none;
    padding: 10px 16px; border-radius: var(--radius); font-weight: 600;
  }
  .fases { padding-top: 40px; }
  .fases h2 { font-size: 1.25rem; margin: 0 0 16px; }
  .fases ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .fases li { display: flex; gap: 12px; }
  .fases p { margin: 4px 0 0; }
  .passo {
    flex: none; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center;
    background: var(--surface-2); font-weight: 700; font-size: 0.875rem;
  }
</style>
