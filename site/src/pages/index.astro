---
import Base from "../layouts/Base.astro";
import { agrupar } from "../lib/dados";
import { moedaCurta, moedaExtenso } from "../lib/formato";
import { anoBase, docBase, resumo } from "../lib/perfis";
import { corDaRampa, DESTAQUE, OUTRAS } from "../lib/cores";
import { palavraDoDia } from "../lib/glossario";

const ultimo = resumo?.anos.find((a) => a.ano === anoBase) ?? null;
const dataExtenso = resumo
  ? new Date(resumo.gerado_em).toLocaleDateString("pt-BR", { day: "numeric", month: "long", year: "numeric" })
  : "";
const dataCurta = resumo ? new Date(resumo.gerado_em).toLocaleDateString("pt-BR") : "";

const explorer = (q = "") => `/explorer?ano=${anoBase}${q ? `&${q}` : ""}`;

// Funções sem o refinanciamento da dívida, da maior para a menor.
const funcoes = docBase
  ? agrupar(docBase, [], "funcao", true).itens.filter((i) => i.valores.atualizado > 0).sort((a, b) => b.valores.atualizado - a.valores.atualizado)
  : [];
const totalFuncoes = funcoes.reduce((s, i) => s + i.valores.atualizado, 0) || 1;
const valorFuncao = (cod: string) => funcoes.find((i) => i.codigo === cod)?.valores.atualizado ?? 0;

// "De cada R$ 100": as 5 maiores áreas + as outras juntas.
const DESCRICAO: Record<string, string> = {
  "28": "dívida e transferências",
  "09": "aposentadorias e pensões",
  "08": "assistência social",
  "10": "saúde",
  "12": "educação",
  "11": "trabalho e emprego",
  "05": "defesa nacional",
};
const CODIGO_DESTAQUE = "10"; // saúde em amarelo, como no mock
const top = funcoes.slice(0, 5);
const outras = funcoes.slice(5);
const cem = [
  ...top.map((f, i) => ({
    cod: f.codigo,
    pct: (f.valores.atualizado / totalFuncoes) * 100,
    rotulo: DESCRICAO[f.codigo] ?? f.nome.toLowerCase(),
    cor: f.codigo === CODIGO_DESTAQUE ? DESTAQUE : corDaRampa(i / 4),
    destaque: f.codigo === CODIGO_DESTAQUE,
    href: explorer(`f=funcao:${f.codigo}&por=subfuncao&refin=0`),
  })),
  {
    cod: "outras",
    pct: (outras.reduce((s, i) => s + i.valores.atualizado, 0) / totalFuncoes) * 100,
    rotulo: `as outras ${outras.length} áreas`,
    cor: OUTRAS,
    destaque: false,
    href: explorer("por=funcao&refin=0"),
  },
];

// Mapa de blocos do celular, no formato do mock: as duas maiores áreas em
// faixas inteiras e as demais lado a lado na última faixa.
const mapaCelular = (() => {
  if (top.length < 2) return [];
  const itens = [
    ...top.map((f, i) => ({ cod: f.codigo, nome: f.nome, v: f.valores.atualizado, i })),
    { cod: "outras", nome: `Outras ${outras.length} áreas`, v: outras.reduce((s, x) => s + x.valores.atualizado, 0), i: 5 },
  ];
  const [a, b, ...resto] = itens;
  const somaResto = resto.reduce((s, x) => s + x.v, 0);
  const pctDe = (v: number) => (v / totalFuncoes) * 100;
  const corDe = (cod: string, i: number) => (cod === "outras" ? OUTRAS : cod === CODIGO_DESTAQUE ? DESTAQUE : corDaRampa(i / 4));
  const hrefDe = (cod: string) => (cod === "outras" ? explorer("por=funcao&refin=0") : explorer(`f=funcao:${cod}&por=subfuncao&refin=0`));
  const faixas = [
    { tipo: "linha" as const, peso: pctDe(a.v), itens: [a] },
    { tipo: "linha" as const, peso: pctDe(b.v), itens: [b] },
    { tipo: "colunas" as const, peso: pctDe(somaResto), itens: resto },
  ];
  return faixas.map((f) => ({
    ...f,
    itens: f.itens.map((x) => ({
      cod: x.cod, nome: x.cod === "outras" ? x.nome : x.nome.split(" ")[0] === "Assistência" ? "Assistência" : x.nome,
      pct: pctDe(x.v), cor: corDe(x.cod, x.i), claro: x.i >= 2, href: hrefDe(x.cod),
    })),
  }));
})();

const areas = [
  { cod: "10", nome: "Saúde" },
  { cod: "12", nome: "Educação" },
  { cod: "09", nome: "Previdência" },
  { cod: "08", nome: "Assistência social" },
];
const palavra = palavraDoDia();
const fmtPct = (p: number) => Math.round(p);
---

<Base
  title="Orçamento Brasileiro · O dinheiro público da sua cidade, do seu estado e do país"
  description="De onde vem e para onde vai o dinheiro público da sua cidade, do seu estado e do país: impostos, repasses, gastos, dívidas e o que eles produzem."
  dateline={{
    esquerda: `Dados atualizados em ${dataExtenso} · fontes oficiais`,
    direita: `Orçamento federal · exercício ${anoBase}`,
    celular: `Atualizado em ${dataCurta} · exercício ${anoBase}`,
  }}
>
  <div class="wrap">
    {ultimo && (
      <section class="hero">
        <div class="hero-texto">
          <h1>O governo federal pôde gastar <span class="marca">{moedaExtenso(ultimo.atualizado)}</span> em {anoBase}.</h1>
          <p class="lede">
            E pagou {moedaExtenso(ultimo.realizado)}.<span class="so-largo"> Aqui você acompanha para onde foi cada real, órgão por órgão, desde 2014, com os dados oficiais.</span><span class="so-celular"> Veja para onde foi cada real.</span>
          </p>
          <div class="acoes">
            <a class="botao" href={explorer()}>Explorar o orçamento →</a>
            <a class="link-forte so-largo" href="#como-funciona">Como o dinheiro anda</a>
          </div>
        </div>
        <aside class="hero-numeros">
          <div><span>Autorizado</span><strong class="num">{moedaCurta(ultimo.atualizado)}</strong></div>
          <div><span>Empenhado</span><strong class="num">{moedaCurta(ultimo.empenhado)}</strong></div>
          <div><span>Pago</span><strong class="num pago">{moedaCurta(ultimo.realizado)}</strong></div>
        </aside>
      </section>
    )}

    <section class="local" aria-labelledby="local-titulo">
      <div>
        <span class="sobretitulo verde">Além do governo federal</span>
        <h2 id="local-titulo">E a sua cidade? E o seu estado?</h2>
        <p>Quanto entra, de onde vem, onde é gasto e se sobrou ou faltou, para cada prefeitura e cada governo estadual.</p>
      </div>
      <nav aria-label="Cidades, estados e mapa">
        <a href="/cidades"><strong>Sua cidade</strong><span>5.570 prefeituras e o DF</span></a>
        <a href="/estados"><strong>Seu estado</strong><span>os 26 governos estaduais e o DF</span></a>
        <a href="/mapa/"><strong>No mapa</strong><span>o país inteiro, ano a ano</span></a>
      </nav>
    </section>

    {cem.length > 1 && (
      <section class="cem so-largo">
        <div class="cem-topo">
          <h2>De cada R$ 100 do orçamento</h2>
          <span class="muted">dotação de {anoBase}, sem o refinanciamento da <a href="/divida">dívida</a></span>
        </div>
        <div class="cem-barra" role="img" aria-label="Distribuição de cada 100 reais por área">
          {cem.map((c) => <a href={c.href} style={`flex: ${c.pct} 1 0; background: ${c.cor}`} aria-label={`${c.rotulo}: ${fmtPct(c.pct)}%`}></a>)}
        </div>
        <div class="cem-itens">
          {cem.map((c) => (
            <a href={c.href}>
              <strong class:list={["serifa", { marca: c.destaque }]}>R$ {fmtPct(c.pct)}</strong>
              <span>{c.rotulo}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {mapaCelular.length > 0 && (
      <section class="mapa-celular so-celular">
        <h2>Para onde vai</h2>
        <span class="muted pequeno">dotação de {anoBase} por área, sem o refinanciamento da dívida</span>
        <div class="mapa" role="img" aria-label="Mapa de blocos por área">
          {mapaCelular.map((f) => (
            <div class:list={["faixa", f.tipo]} style={`flex: ${f.peso} 1 0`}>
              {f.itens.map((b) => (
                <a href={b.href} class:list={{ claro: b.claro }} style={`flex: ${b.pct} 1 0; background: ${b.cor}`}>
                  <strong>{b.nome}</strong>
                  <span class="serifa">{fmtPct(b.pct)}%</span>
                </a>
              ))}
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="areas so-celular">
      <h2>Comece por uma área</h2>
      {areas.map((a) => (
        <a href={explorer(`f=funcao:${a.cod}&por=subfuncao`)}>
          <span>{a.nome}</span><strong class="serifa num">{moedaCurta(valorFuncao(a.cod))}</strong>
        </a>
      ))}
      <a class="todas" href={explorer("por=funcao")}>Ver todas as áreas →</a>
    </section>

    <section class="chamadas so-largo">
      <a href={explorer()}>
        <span class="sobretitulo verde">Explorer</span>
        <strong>Divida o orçamento por órgão, área, programa ou tipo de gasto</strong>
        <span>Do total até cada ação, com a evolução desde 2014.</span>
      </a>
      <a href="/orgaos">
        <span class="sobretitulo verde">Órgãos</span>
        <strong>O orçamento de cada ministério, em uma página</strong>
        <span>Quanto recebe, quanto executa e para onde vai.</span>
      </a>
      <a href="/glossario">
        <span class="sobretitulo verde">Glossário</span>
        <strong>Empenho, dotação, restos a pagar: o que significam</strong>
        <span>Palavra do dia: <em>{palavra.termo.toLowerCase()}</em>.</span>
      </a>
    </section>

    <a class="do-zero so-celular" href="/aprenda"><span class="sobretitulo verde">Aprenda</span><strong class="serifa">Entenda o orçamento do zero, em lições curtas →</strong></a>

    <section class="palavra so-celular">
      <span class="sobretitulo verde">Palavra do dia</span>
      <strong class="serifa">{palavra.termo}</strong>
      <p>{palavra.definicao}</p>
    </section>

    <section class="como so-largo" id="como-funciona">
      <div>
        <h2>Como o dinheiro anda</h2>
        <p>Todo gasto passa por quatro fases. No Explorer, cada valor mostra em que ponto desse caminho está.</p>
        <a class="link-forte" href="/aprenda">Entenda o orçamento do zero, em lições curtas →</a>
      </div>
      <ol>
        <li><span class="serifa">1</span><span><strong>Dotação.</strong> O valor autorizado na Lei Orçamentária.</span></li>
        <li><span class="serifa">2</span><span><strong>Empenho.</strong> O dinheiro é reservado para uma despesa.</span></li>
        <li><span class="serifa">3</span><span><strong>Liquidação.</strong> Confirma que o serviço foi entregue.</span></li>
        <li><span class="serifa">4</span><span><strong>Pagamento.</strong> O dinheiro sai do Tesouro.</span></li>
      </ol>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding: 60px 0 44px; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px;
  }
  .hero-texto { grid-column: span 8; display: flex; flex-direction: column; gap: 24px; }
  .hero h1 { font-size: 80px; line-height: 0.98; letter-spacing: -0.025em; }
  .lede { margin: 0; font-size: 20px; line-height: 1.6; color: var(--texto-2); max-width: 640px; }
  .acoes { display: flex; gap: 20px; align-items: center; }
  .hero-numeros {
    grid-column: span 4; border-left: 1px solid var(--regra); padding-left: 24px;
    display: flex; flex-direction: column; gap: 22px; justify-content: flex-end;
  }
  .hero-numeros div { display: flex; flex-direction: column; }
  .hero-numeros span { font-size: 13px; color: var(--texto-3); }
  .hero-numeros strong { font-family: var(--serifa); font-size: 44px; font-weight: 700; }
  .hero-numeros .pago { color: var(--verde); }

  .cem { padding: 30px 0 44px; border-top: 2px solid var(--tinta); display: flex; flex-direction: column; gap: 18px; }
  .cem-topo { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .cem-topo h2 { font-size: 38px; }
  .cem-topo span { font-size: 13px; }
  .cem-barra { display: flex; height: 72px; gap: 2px; }
  .cem-barra a:hover { outline: 2px solid var(--tinta); outline-offset: -2px; }
  .cem-itens { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; font-size: 14px; line-height: 1.4; }
  .cem-itens a { display: flex; flex-direction: column; color: var(--tinta); text-decoration: none; }
  .cem-itens a:hover span { text-decoration: underline; }
  .cem-itens strong { font-size: 32px; align-self: flex-start; }
  .cem-itens span { color: var(--texto-2); }

  .local {
    padding: 28px 0; border-top: 2px solid var(--tinta);
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 32px; align-items: center;
  }
  .local > div { grid-column: span 5; display: flex; flex-direction: column; gap: 8px; }
  .local h2 { font-size: 32px; line-height: 1.1; }
  .local p { margin: 0; font-size: 16px; line-height: 1.55; color: var(--texto-2); }
  .local nav { grid-column: span 7; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .local nav a {
    display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border: 1px solid var(--tinta);
    color: var(--tinta); text-decoration: none;
  }
  .local nav a:hover { background: var(--marca-texto-fundo); }
  .local nav strong { font-family: var(--serifa); font-size: 22px; }
  .local nav strong::after { content: " →"; }
  .local nav span { font-size: 13px; color: var(--texto-3); }
  @media (max-width: 900px) {
    .local { display: flex; flex-direction: column; align-items: stretch; gap: 18px; padding: 24px 0; }
    .local h2 { font-size: 26px; }
  }
  @media (max-width: 640px) {
    .local nav { grid-template-columns: 1fr; gap: 10px; }
    .local nav a { padding: 14px 16px; }
  }

  .chamadas {
    padding: 30px 0 40px; border-top: 1px solid var(--regra);
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px;
  }
  .chamadas a { display: flex; flex-direction: column; gap: 10px; color: var(--tinta); text-decoration: none; }
  .chamadas strong { font-family: var(--serifa); font-size: 26px; line-height: 1.15; }
  .chamadas a:hover strong { text-decoration: underline; text-decoration-thickness: 2px; }
  .chamadas a > span:last-child { font-size: 15px; color: var(--texto-2); line-height: 1.5; }

  .como {
    padding: 30px 0; border-top: 1px solid var(--regra);
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px;
  }
  .como > div { grid-column: span 5; display: flex; flex-direction: column; gap: 12px; }
  .como h2 { font-size: 32px; }
  .como p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--texto-2); }
  .como ol { grid-column: span 7; margin: 0; padding: 0; list-style: none; }
  .como li { display: flex; gap: 20px; padding: 14px 0; border-bottom: 1px solid var(--regra); }
  .como li:last-child { border-bottom: 0; }
  .como li > span:first-child { font-size: 24px; color: var(--verde); width: 32px; flex: none; }

  /* celular */
  .pequeno { font-size: 12px; }
  .mapa-celular { border-top: 2px solid var(--tinta); padding: 28px 0; display: flex; flex-direction: column; gap: 12px; }
  .mapa-celular h2, .areas h2 { font-size: 28px; letter-spacing: -0.01em; }
  .mapa { height: 360px; display: flex; flex-direction: column; gap: 2px; }
  .faixa { display: flex; gap: 2px; min-height: 0; }
  .mapa a {
    min-width: 0; padding: 10px 12px; display: flex; flex-direction: column; justify-content: space-between;
    color: #ffffff; text-decoration: none; overflow: hidden;
  }
  .faixa.linha a { flex-direction: row; justify-content: space-between; align-items: flex-end; }
  .faixa.colunas a { flex-direction: column-reverse; }
  .mapa a.claro { color: var(--tinta); }
  .mapa strong { font-size: 12px; line-height: 1.2; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .faixa.linha strong { font-size: 15px; }
  .mapa .serifa { font-size: 20px; font-weight: 700; }
  .faixa.linha .serifa { font-size: 30px; line-height: 1; }
  .areas { border-top: 2px solid var(--tinta); padding: 22px 0; display: flex; flex-direction: column; }
  .areas h2 { margin-bottom: 8px; font-size: 26px; }
  .areas a {
    display: flex; justify-content: space-between; align-items: baseline; padding: 14px 0;
    border-bottom: 1px solid var(--regra-leve); color: var(--tinta); text-decoration: none; font-weight: 600;
  }
  .areas strong { font-size: 22px; }
  .areas a.todas { border-bottom: 0; color: var(--verde); }
  .do-zero { border-top: 1px solid var(--regra); padding: 18px 0; display: flex; flex-direction: column; gap: 6px; color: var(--tinta); text-decoration: none; }
  .do-zero strong { font-size: 20px; line-height: 1.25; }
  .palavra { border-top: 1px solid var(--regra); padding: 22px 0; display: flex; flex-direction: column; gap: 8px; }
  .palavra strong { font-size: 26px; }
  .palavra p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--texto-2); }

  @media (max-width: 1100px) {
    .hero h1 { font-size: 60px; }
    .cem-itens { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .hero { display: flex; flex-direction: column; gap: 24px; padding: 28px 0 24px; }
    .hero-texto { gap: 16px; }
    .hero h1 { font-size: 40px; line-height: 1.02; }
    .lede { font-size: 16px; line-height: 1.55; }
    .acoes .botao { width: 100%; justify-content: center; }
    .hero-numeros {
      border-left: 0; padding: 0; border-top: 2px solid var(--tinta); border-bottom: 1px solid var(--regra);
      flex-direction: row; gap: 0; margin: 0 calc(-1 * var(--margem)); padding: 0 var(--margem);
    }
    .hero-numeros div { flex: 1; padding: 12px 8px; border-right: 1px solid var(--regra); }
    .hero-numeros div:first-child { padding-left: 0; }
    .hero-numeros div:last-child { border-right: 0; padding-right: 0; }
    .hero-numeros span { font-size: 11px; }
    .hero-numeros strong { font-size: 22px; }
  }
</style>
