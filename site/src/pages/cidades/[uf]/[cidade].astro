---
import Base from "../../../layouts/Base.astro";
import AnoEmAndamento from "../../../components/gasto/AnoEmAndamento.astro";
import Avisos from "../../../components/gasto/Avisos.astro";
import CapagNota from "../../../components/gasto/CapagNota.astro";
import DividaEstado from "../../../components/gasto/DividaEstado.astro";
import PessoalResultado from "../../../components/gasto/PessoalResultado.astro";
import PrevidenciaServidores from "../../../components/gasto/PrevidenciaServidores.astro";
import GastoEstadualAqui from "../../../components/gasto/GastoEstadualAqui.astro";
import GastoFederalAqui from "../../../components/gasto/GastoFederalAqui.astro";
import SaiuVoltou from "../../../components/gasto/SaiuVoltou.astro";
import DividaAtivaCidade from "../../../components/gasto/DividaAtivaCidade.astro";
import BndesCidade from "../../../components/gasto/BndesCidade.astro";
import SupersalariosCidade from "../../../components/gasto/SupersalariosCidade.astro";
import EducacaoResultado from "../../../components/gasto/EducacaoResultado.astro";
import SaudeResultado from "../../../components/gasto/SaudeResultado.astro";
import SaneamentoResultado from "../../../components/gasto/SaneamentoResultado.astro";
import SegurancaEstado from "../../../components/gasto/SegurancaEstado.astro";
import IrMoradores from "../../../components/gasto/IrMoradores.astro";
import EmendasResultado from "../../../components/gasto/EmendasResultado.astro";
import ContratosResultado from "../../../components/gasto/ContratosResultado.astro";
import PagamentosCidade from "../../../components/gasto/PagamentosCidade.astro";
import EscolasCidade from "../../../components/gasto/EscolasCidade.astro";
import SaudeUnidades from "../../../components/gasto/SaudeUnidades.astro";
import ObrasParadasCidade from "../../../components/obras/ObrasParadasCidade.astro";
import NestaPagina, { type GrupoDaPagina } from "../../../components/NestaPagina.astro";
import { moedaExtenso } from "../../../lib/formato";
import { caminhoCidade, caminhoEstado, deUf, docCidades, habitantes, NOMES_UF, porPessoa, type Cidade } from "../../../lib/cidades";
import { anosDe, fichaDe, pacoteDe } from "../../../lib/ficha";
import { emendasPorAno } from "../../../lib/indicadores";
import { areasHtml, contasHtml, fraseHtml, numerosHtml, type Contexto } from "../../../lib/ficha-html";
import type { BaseDaPagina } from "../../../lib/troca-de-ano";
import "../../../styles/ficha.css";

export function getStaticPaths() {
  return (docCidades?.cidades ?? []).map((c) => {
    const [, , uf, cidade] = caminhoCidade(c).split("/");
    return { params: { uf, cidade }, props: { c } };
  });
}

const { c } = Astro.props as { c: Cidade };
const doc = docCidades!;
const temDados = c.ano !== null && !!c.total;
const nomeUf = NOMES_UF[c.uf] ?? c.uf;
const ehDF = c.ibge === 53;
const quem = ehDF ? "o Governo do Distrito Federal" : `a prefeitura de ${c.nome}`;

const [emp] = c.total ?? [0, 0];
const perCapita = temDados ? emp / c.pop : 0;
// "cidades de 5 a 10 mil habitantes", mas "cidades com até 5 mil" e "cidades com mais de 500 mil".
const rotuloFaixa = c.faixa !== undefined && !ehDF ? doc.faixas[c.faixa].replace(/habitantes$/, "moradores") : null;
const faixa = rotuloFaixa && /^(até|mais)\b/.test(rotuloFaixa) ? `com ${rotuloFaixa}` : rotuloFaixa;

// As partes que mudam com o ano: montadas aqui com o ano mais recente e, no navegador, com o ano escolhido.
const onde = ehDF ? "no Distrito Federal" : `em ${c.nome}`;
const destaques = [{ cod: "10", titulo: "Saúde" }, { cod: "12", titulo: "Educação" }];
const ficha = temDados ? await fichaDe(c, "mun", c.ano!) : null;
const pacote = temDados ? await pacoteDe("mun", c.ano!) : null;
const emendas = emendasPorAno(c);
const ctx: Contexto | null = ficha && pacote ? { ano: c.ano!, esfera: "mun", ibge: c.ibge, nome: c.nome, uf: c.uf, quem, onde, destaques, emendas, ficha, pacote } : null;
const anos = anosDe(c);
const base: BaseDaPagina | null = ctx
  ? { ibge: c.ibge, nome: c.nome, uf: c.uf, esfera: "mun", quem, onde, destaques, anos, padrao: c.ano!, grupo: c.uf.toLowerCase(), emendas }
  : null;
// A lista "Nesta página": os grupos na ordem em que aparecem; um item sem conteúdo some no navegador.
const SUMARIO: GrupoDaPagina[] = [
  { id: "em-que-gasta", n: 1, titulo: "Em que gasta", itens: [["areas", "Para onde vai o dinheiro"], ["com-o-que", "Com o quê gasta"], ["contratos", "Os contratos"], ["pagamentos", "Para quem pagou"]] },
  { id: "contas", n: 2, titulo: "As contas fecham", itens: [["receitas", "De onde vem o dinheiro, o que sobrou e o que deve"], ["divida", "A dívida da prefeitura"], ["pessoal", "O gasto com pessoal"], ["previdencia", "A aposentadoria dos servidores"], ["capag", "A nota do Tesouro"], ["ano-atual", "O ano em andamento"]] },
  { id: "chega-e-sai", n: 3, titulo: "O que chega e o que sai daqui", itens: [["saiu-voltou", "Saiu daqui, voltou"], ["beneficios", "Aposentadorias e benefícios"], ["ir", "Imposto de renda dos moradores"], ["emendas", "Emendas parlamentares"], ["estado-aqui", "O que o governo do estado gastou aqui"], ["federal-aqui", "O que o governo federal gastou aqui"], ["obras-paradas", "Obras federais paradas"], ["divida-ativa", "O que se deve ao governo federal"], ["bndes", "Empréstimos do BNDES"], ["teto-fpm", "Salários acima do teto e o FPM"]] },
  { id: "como-esta", n: 4, titulo: "Como está a cidade", itens: [["educacao", "Educação: gasto por aluno e nota das escolas"], ["escolas", "As escolas da prefeitura"], ["saude", "Saúde: mortalidade infantil"], ["postos", "Os postos e hospitais"], ["seguranca", "Segurança: homicídios"], ["saneamento", "Saneamento: água e esgoto"]] },
];
const descricao = temDados
  ? `Quanto ${quem} gastou em ${c.ano}: ${moedaExtenso(emp)}, ${porPessoa(perCapita)} por morador, por área (saúde, educação…).`
  : `Gastos de ${c.nome} (${c.uf}).`;
---

<Base title={`${c.nome} (${c.uf}) · Orçamento Brasileiro`} description={descricao}>
  <div class="wrap">
    <nav aria-label="Caminho" class="caminho">
      <a href="/cidades">Cidades</a><span aria-hidden="true">/</span><a href={caminhoEstado(c.uf)}>{nomeUf}</a><span aria-hidden="true">/</span><span>{c.nome}</span>
    </nav>

    <section class="cabeca">
      <div>
        <span class="sobretitulo">{ehDF ? "Distrito Federal" : `Município · ${nomeUf}`} · {habitantes(c.pop)}</span>
        <h1>{c.nome}</h1>
        {ctx ? (
          <>
            <div class="topo-acoes">
              {anos.length > 1 && (
                <label class="escolha-ano">Ano das contas
                  <select id="ano-ficha">{anos.map((a) => <option value={a} selected={a === c.ano}>{a}</option>)}</select>
                  <small>{anos.at(-1)} a {anos[0]}</small>
                </label>
              )}
              {!ehDF && <a class="comparar-com" href={`/comparar?a=${c.ibge}`}><span aria-hidden="true">⇄</span> Comparar com outra cidade</a>}
            </div>
            <div class="ficha" data-parte="frase" set:html={fraseHtml(ctx)} />
          </>
        ) : (
          <p>{quem[0].toUpperCase() + quem.slice(1)} não entregou ao Tesouro a prestação de contas anual de nenhum ano entre {doc.anos[0]} e {doc.anos.at(-1)}.</p>
        )}
      </div>
    </section>

    {ctx && <div class="ficha" data-parte="numeros" set:html={numerosHtml(ctx)} />}
    {ctx && <p class="aviso-ano" id="aviso-ano" hidden></p>}
    {ctx && <Avisos ibge={c.ibge} esfera={ehDF ? "uf" : "mun"} quem={quem} />}

    {ctx && <NestaPagina grupos={SUMARIO} />}

    {ctx && <p class="grupo-pagina" id="em-que-gasta" data-grupo="em-que-gasta">1 · Em que gasta</p>}
    {ctx && <div class="ficha" id="areas" data-parte="areas" set:html={areasHtml(ctx)} />}
    {ctx && <div class="ficha" id="com-o-que" data-parte="natureza" set:html={contasHtml(ctx, "natureza")} />}
    {temDados && !ehDF && <div id="contratos" data-so-padrao="os contratos"><ContratosResultado cidade={c} quem={quem} /></div>}
    {temDados && !ehDF && <div id="pagamentos" data-so-padrao="para quem a prefeitura pagou"><PagamentosCidade cidade={c} quem={quem} /></div>}

    {ctx && <p class="grupo-pagina" id="contas" data-grupo="contas">2 · As contas fecham</p>}
    {ctx && <div class="ficha" id="receitas" data-parte="receitas" set:html={contasHtml(ctx, "receitas")} />}
    {!ehDF && <div id="divida" data-so-padrao="a dívida da prefeitura"><DividaEstado ibge={c.ibge} esfera="mun" quem={quem} ano={c.ano} grupo={faixa ? "das cidades parecidas" : "das prefeituras"} /></div>}
    {!ehDF && <div id="pessoal" data-so-padrao="o gasto com pessoal"><PessoalResultado ibge={c.ibge} esfera="mun" quem={quem} ano={c.ano} grupo={faixa ? "das cidades parecidas" : null} /></div>}
    {!ehDF && <div id="previdencia" data-so-padrao="a aposentadoria dos servidores"><PrevidenciaServidores ibge={c.ibge} esfera="mun" quem={quem} grupo={faixa ? "das cidades parecidas" : null} /></div>}
    {!ehDF && <div id="capag"><CapagNota ente={c} esfera="mun" quem={quem} grupo={faixa ? "das cidades parecidas" : null} /></div>}
    {temDados && <div id="ano-atual"><AnoEmAndamento ente={c} esfera="mun" quem={quem} /></div>}

    {ctx && <p class="grupo-pagina" id="chega-e-sai" data-grupo="chega-e-sai">3 · O que chega e o que sai daqui</p>}
    <div id="saiu-voltou" data-so-padrao="o saiu daqui, voltou"><SaiuVoltou esfera="mun" chave={String(c.ibge)} deOnde={ehDF ? "do Distrito Federal" : `de ${c.nome}`} onde={onde} /></div>
    {ctx && <div class="ficha" id="beneficios" data-parte="inss" set:html={contasHtml(ctx, "inss")} />}
    {temDados && <div id="ir" data-so-padrao="o imposto de renda dos moradores"><IrMoradores cidade={c} deOnde={ehDF ? "do Distrito Federal" : `de ${c.nome}`} grupo={!ehDF && faixa ? "das cidades parecidas" : null} /></div>}
    {temDados && <div id="emendas" data-so-padrao="as emendas parlamentares"><EmendasResultado ente={c} esfera="mun" paraOnde={ehDF ? "para o Distrito Federal" : `para ${c.nome}`} grupo={!ehDF && faixa ? "das cidades parecidas" : null} /></div>}
    {!ehDF && <div id="estado-aqui" data-so-padrao="o gasto do governo do estado aqui"><GastoEstadualAqui cidade={c} /></div>}
    <div id="federal-aqui" data-so-padrao="o gasto do governo federal aqui"><GastoFederalAqui cidade={c} /></div>
    <div id="obras-paradas" data-so-padrao="as obras federais paradas"><ObrasParadasCidade cidade={c} /></div>
    <div id="divida-ativa" data-so-padrao="a dívida ativa da União"><DividaAtivaCidade cidade={c} /></div>
    <div id="bndes" data-so-padrao="os empréstimos do BNDES"><BndesCidade cidade={c} /></div>
    {!ehDF && <div id="teto-fpm" data-so-padrao="os salários acima do teto e o FPM"><SupersalariosCidade cidade={c} /></div>}

    {temDados && !ehDF && <p class="grupo-pagina" id="como-esta" data-grupo="como-esta">4 · Como está a cidade</p>}
    {temDados && !ehDF && <div id="educacao" data-so-padrao="a nota das escolas (Ideb)"><EducacaoResultado cidade={c} faixa={faixa} /></div>}
    {temDados && !ehDF && <div id="escolas" data-so-padrao="as escolas da prefeitura"><EscolasCidade cidade={c} quem={quem} /></div>}
    {temDados && !ehDF && <div id="saude" data-so-padrao="a mortalidade infantil"><SaudeResultado ente={c} esfera="mun" quem={quem} grupo={faixa ? "das cidades parecidas" : null} onde={onde} /></div>}
    {temDados && !ehDF && <div id="postos" data-so-padrao="os postos e hospitais"><SaudeUnidades cidade={c} quem={quem} /></div>}
    {temDados && !ehDF && <div id="seguranca" data-so-padrao="os homicídios"><SegurancaEstado estado={c} esfera="mun" quem={quem} onde={onde} grupo={faixa ? "das cidades parecidas" : "das cidades"} /></div>}
    {temDados && !ehDF && <div id="saneamento" data-so-padrao="a água e o esgoto"><SaneamentoResultado ente={c} esfera="mun" quem={quem} grupo={faixa ? "das cidades parecidas" : null} onde={onde} /></div>}

    {!ehDF && (
      <p class="unidade">
        Escolas estaduais, hospitais regionais e a polícia são do governo do estado:
        veja <a href={caminhoEstado(c.uf)}>o gasto {deUf(c.uf)}</a>.
      </p>
    )}

    <p class="nota">
      Fonte: Declaração de Contas Anuais (DCA, Anexo I-E) entregue {ehDF ? "pelo GDF" : "pela prefeitura"} ao Tesouro Nacional
      pelo SICONFI. Os números são os declarados pelo próprio ente. Empenhado é o gasto comprometido no ano, incluindo a Câmara
      Municipal; não inclui despesas intraorçamentárias. Mediana calculada entre as cidades do mesmo porte que entregaram a DCA de <span data-ano-texto>{c.ano}</span>.
      {ehDF && " O DF acumula funções de estado e de município e por isso não é comparado com outras cidades."}
    </p>
  </div>
  {base && <script type="application/json" id="ficha-base" set:html={JSON.stringify(base).replace(/</g, "\\u003c")} />}
</Base>

<script>
  import { iniciarTrocaDeAno } from "../../../lib/troca-de-ano";
  iniciarTrocaDeAno();

</script>

<style>
  .caminho { padding: 14px 0; border-bottom: 1px solid var(--regra); font-size: 14px; display: flex; gap: 10px; flex-wrap: wrap; }
  .caminho span[aria-hidden] { color: var(--texto-4); }
  .cabeca { padding: 40px 0 32px; }
  .cabeca > div { display: flex; flex-direction: column; gap: 14px; max-width: 860px; }
  .cabeca h1 { font-size: 68px; line-height: 0.98; letter-spacing: -0.025em; }
  .cabeca p { margin: 0; font-size: 20px; line-height: 1.55; color: var(--texto-2); }
  .cabeca p strong { color: var(--tinta); }


  .unidade { border-top: 1px solid var(--regra); padding: 20px 0; margin: 0; max-width: 860px; font-size: 16px; line-height: 1.6; color: var(--texto-2); }
  .nota { margin: 0 0 24px; font-size: 12px; line-height: 1.5; color: var(--texto-3); max-width: 860px; }

  @media (max-width: 900px) {
    .cabeca { padding: 28px 0 24px; }
    .cabeca h1 { font-size: 40px; }
    .cabeca p { font-size: 17px; }
  }
</style>
