---
import Base from "../../../layouts/Base.astro";
import AnoEmAndamento from "../../../components/gasto/AnoEmAndamento.astro";
import CapagNota from "../../../components/gasto/CapagNota.astro";
import GastoEstadualAqui from "../../../components/gasto/GastoEstadualAqui.astro";
import EducacaoResultado from "../../../components/gasto/EducacaoResultado.astro";
import SaudeResultado from "../../../components/gasto/SaudeResultado.astro";
import SaneamentoResultado from "../../../components/gasto/SaneamentoResultado.astro";
import SegurancaEstado from "../../../components/gasto/SegurancaEstado.astro";
import IrMoradores from "../../../components/gasto/IrMoradores.astro";
import { moedaExtenso } from "../../../lib/formato";
import { caminhoCidade, caminhoEstado, deUf, docCidades, habitantes, NOMES_UF, porPessoa, type Cidade } from "../../../lib/cidades";
import { anosDe, fichaDe, pacoteDe } from "../../../lib/ficha";
import { areasHtml, contasHtml, fraseHtml, numerosHtml, type Contexto } from "../../../lib/ficha-html";
import type { BaseDaPagina } from "../../../lib/troca-de-ano";
import "../../../styles/ficha.css";

export function getStaticPaths() {
  return (docCidades?.cidades ?? []).map((c) => {
    const [, , uf, cidade] = caminhoCidade(c).split("/");
    return { params: { uf, cidade }, props: { c } };
  });
}

const { c } = Astro.props as { c: Cidade };
const doc = docCidades!;
const temDados = c.ano !== null && !!c.total;
const nomeUf = NOMES_UF[c.uf] ?? c.uf;
const ehDF = c.ibge === 53;
const quem = ehDF ? "o Governo do Distrito Federal" : `a prefeitura de ${c.nome}`;

const [emp] = c.total ?? [0, 0];
const perCapita = temDados ? emp / c.pop : 0;
// "cidades de 5 a 10 mil habitantes", mas "cidades com até 5 mil" e "cidades com mais de 500 mil".
const rotuloFaixa = c.faixa !== undefined && !ehDF ? doc.faixas[c.faixa] : null;
const faixa = rotuloFaixa && /^(até|mais)\b/.test(rotuloFaixa) ? `com ${rotuloFaixa}` : rotuloFaixa;

// As partes que mudam com o ano: montadas aqui com o ano mais recente e, no navegador, com o ano escolhido.
const onde = ehDF ? "no Distrito Federal" : `em ${c.nome}`;
const destaques = [{ cod: "10", titulo: "Saúde" }, { cod: "12", titulo: "Educação" }];
const ficha = temDados ? await fichaDe(c, "mun", c.ano!) : null;
const pacote = temDados ? pacoteDe("mun", c.ano!) : null;
const ctx: Contexto | null = ficha && pacote ? { ano: c.ano!, esfera: "mun", ibge: c.ibge, nome: c.nome, uf: c.uf, quem, onde, destaques, ficha, pacote } : null;
const anos = anosDe(c);
const base: BaseDaPagina | null = ctx
  ? { ibge: c.ibge, nome: c.nome, uf: c.uf, esfera: "mun", quem, onde, destaques, anos, padrao: c.ano!, grupo: c.uf.toLowerCase() }
  : null;
// A lista "Nesta página": os grupos na ordem em que aparecem; um item sem conteúdo some no navegador.
const SUMARIO: { id: string; n: number; titulo: string; itens: [string, string][] }[] = [
  { id: "em-que-gasta", n: 1, titulo: "Em que gasta", itens: [["areas", "Para onde vai o dinheiro"], ["com-o-que", "Com o quê gasta"]] },
  { id: "contas", n: 2, titulo: "As contas fecham", itens: [["receitas", "De onde vem o dinheiro, o que sobrou e o que deve"], ["capag", "A nota do Tesouro"], ["ano-atual", "O ano em andamento"]] },
  { id: "chega-e-sai", n: 3, titulo: "O que chega e o que sai daqui", itens: [["beneficios", "Aposentadorias e benefícios"], ["ir", "Imposto de renda dos moradores"], ["estado-aqui", "O que o governo do estado gastou aqui"]] },
  { id: "como-esta", n: 4, titulo: "Como está a cidade", itens: [["educacao", "Educação: gasto por aluno e nota das escolas"], ["saude", "Saúde: mortalidade infantil"], ["seguranca", "Segurança: homicídios"], ["saneamento", "Saneamento: água e esgoto"]] },
];
const descricao = temDados
  ? `Quanto ${quem} gastou em ${c.ano}: ${moedaExtenso(emp)}, ${porPessoa(perCapita)} por habitante, por área (saúde, educação…).`
  : `Gastos de ${c.nome} (${c.uf}).`;
---

<Base title={`${c.nome} (${c.uf}) · Orçamento Brasileiro`} description={descricao}>
  <div class="wrap">
    <nav aria-label="Caminho" class="caminho">
      <a href="/cidades">Cidades</a><span aria-hidden="true">/</span><a href={caminhoEstado(c.uf)}>{nomeUf}</a><span aria-hidden="true">/</span><span>{c.nome}</span>
    </nav>

    <section class="cabeca">
      <div>
        <span class="sobretitulo">{ehDF ? "Distrito Federal" : `Município · ${nomeUf}`} · {habitantes(c.pop)}</span>
        <h1>{c.nome}</h1>
        {ctx ? (
          <>
            {anos.length > 1 && (
              <label class="escolha-ano">Ano das contas
                <select id="ano-ficha">{anos.map((a) => <option value={a} selected={a === c.ano}>{a}</option>)}</select>
                <small>{anos.at(-1)} a {anos[0]}</small>
              </label>
            )}
            <div class="ficha" data-parte="frase" set:html={fraseHtml(ctx)} />
          </>
        ) : (
          <p>{quem[0].toUpperCase() + quem.slice(1)} não entregou ao Tesouro a prestação de contas anual de nenhum ano entre {doc.anos[0]} e {doc.anos.at(-1)}.</p>
        )}
      </div>
    </section>

    {ctx && <div class="ficha" data-parte="numeros" set:html={numerosHtml(ctx)} />}
    {ctx && <p class="aviso-ano" id="aviso-ano" hidden></p>}

    {ctx && (
      <nav class="nesta-pagina" aria-labelledby="nesta-pagina">
        <h2 id="nesta-pagina">Nesta página</h2>
        <div class="grupos">
          {SUMARIO.map((g) => (
            <div class="grupo" data-grupo={g.id}>
              <a class="titulo-grupo" href={`#${g.id}`}>{g.n}. {g.titulo}</a>
              <ul>{g.itens.map(([id, nome]) => <li><a href={`#${id}`}>{nome}</a></li>)}</ul>
            </div>
          ))}
        </div>
      </nav>
    )}

    {ctx && <p class="grupo-pagina" id="em-que-gasta" data-grupo="em-que-gasta">1 · Em que gasta</p>}
    {ctx && <div class="ficha" id="areas" data-parte="areas" set:html={areasHtml(ctx)} />}
    {ctx && <div class="ficha" id="com-o-que" data-parte="natureza" set:html={contasHtml(ctx, "natureza")} />}

    {ctx && <p class="grupo-pagina" id="contas" data-grupo="contas">2 · As contas fecham</p>}
    {ctx && <div class="ficha" id="receitas" data-parte="receitas" set:html={contasHtml(ctx, "receitas")} />}
    {!ehDF && <div id="capag"><CapagNota ente={c} esfera="mun" quem={quem} grupo={faixa ? `das cidades ${faixa}` : null} /></div>}
    {temDados && <div id="ano-atual"><AnoEmAndamento ente={c} esfera="mun" quem={quem} /></div>}

    {ctx && <p class="grupo-pagina" id="chega-e-sai" data-grupo="chega-e-sai">3 · O que chega e o que sai daqui</p>}
    {ctx && <div class="ficha" id="beneficios" data-parte="inss" set:html={contasHtml(ctx, "inss")} />}
    {temDados && <div id="ir" data-so-padrao="o imposto de renda dos moradores"><IrMoradores cidade={c} deOnde={ehDF ? "do Distrito Federal" : `de ${c.nome}`} grupo={!ehDF && faixa ? `das cidades ${faixa}` : null} /></div>}
    {!ehDF && <div id="estado-aqui" data-so-padrao="o gasto do governo do estado aqui"><GastoEstadualAqui cidade={c} /></div>}

    {temDados && !ehDF && <p class="grupo-pagina" id="como-esta" data-grupo="como-esta">4 · Como está a cidade</p>}
    {temDados && !ehDF && <div id="educacao" data-so-padrao="a nota das escolas (Ideb)"><EducacaoResultado cidade={c} faixa={faixa} /></div>}
    {temDados && !ehDF && <div id="saude" data-so-padrao="a mortalidade infantil"><SaudeResultado ente={c} esfera="mun" quem={quem} grupo={faixa ? `das cidades ${faixa}` : null} onde={onde} /></div>}
    {temDados && !ehDF && <div id="seguranca" data-so-padrao="os homicídios"><SegurancaEstado estado={c} esfera="mun" quem={quem} onde={onde} grupo={faixa ? `das cidades ${faixa}` : "das cidades"} /></div>}
    {temDados && !ehDF && <div id="saneamento" data-so-padrao="a água e o esgoto"><SaneamentoResultado ente={c} esfera="mun" quem={quem} grupo={faixa ? `das cidades ${faixa}` : null} onde={onde} /></div>}

    <section class="unidade">
      <h2>E a escola ou o posto de saúde do meu bairro?</h2>
      <p>
        A prestação de contas das prefeituras para em áreas como "Ensino Fundamental" ou "Atenção Básica". Salários,
        merenda e contratos são pagos pela secretaria, não por escola ou posto, então o gasto de cada unidade não vem pronto.
        Alguns pedaços existem em outras bases: o que o SUS paga a cada hospital (DATASUS, pelo código CNES) e o
        dinheiro federal que vai direto para cada escola (PDDE). Essas bases ainda não estão neste site.
      </p>
      {!ehDF && (
        <p>
          Escolas estaduais, hospitais regionais e a polícia são do governo do estado:
          veja <a href={caminhoEstado(c.uf)}>o gasto {deUf(c.uf)}</a>.
        </p>
      )}
    </section>

    <p class="nota">
      Fonte: Declaração de Contas Anuais (DCA, Anexo I-E) entregue por {ehDF ? "o GDF" : "a prefeitura"} ao Tesouro Nacional
      pelo SICONFI. Os números são os declarados pelo próprio ente. Empenhado é o gasto comprometido no ano, incluindo a Câmara
      Municipal; não inclui despesas intraorçamentárias. Mediana calculada entre as cidades do mesmo porte que entregaram a DCA de <span data-ano-texto>{c.ano}</span>.
      {ehDF && " O DF acumula funções de estado e de município e por isso não é comparado com outras cidades."}
    </p>
  </div>
  {base && <script type="application/json" id="ficha-base" set:html={JSON.stringify(base).replace(/</g, "\\u003c")} />}
</Base>

<script>
  import { iniciarTrocaDeAno } from "../../../lib/troca-de-ano";
  iniciarTrocaDeAno();

  // "Nesta página": some o item cuja seção está vazia ou escondida (outro ano escolhido), e o
  // grupo inteiro, com o rótulo dele na página, quando não sobra nenhum item.
  const nav = document.querySelector<HTMLElement>(".nesta-pagina");
  // Só mexe quando muda: trocar `hidden` dispara o observador abaixo de novo.
  const esconder = (el: HTMLElement, sim: boolean) => { if (el.hidden !== sim) el.hidden = sim; };
  function atualizarSumario() {
    if (!nav) return;
    for (const grupo of nav.querySelectorAll<HTMLElement>(".grupo")) {
      let algum = false;
      for (const li of grupo.querySelectorAll<HTMLElement>("li")) {
        const alvo = document.getElementById(li.querySelector("a")!.hash.slice(1));
        const filhos = alvo ? [...alvo.children] as HTMLElement[] : [];
        const vazio = !alvo || !alvo.textContent?.trim() || !!alvo.closest("[hidden]") || (filhos.length > 0 && filhos.every((f) => f.hidden));
        esconder(li, vazio);
        algum ||= !vazio;
      }
      esconder(grupo, !algum);
      const rotulo = document.querySelector<HTMLElement>(`.grupo-pagina[data-grupo="${grupo.dataset.grupo}"]`);
      if (rotulo) esconder(rotulo, !algum);
    }
  }
  atualizarSumario();
  if (nav) new MutationObserver(atualizarSumario).observe(document.querySelector("main") ?? document.body, { subtree: true, attributes: true, attributeFilter: ["hidden"], childList: true });
</script>

<style>
  .caminho { padding: 14px 0; border-bottom: 1px solid var(--regra); font-size: 14px; display: flex; gap: 10px; flex-wrap: wrap; }
  .caminho span[aria-hidden] { color: var(--texto-4); }
  .cabeca { padding: 40px 0 32px; }
  .cabeca > div { display: flex; flex-direction: column; gap: 14px; max-width: 860px; }
  .cabeca h1 { font-size: 68px; line-height: 0.98; letter-spacing: -0.025em; }
  .cabeca p { margin: 0; font-size: 20px; line-height: 1.55; color: var(--texto-2); }
  .cabeca p strong { color: var(--tinta); }

  .nesta-pagina { border-top: 2px solid var(--tinta); border-bottom: 1px solid var(--regra); padding: 16px 0 20px; margin-top: 8px; display: flex; flex-direction: column; gap: 14px; }
  .nesta-pagina h2 { font-family: var(--sans); font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--texto-3); }
  .nesta-pagina .grupos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px 32px; }
  .nesta-pagina .grupo { display: flex; flex-direction: column; gap: 2px; }
  .nesta-pagina .titulo-grupo { font-family: var(--serifa); font-size: 19px; font-weight: 700; color: var(--tinta); text-decoration: none; padding-bottom: 4px; }
  .nesta-pagina ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .nesta-pagina li a { display: block; padding: 5px 0; font-size: 15px; line-height: 1.35; }
  .grupo-pagina { margin: 40px 0 0; padding-top: 10px; border-top: 4px solid var(--tinta); font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--verde); scroll-margin-top: 16px; }
  :global([id]) { scroll-margin-top: 16px; }

  .unidade { border-top: 1px solid var(--regra); padding: 28px 0; max-width: 860px; display: flex; flex-direction: column; gap: 10px; }
  .unidade h2 { font-size: 26px; }
  .unidade p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--texto-2); }
  .nota { margin: 0 0 24px; font-size: 12px; line-height: 1.5; color: var(--texto-3); max-width: 860px; }

  @media (max-width: 900px) {
    .nesta-pagina .grupos { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .nesta-pagina li a { padding: 8px 0 8px 16px; }
    .cabeca { padding: 28px 0 24px; }
    .cabeca h1 { font-size: 40px; }
    .cabeca p { font-size: 17px; }
  }
</style>
