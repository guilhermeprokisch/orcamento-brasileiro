  .legenda .cor { width: 14px; height: 14px; align-self: center; border: 1px solid rgba(0, 0, 0, 0.15); }
  .legenda .num { text-align: right; font-family: var(--serifa); font-size: 18px; font-weight: 700; white-space: nowrap; }
  .exemplos { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; border-top: 1px solid var(--regra); }
  .exemplos li { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 14px; align-items: baseline; padding: 10px 0; border-bottom: 1px solid var(--regra-leve); font-size: 14px; color: var(--texto-2); line-height: 1.45; }
  .exemplos strong { font-family: var(--serifa); font-size: 22px; font-weight: 700; color: var(--tinta); white-space: nowrap; }
  .legenda .num small { font-family: var(--sans, inherit); font-size: 14px; font-weight: 400; color: var(--texto-3); }
  .pilhas { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .pilhas li { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 12px; align-items: center; font-size: 14px; }
  .pilhas .rotulo { color: var(--texto-3); }
  .pilha { display: flex; height: 22px; }
  .pilha span { display: block; height: 100%; }
  .pilha.mini { height: 12px; min-width: 120px; }

  .orgaos { border-top: 2px solid var(--tinta); padding: 32px 0; display: flex; flex-direction: column; gap: 18px; scroll-margin-top: 12px; }
  .texto-largo { max-width: 760px; display: flex; flex-direction: column; gap: 12px; }
  .escolha { display: flex; gap: 8px; flex-wrap: wrap; }
  .escolha label { border: 1px solid var(--tinta); padding: 6px 14px; font-size: 15px; cursor: pointer; display: flex; gap: 6px; align-items: center; }
  .escolha label:has(input:checked) { background: var(--tinta); color: var(--papel); }
  .escolha input { accent-color: var(--verde); }
  .periodo { display: flex; flex-direction: column; gap: 28px; }
  .periodo[hidden] { display: none; }
  .tipo h3 { font-size: 20px; margin-bottom: 8px; }
  .rolagem { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  thead th { text-align: left; font-weight: 400; color: var(--texto-3); font-size: 12px; padding: 6px 8px; border-bottom: 1px solid var(--tinta); vertical-align: bottom; }
  tbody th, tbody td { padding: 6px 8px; border-bottom: 1px solid var(--regra-leve); vertical-align: middle; }
  tbody th { text-align: left; font-weight: 600; white-space: nowrap; }
  tbody th abbr { text-decoration: none; }
  tbody th small { font-weight: 400; color: var(--texto-3); }
  th:first-child, td:first-child { padding-left: 0; }
  .n { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  thead .n { text-align: right; }
  .barra-col { width: 34%; }
  .celula-barra { display: grid; grid-template-columns: minmax(0, 1fr) 72px; gap: 8px; align-items: center; }
  .celula-barra .num { text-align: right; white-space: nowrap; }
  .poucos { color: var(--texto-3); font-size: 13px; }

  .fontes { border-top: 2px solid var(--tinta); padding: 32px 0 0; display: flex; flex-direction: column; gap: 12px; max-width: 880px; scroll-margin-top: 12px; }
  .fontes h2 { font-size: 26px; }
  .fontes ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 15px; line-height: 1.55; color: var(--texto-2); }
  .fontes .menor { margin: 0; font-size: 14px; color: var(--texto-3); }

  @media (max-width: 900px) {
    .cabeca { padding: 28px 0 24px; }
    .cabeca h1 { font-size: 40px; }
    .cabeca p { font-size: 17px; }
    .numeros { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .numeros div { padding: 14px 12px; border-bottom: 1px solid var(--regra); }
    .numeros div:nth-child(2n) { border-right: 0; }
    .numeros div:nth-child(2n + 1) { padding-left: 0; }
    .numeros strong { font-size: 26px; }
    .bloco { display: flex; flex-direction: column; gap: 20px; padding: 28px 0; }
    .texto h2, .texto-largo h2 { font-size: 28px; }
    .degraus li { grid-template-columns: minmax(0, 1fr) 80px; }
