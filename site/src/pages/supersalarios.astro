  .texto .menor { font-size: 14px; color: var(--texto-3); }
  .grafico { grid-column: span 7; display: flex; flex-direction: column; gap: 18px; }
  .grafico h3 { font-size: 18px; }

  .legenda-curta { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 13px; color: var(--texto-3); }
  .legenda-curta li { display: flex; align-items: center; gap: 6px; }
  .legenda-curta .cor { width: 14px; height: 14px; display: inline-block; border: 1px solid rgba(0, 0, 0, 0.15); }
  .barra.ante, .legenda-curta .ante { background: var(--tinta); }
  .barra.depois, .legenda-curta .depois { background: var(--verde); }

  .trilho { position: relative; display: block; height: 14px; }
  .barra { display: block; height: 100%; background: var(--verde); }
  .trilho.duplo { height: 20px; display: flex; flex-direction: column; justify-content: space-between; }
