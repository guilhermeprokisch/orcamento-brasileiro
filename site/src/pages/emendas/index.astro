---
/**
 * Explorador de emendas parlamentares: quem mandou, para onde, para quem e para quê, a partir dos
 * arquivos da CGU (pipeline/…/explorador_emendas.py). A página inicial sai pronta do build; as páginas
 * de parlamentar, entidade e lugar e a busca consultam no navegador, com o DuckDB, dois Parquet no
 * bucket público (os pagamentos e os textos: planos das emendas Pix, convênios e parcerias).
 */
import Base from "../../layouts/Base.astro";
import { moedaCurta, moedaExtenso } from "../../lib/formato";
import "../../styles/onde.css";

interface Resumo {
  fonte: string; ano: number; anos: number[]; pagamentos: string; textos: string; total: number;
  tipos: Record<string, number>;
  autores: [string, number][];
  entidades: { codigo: string; nome: string; lugar: string; valor: number; autor: string }[];
  nomes: string[];
}
const arquivos = import.meta.glob<Resumo>("../../../public/data/emendas-explorador/resumo.json", { eager: true, import: "default" });
const r: Resumo | null = Object.values(arquivos)[0] ?? null;
const pequenas = new Set(["de", "da", "do", "das", "dos", "e", "o", "a", "os", "as", "em", "no", "na", "para", "com"]);
const titulo = (s: string) => (s === s.toUpperCase() ? s.toLowerCase().split(/\s+/).map((p, i) => (i > 0 && pequenas.has(p) ? p : p.charAt(0).toUpperCase() + p.slice(1))).join(" ") : s);
const TIPOS: [string, string, string][] = [
  ["Individual", "Individuais", "com finalidade definida"],
  ["Pix", "Emendas Pix", "caem direto na conta da prefeitura ou do estado"],
  ["Bancada", "De bancada", "os parlamentares de um estado juntos"],
  ["Comissão", "De comissão", "comissões da Câmara e do Senado"],
  ["Relator", "De relator", "de anos anteriores, o antigo “orçamento secreto”"],
];
---

<Base title="Emendas parlamentares · Orçamento Brasileiro" description="Quem mandou emendas parlamentares, para onde, para quem e para quê: deputados, senadores, bancadas e comissões.">
  <div class="wrap explorador" data-emendas data-pagamentos={r?.pagamentos} data-textos={r?.textos} data-ano={r?.ano}>
    <section class="topo" data-topo>
      <nav class="trilha" aria-label="Caminho" data-voltar hidden></nav>
      <span class="sobretitulo" data-sobretitulo hidden></span>
      <h1 data-titulo>As emendas parlamentares</h1>
      {r && (
        <p data-frase>
          Em {r.ano}, deputados, senadores, bancadas e comissões do Congresso mandaram <strong>{moedaExtenso(r.total)}</strong> em
          emendas que foram de fato pagos. Veja quem mandou, para onde, para quem e para fazer o quê.
        </p>
      )}
    </section>

    <form class="busca" action="/emendas" method="get" data-form>
      <label class="campo-grande">
        <span>Procure um parlamentar, uma entidade ou o que foi feito</span>
        <input type="search" name="q" placeholder="Ex.: Romário, Santa Casa, pavimentação, ambulância" autocomplete="off" />
      </label>
      <div class="filtros">
        <label><span>Ano</span>
          <select name="ano"><option value="">Todos os anos</option>{r?.anos.slice().reverse().map((a) => <option value={a}>{a}</option>)}</select>
        </label>
        <div class="onde" data-onde>
          <span id="onde-rotulo">Onde</span>
          <div class="onde-campo">
            <span class="chip" data-chip hidden><span data-chip-texto></span><button type="button" aria-label="Tirar o lugar e voltar a todo o Brasil" data-chip-tirar>✕</button></span>
            <input type="search" data-onde-input role="combobox" aria-labelledby="onde-rotulo" aria-expanded="false" aria-controls="onde-lista" aria-autocomplete="list" placeholder="Todo o Brasil · digite uma cidade ou um estado" autocomplete="off" />
          </div>
          <div class="onde-lista" id="onde-lista" role="listbox" data-onde-lista hidden></div>
        </div>
        <label><span>Onde procurar o texto</span>
          <select name="fonte">
            <option value="">Planos Pix, convênios e parcerias</option>
            <option value="Plano de emenda Pix">Planos das emendas Pix</option>
            <option value="Convênio">Convênios</option>
            <option value="Parceria com entidade">Parcerias com entidades</option>
          </select>
        </label>
        <input type="hidden" name="autor" /><input type="hidden" name="entidade" /><input type="hidden" name="ente" />
        <button type="submit">Procurar</button>
      </div>
      <p class="exemplos" data-exemplos>Exemplos: <a href="/emendas?autor=Romario">Romário</a> · <a href="/emendas?q=pavimentação&fonte=Plano de emenda Pix">pavimentação nas emendas Pix</a> · <a href="/emendas?q=ambulância">ambulância</a> · <a href="/emendas?q=show">shows</a></p>
    </form>

    <section class="resultado" data-resultado hidden aria-live="polite"></section>

    {r && (
      <div class="inicio" data-inicio>
        <section class="tipos">
          <div class="cartoes">
            {TIPOS.filter(([k]) => r.tipos[k]).map(([k, rot, dica]) => (
              <div class:list={["cartao", { destaque: k === "Pix" }]}><span>{rot}</span><strong>{moedaCurta(r.tipos[k])}</strong><small>{dica}</small></div>
            ))}
          </div>
        </section>
        <div class="duas">
          <section>
            <h2>Quem mais mandou (individuais)</h2>
            <p class="menor">O pago em {r.ano} nas emendas individuais e Pix de cada deputado e senador. Senadores têm uma cota maior.</p>
            <ol class="lista">{r.autores.map(([a, v]) => <li><a href={`/emendas?autor=${encodeURIComponent(a)}&ano=${r.ano}`}>{a}</a><span>{moedaCurta(v)}</span></li>)}</ol>
          </section>
          <section>
            <h2>As entidades que mais receberam</h2>
            <p class="menor">Associações, fundações e organizações sociais, sem prefeituras e governos.</p>
            <ol class="lista">
              {r.entidades.map((e) => (
                <li><span class="col"><a href={`/emendas?entidade=${e.codigo}`}>{titulo(e.nome)}</a><small>{e.lugar} · quem mais mandou: <a href={`/emendas?autor=${encodeURIComponent(e.autor)}&ano=${r.ano}`}>{e.autor}</a></small></span><span>{moedaCurta(e.valor)}</span></li>
              ))}
            </ol>
          </section>
        </div>
      </div>
    )}

    <p class="nota">
      Os valores são o que foi de fato pago, pelo lugar de quem recebeu; emendas indicadas antes podem ser pagas anos depois,
      e uma entidade pode usar o dinheiro em outro lugar. O plano de uma emenda Pix é o que a prefeitura ou o estado
      declarou ao receber, não a prestação de contas do que foi feito. Os nomes de quem recebeu são os publicados; o CPF de
      pessoas físicas não aparece. Fonte: {r?.fonte}. <a href="/dados">Baixe todos os dados</a>.
    </p>
  </div>
</Base>

<script is:inline type="module">
  const raiz = document.querySelector("[data-emendas]");
  const PAG = raiz?.dataset.pagamentos, TXT = raiz?.dataset.textos;
  const params = new URLSearchParams(location.search);
  const form = document.querySelector("[data-form]");
  for (const [k, v] of params) { const campo = form?.elements.namedItem(k); if (campo) campo.value = v; }
  const saida = document.querySelector("[data-resultado]");
  const pergunta = ["q", "autor", "entidade", "ente", "uf", "fonte"].some((k) => params.get(k));
  // A trilha (public/explorador/trilha.js): por onde a pessoa veio, com um link para cada passo.
  const { ligarTrilha } = await import("/explorador/trilha.js");
  const trilha = pergunta ? ligarTrilha(document.querySelector("[data-voltar]"), { chave: "emendas", inicio: { url: "/emendas", titulo: "Emendas" } }) : null;
  trilha?.titulo(params.get("q") ? `“${params.get("q")}”` : "Resultado");

  // O campo "Onde" (public/explorador/onde.js): uma cidade abre a página das emendas dela; um estado, tudo o
  // que foi pago a quem fica nele (prefeituras, governo, entidades). Com palavras, a busca fica no lugar.
  const { ligarOnde, carregarLugares } = await import("/explorador/onde.js");
  const campoOnde = ligarOnde(document.querySelector("[data-onde]"), () => form.requestSubmit());
  if (params.get("ente")) await campoOnde.definir(params.get("ente"));
  form?.addEventListener("submit", (ev) => {
    ev.preventDefault();
    const q = new URLSearchParams();
    for (const [k, v] of new FormData(form)) if (v && !["autor", "entidade", "ente", "uf"].includes(k)) q.set(k, v);
    if (campoOnde.escolhido) q.set("ente", campoOnde.escolhido.codigo);
    trilha?.novaBusca();
    location.href = `/emendas${q.size ? `?${q}` : ""}`;
  });

  /** O topo da página assume o que foi escolhido: o parlamentar, a entidade ou a cidade. */
  function topo(titulo_, frase, sobretitulo) {
    document.querySelector("[data-titulo]").textContent = titulo_;
    const p = document.querySelector("[data-frase]"); if (p) p.innerHTML = frase;
    const s = document.querySelector("[data-sobretitulo]"); s.hidden = !sobretitulo; s.textContent = sobretitulo || "";
    trilha?.titulo(titulo_);
    document.querySelector("[data-exemplos]")?.setAttribute("hidden", "");
    document.title = `${titulo_} · Emendas · Orçamento Brasileiro`;
  }

  const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
  const nf1 = new Intl.NumberFormat("pt-BR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const curto = (v) => (v >= 1e9 ? `R$ ${nf1.format(v / 1e9)} bi` : v >= 1e6 ? `R$ ${nf1.format(v / 1e6)} mi` : v >= 1e3 ? `R$ ${nf0.format(v / 1e3)} mil` : `R$ ${nf0.format(v)}`);
  const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
  const sem = (s) => String(s || "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  const pequenas = new Set(["de", "da", "do", "das", "dos", "e", "o", "a", "os", "as", "em", "no", "na", "para", "com"]);
  const titulo = (s) => (s && s === s.toUpperCase() ? s.toLowerCase().split(/\s+/).map((p, i) => (i > 0 && pequenas.has(p) ? p : p.charAt(0).toUpperCase() + p.slice(1))).join(" ") : s || "");
  const frase = (s) => { const t = s && s === s.toUpperCase() && /[A-ZÀ-Ú]{4}/.test(s) ? s.toLowerCase() : s || ""; return t.charAt(0).toUpperCase() + t.slice(1); };
  const linkAutor = (a, ano) => `<a href="/emendas?autor=${encodeURIComponent(a)}${ano ? `&ano=${ano}` : ""}">${esc(a)}</a>`;

  let conn;
  /** O painel de carregamento: o passo atual e uma barra em movimento, no lugar do resultado. */
  function etapa(n, texto) {
    saida.hidden = false;
    saida.innerHTML = `<div class="carregando" role="status" aria-live="polite">
      <div class="barra-carga" aria-hidden="true"><i></i></div>
      <p><strong>${esc(texto)}</strong></p>
      <p class="menor">Passo ${n} de 3. A primeira consulta baixa o motor de busca e a parte dos dados de que precisa; as seguintes são mais rápidas.</p>
    </div>`;
  }
  async function conectar() {
    etapa(1, "Preparando o motor de consulta…");
    const duckdb = await import("https://cdn.jsdelivr.net/npm/@duckdb/duckdb-wasm@1.29.0/+esm");
    const bundle = await duckdb.selectBundle(duckdb.getJsDelivrBundles());
    const url = URL.createObjectURL(new Blob([`importScripts("${bundle.mainWorker}");`], { type: "text/javascript" }));
    const db = new duckdb.AsyncDuckDB(new duckdb.VoidLogger(), new Worker(url));
    await db.instantiate(bundle.mainModule, bundle.pthreadWorker);
    URL.revokeObjectURL(url);
    conn = await db.connect();
    await conn.query(`CREATE VIEW p AS SELECT * FROM read_parquet('${PAG}'); CREATE VIEW t AS SELECT * FROM read_parquet('${TXT}')`);
  }
  const consulta = async (sql, valores = []) => {
    const stmt = await conn.prepare(sql);
    const r = await stmt.query(...valores);
    await stmt.close();
    return r.toArray().map((l) => l.toJSON());
  };
  async function iniciar() {
    document.querySelector("[data-inicio]")?.setAttribute("hidden", "");
    // Enquanto consulta: a busca fica travada e o título já diz o que está sendo carregado.
    form.inert = true;
    form.classList.add("travado");
    const ente = params.get("ente");
    if (params.get("autor")) topo(params.get("autor"), "Carregando as emendas…", "Parlamentar");
    else if (params.get("entidade")) topo("Carregando…", "", "Quem recebeu");
    else if (ente) {
      topo("Carregando…", "", "Emendas");
      carregarLugares().then((l) => { const r = l.porCodigo.get(ente); if (r && document.querySelector("[data-titulo]").textContent === "Carregando…") topo(r.rotulo, "Carregando as emendas…", "Emendas"); });
    }
    try {
      await conectar();
      if (params.get("autor")) await autor();
      else if (params.get("entidade")) await entidade();
      else if (params.get("ente") && !params.get("q")) await lugar();
      else await busca();
    } catch (erro) {
      saida.innerHTML = `<p class="erro">Não foi possível consultar as emendas agora (${esc(erro.message || erro)}). Tente de novo em instantes.</p>`;
    } finally {
      form.inert = false;
      form.classList.remove("travado");
    }
  }

  const barras = (l, rot, cor = "verde") => { const m = Math.max(...l.map((x) => x.valor), 1); return `<ol class="barras">${l.map((x) => `<li><span>${rot(x)}</span><i class="${cor}" style="width:${(x.valor / m) * 100}%"></i><strong>${curto(x.valor)}</strong></li>`).join("")}</ol>`; };
  const botoesAno = (anos, atual, base) => `<div class="agrupar">${anos.map((a) => `<a class="botao" aria-current="${a === atual}" href="${base}&ano=${a}">${a}${a > Number(raiz.dataset.ano) ? " (até agora)" : ""}</a>`).join("")}</div>`;
  const lugarRot = (x) => (x.ibge ? `<a href="/emendas?ente=${esc(x.ibge)}&ano=${x.ano ?? ""}">${esc(x.municipio)} (${esc(x.uf)})</a>` : `${esc(x.municipio || x.uf || "Sem lugar")}${x.municipio && x.uf ? ` (${esc(x.uf)})` : ""}`);

  async function autor() {
    const a = params.get("autor");
    etapa(2, "Procurando as emendas…");
    const anos = (await consulta(`SELECT DISTINCT ano FROM p WHERE autor = ? ORDER BY ano`, [a])).map((x) => x.ano);
    if (!anos.length) { saida.innerHTML = `<p>Nenhuma emenda paga de “${esc(a)}”. Procure o nome como ele aparece no Congresso.</p>`; return; }
    const ano = Number(params.get("ano")) || (anos.includes(Number(raiz.dataset.ano)) ? Number(raiz.dataset.ano) : anos.at(-1));
    await consulta(`CREATE OR REPLACE TEMP TABLE x AS SELECT * FROM p WHERE autor = ? AND ano = ?`, [a, ano]);
    etapa(3, "Organizando o resultado…");
    const [s] = await consulta(`SELECT count(DISTINCT emenda)::INTEGER AS emendas, sum(valor) AS valor, count(DISTINCT coalesce(nullif(ibge, ''), municipio || uf))::INTEGER AS lugares, sum(CASE WHEN tipo = 'Pix' THEN valor ELSE 0 END) AS pix, any_value(tipo) AS tipo FROM x`);
    const onde = await consulta(`SELECT municipio, uf, ibge, ${ano} AS ano, sum(valor) AS valor FROM x GROUP BY ALL ORDER BY valor DESC LIMIT 10`);
    const quem = await consulta(`SELECT grupo, sum(valor) AS valor FROM x GROUP BY grupo ORDER BY valor DESC`);
    const area = await consulta(`SELECT coalesce(nullif(area, ''), 'Sem área') AS area, sum(valor) AS valor FROM x GROUP BY 1 ORDER BY valor DESC LIMIT 6`);
    const ent = await consulta(`SELECT favorecido, codigo, sum(valor) AS valor FROM x WHERE grupo IN ('Entidade sem fins lucrativos', 'Empresa') GROUP BY ALL ORDER BY valor DESC LIMIT 8`);
    const pix = await consulta(`SELECT beneficiario, objeto, valor FROM t WHERE autor = ? AND fonte = 'Plano de emenda Pix' AND ano = ? ORDER BY valor DESC LIMIT 10`, [a, ano]);
    const coletivo = /^(Bancada|Comissão|Relator)/.test(a);
    topo(a, `Em ${ano}, foram pagos <strong>${curto(s.valor)}</strong> em ${nf0.format(s.emendas)} ${s.emendas === 1 ? "emenda" : "emendas"}, para <strong>${nf0.format(s.lugares)} ${s.lugares === 1 ? "lugar" : "lugares"}</strong>${s.pix > 0 ? `, ${curto(s.pix)} deles por emenda Pix` : ""}.`,
      coletivo ? "Emendas coletivas" : "Parlamentar");
    saida.innerHTML = `
      ${botoesAno(anos, ano, `/emendas?autor=${encodeURIComponent(a)}`)}
      <div class="tres">
        <section><h3>Para onde</h3>${barras(onde, lugarRot)}</section>
        <section><h3>Para quem</h3>${barras(quem, (x) => esc(x.grupo))}</section>
        <section><h3>Para quê</h3>${barras(area, (x) => esc(x.area), "azul")}</section>
      </div>
      ${ent.length ? `<section><h3>Entidades e empresas que receberam</h3><ol class="lista">${ent.map((x) => `<li><span>${x.codigo ? `<a href="/emendas?entidade=${esc(x.codigo)}">${esc(titulo(x.favorecido))}</a>` : esc(titulo(x.favorecido))}</span><span>${curto(x.valor)}</span></li>`).join("")}</ol></section>` : ""}
      ${pix.length ? `<section><h3>O que disseram que fariam com as emendas Pix de ${ano}</h3><p class="menor">É o plano declarado por quem recebeu, não o que foi feito.</p>
        <div class="tabela t3" role="table"><div class="linha cab" role="row"><span role="columnheader">Quem recebeu</span><span role="columnheader">O plano declarado</span><span role="columnheader" class="d">Valor</span></div>
        ${pix.map((x) => `<div class="linha" role="row"><span role="cell">${esc(titulo(x.beneficiario))}</span><span role="cell">${esc(frase(x.objeto))}</span><strong role="cell" class="d">${curto(x.valor)}</strong></div>`).join("")}</div></section>` : ""}
      <p class="menor">${coletivo ? "Emendas coletivas são indicadas em grupo." : "Só as emendas individuais; as de bancada e de comissão aparecem nas páginas da bancada e da comissão."} Valores pagos no ano, pelo lugar de quem recebeu.</p>`;
  }

  async function entidade() {
    const cod = params.get("entidade");
    etapa(2, "Procurando os pagamentos…");
    await consulta(`CREATE OR REPLACE TEMP TABLE x AS SELECT * FROM p WHERE codigo = ?`, [cod]);
    const [s] = await consulta(`SELECT mode(favorecido) AS nome, any_value(municipio) AS municipio, any_value(uf) AS uf, sum(valor) AS valor, count(DISTINCT emenda)::INTEGER AS emendas FROM x`);
    if (!s.valor) { saida.innerHTML = `<p>Nenhum pagamento de emenda para esse CNPJ.</p>`; return; }
    etapa(3, "Organizando o resultado…");
    const anos = await consulta(`SELECT ano, sum(valor) AS valor FROM x GROUP BY ano ORDER BY ano`);
    const autores = await consulta(`SELECT autor, sum(valor) AS valor FROM x GROUP BY autor ORDER BY valor DESC LIMIT 10`);
    const textos = await consulta(`SELECT fonte, ano, autor, objeto, valor FROM t WHERE codigo = ? ORDER BY valor DESC LIMIT 15`, [cod]);
    topo(titulo(s.nome), `${esc(s.municipio)}${s.uf ? ` (${esc(s.uf)})` : ""}. Recebeu <strong>${curto(s.valor)}</strong> de ${nf0.format(s.emendas)} ${s.emendas === 1 ? "emenda" : "emendas"}, somando todos os anos.`,
      `Quem recebeu · CNPJ ${cod}`);
    saida.innerHTML = `
      <div class="duas">
        <section><h3>Ano a ano</h3>${barras(anos, (x) => String(x.ano))}</section>
        <section><h3>Quem mandou</h3>${barras(autores, (x) => linkAutor(x.autor))}</section>
      </div>
      ${textos.length ? `<section><h3>Para fazer o quê</h3><div class="tabela t4" role="table"><div class="linha cab" role="row"><span role="columnheader">Quem mandou</span><span role="columnheader">Objeto</span><span role="columnheader">Tipo</span><span role="columnheader" class="d">Valor</span></div>
        ${textos.map((x) => `<div class="linha" role="row"><span role="cell">${linkAutor(x.autor)}<small>${x.ano || ""}</small></span><span role="cell">${esc(frase(x.objeto))}</span><span role="cell">${esc(x.fonte)}</span><strong role="cell" class="d">${curto(x.valor)}</strong></div>`).join("")}</div></section>` : ""}`;
  }

  async function lugar() {
    const ente = params.get("ente");
    // Um estado (código de 2 dígitos): tudo o que foi pago a quem fica nele, pela UF.
    const estado = ente.length === 2 ? (await carregarLugares()).porCodigo.get(ente)?.sigla : null;
    const [col, val] = estado ? ["uf", estado] : ["ibge", ente];
    etapa(2, "Procurando as emendas…");
    const anos = (await consulta(`SELECT DISTINCT ano FROM p WHERE ${col} = ? ORDER BY ano`, [val])).map((x) => x.ano);
    if (!anos.length) { saida.innerHTML = `<p>Nenhuma emenda paga a quem fica neste lugar.</p>`; return; }
    const ano = Number(params.get("ano")) || (anos.includes(Number(raiz.dataset.ano)) ? Number(raiz.dataset.ano) : anos.at(-1));
    await consulta(`CREATE OR REPLACE TEMP TABLE x AS SELECT * FROM p WHERE ${col} = ? AND ano = ?`, [val, ano]);
    etapa(3, "Organizando o resultado…");
    const [s] = await consulta(`SELECT any_value(municipio) AS municipio, any_value(uf) AS uf, sum(valor) AS valor, count(DISTINCT emenda)::INTEGER AS emendas FROM x`);
    const autores = await consulta(`SELECT autor, sum(valor) AS valor FROM x GROUP BY autor ORDER BY valor DESC LIMIT 10`);
    const quem = await consulta(`SELECT favorecido, codigo, grupo, sum(valor) AS valor FROM x GROUP BY ALL ORDER BY valor DESC LIMIT 10`);
    const area = await consulta(`SELECT coalesce(nullif(area, ''), 'Sem área') AS area, sum(valor) AS valor FROM x GROUP BY 1 ORDER BY valor DESC LIMIT 6`);
    topo(estado ? (await carregarLugares()).porCodigo.get(ente).nome : `${s.municipio} (${s.uf})`,
      estado
        ? `Em ${ano}, foram pagos <strong>${curto(s.valor)}</strong> de ${nf0.format(s.emendas)} emendas a quem fica no estado: prefeituras, o governo estadual, entidades e empresas.`
        : `Em ${ano}, foram pagos <strong>${curto(s.valor)}</strong> de ${nf0.format(s.emendas)} emendas a quem fica aqui: a prefeitura, entidades, empresas e órgãos estaduais e federais com sede na cidade.`,
      estado ? "Emendas no estado" : "Emendas na cidade");
    saida.innerHTML = `
      ${botoesAno(anos, ano, `/emendas?ente=${esc(ente)}`)}
      <div class="tres">
        <section><h3>Quem mandou</h3>${barras(autores, (x) => linkAutor(x.autor, ano))}</section>
        <section><h3>Quem recebeu</h3>${barras(quem, (x) => `${x.codigo ? `<a href="/emendas?entidade=${esc(x.codigo)}">${esc(titulo(x.favorecido))}</a>` : esc(titulo(x.favorecido))}<small>${esc(x.grupo)}</small>`)}</section>
        <section><h3>Para quê</h3>${barras(area, (x) => esc(x.area), "azul")}</section>
      </div>`;
  }

  async function busca() {
    const q = (params.get("q") || "").trim();
    const termos = q.split(/\s+ou\s+|,/i).map((x) => sem(x.trim())).filter(Boolean);
    const onde = [], v = [];
    if (termos.length) { onde.push(`(${termos.map(() => "(strip_accents(lower(objeto)) LIKE ? OR strip_accents(lower(beneficiario)) LIKE ?)").join(" OR ")})`); termos.forEach((x) => v.push(`%${x}%`, `%${x}%`)); }
    for (const k of ["fonte", "uf"]) { const x = params.get(k); if (x) { onde.push(`${k} = ?`); v.push(x); } }
    const ano = Number(params.get("ano")); if (ano) { onde.push("ano = ?"); v.push(ano); }
    // Na cidade: os textos não trazem o código dela, então vale o nome (no município ou em quem recebeu) e o estado.
    const ente = params.get("ente");
    if (ente && ente.length === 2) {
      const l = await carregarLugares();
      onde.push("uf = ?"); v.push(l.porCodigo.get(ente)?.sigla);
      topo(l.porCodigo.get(ente)?.nome || "", "Nos textos das emendas de quem fica no estado: planos das emendas Pix, convênios e parcerias.", "Busca no estado");
    } else if (ente) {
      const rotulo = (await carregarLugares()).porCodigo.get(ente)?.rotulo || "";
      const [, nome, uf] = /^(.*) \((\w\w)\)$/.exec(rotulo) || [];
      if (nome) {
        onde.push("(strip_accents(lower(municipio)) = ? OR strip_accents(lower(beneficiario)) LIKE ?) AND uf = ?");
        v.push(sem(nome), `%${sem(nome)}%`, uf);
        topo(rotulo, `Nos textos das emendas de quem fica em ${esc(nome)}: planos das emendas Pix, convênios e parcerias.`, "Busca na cidade");
      }
    }
    etapa(2, "Procurando nos textos das emendas…");
    // Parlamentares e entidades cujo nome bate com a busca, para ir direto à página deles.
    const nomes = termos.length ? (await fetch("/data/emendas-explorador/resumo.json").then((x) => x.json())).nomes.filter((n) => termos.some((t) => sem(n).includes(t))).slice(0, 8) : [];
    const ents = termos.length ? await consulta(`SELECT mode(favorecido) AS nome, codigo, sum(valor) AS valor FROM p WHERE codigo <> '' AND (${termos.map(() => "strip_accents(lower(favorecido)) LIKE ?").join(" OR ")}) GROUP BY codigo ORDER BY valor DESC LIMIT 6`, termos.map((x) => `%${x}%`)) : [];
    await consulta(`CREATE OR REPLACE TEMP TABLE r AS SELECT * FROM t ${onde.length ? `WHERE ${onde.join(" AND ")}` : ""}`, v);
    etapa(3, "Organizando o resultado…");
    const [s] = await consulta(`SELECT count(*)::INTEGER AS n, coalesce(sum(valor), 0) AS valor, count(DISTINCT beneficiario)::INTEGER AS quem FROM r`);
    let por = "texto", pagina = 0;
    const desenhar = async () => {
      let corpo;
      if (por === "texto") {
        const l = await consulta(`SELECT fonte, ano, autor, beneficiario, codigo, uf, objeto, valor FROM r ORDER BY valor DESC LIMIT 50 OFFSET ${pagina * 50}`);
        corpo = `<div class="tabela t4" role="table"><div class="linha cab" role="row"><span role="columnheader">Quem mandou</span><span role="columnheader">Quem recebeu</span><span role="columnheader">O que foi pedido ou declarado</span><span role="columnheader" class="d">Valor</span></div>
          ${l.map((x) => `<div class="linha" role="row"><span role="cell">${x.autor ? linkAutor(x.autor) : "—"}<small>${x.ano ? `emenda de ${x.ano}` : ""}</small></span><span role="cell">${x.codigo ? `<a href="/emendas?entidade=${esc(x.codigo)}">${esc(titulo(x.beneficiario))}</a>` : esc(titulo(x.beneficiario))}<small>${esc(x.uf)}</small></span><span role="cell">${esc(frase(x.objeto)) || "Sem descrição"}<small>${esc(x.fonte)}</small></span><strong role="cell" class="d">${curto(x.valor)}</strong></div>`).join("")}</div>
          <div class="pe"><span>Mostrando ${nf0.format(Math.min(s.n, (pagina + 1) * 50))} de ${nf0.format(s.n)}, do maior para o menor valor.</span>${(pagina + 1) * 50 < s.n ? `<button type="button" data-mais>Mostrar mais</button>` : ""}</div>`;
      } else {
        const col = por === "autor" ? "autor" : "beneficiario";
        const l = await consulta(`SELECT ${col} AS nome, any_value(codigo) AS codigo, count(*)::INTEGER AS n, sum(valor) AS valor FROM r GROUP BY ${col} ORDER BY valor DESC LIMIT 100`);
        corpo = `<ol class="lista">${l.map((x) => `<li><span>${por === "autor" ? (x.nome ? linkAutor(x.nome) : "—") : x.codigo ? `<a href="/emendas?entidade=${esc(x.codigo)}">${esc(titulo(x.nome))}</a>` : esc(titulo(x.nome))}</span><span>${x.n === 1 ? "1 registro" : `${nf0.format(x.n)} registros`} · ${curto(x.valor)}</span></li>`).join("")}</ol>`;
      }
      saida.innerHTML = `
        ${nomes.length || ents.length ? `<div class="atalhos">${nomes.length ? `<p><span>Parlamentares e grupos:</span> ${nomes.map((n) => linkAutor(n)).join(" · ")}</p>` : ""}${ents.length ? `<p><span>Quem recebeu:</span> ${ents.map((e) => `<a href="/emendas?entidade=${esc(e.codigo)}">${esc(titulo(e.nome))}</a>`).join(" · ")}</p>` : ""}</div>` : ""}
        <h2>${termos.length ? "Nos textos das emendas" : "Os textos das emendas"}</h2>
        <div class="numeros"><div><span>Encontrados</span><strong>${nf0.format(s.n)}</strong></div><div><span>Somam</span><strong>${curto(s.valor)}</strong></div><div><span>Para</span><strong>${nf0.format(s.quem)} ${s.quem === 1 ? "beneficiário" : "beneficiários"}</strong></div></div>
        ${s.n ? `<div class="agrupar"><span>Agrupar por:</span>${[["texto", "Texto"], ["autor", "Quem mandou"], ["quem", "Quem recebeu"]].map(([k, t]) => `<button type="button" data-por="${k}" aria-pressed="${por === k}">${t}</button>`).join("")}<span class="espaco"></span><button type="button" class="link" data-csv>Baixar (planilha)</button></div>${corpo}` : `<div class="vazio"><p><strong>Nenhum texto com essas palavras.</strong></p><p class="menor">Tente outras palavras (cada prefeitura descreve do seu jeito), tire um filtro ou procure em todo o Brasil. Para ver tudo o que chegou a um lugar, escolha só a cidade ou o estado, sem palavras.</p></div>`}
        <p class="menor">A busca procura no objeto dos convênios e das parcerias e no plano declarado das emendas Pix, com e sem acento; separe alternativas com “ou”. O valor dos planos e convênios é o previsto, não necessariamente o pago.</p>`;
      saida.querySelectorAll("[data-por]").forEach((b) => b.addEventListener("click", () => { por = b.dataset.por; pagina = 0; desenhar(); }));
      saida.querySelector("[data-mais]")?.addEventListener("click", () => { pagina += 1; desenhar(); });
      saida.querySelector("[data-csv]")?.addEventListener("click", async () => {
        const l = await consulta(`SELECT fonte, ano, autor, beneficiario, codigo AS cnpj, uf, objeto, valor FROM r ORDER BY valor DESC LIMIT 100000`);
        const cols = Object.keys(l[0] || { fonte: "" });
        const cel = (x) => { const t = String(x ?? ""); return /[";\n]/.test(t) ? `"${t.replace(/"/g, '""')}"` : t; };
        const csv = "﻿" + [cols.join(";"), ...l.map((x) => cols.map((k) => cel(x[k])).join(";"))].join("\n");
        const a = Object.assign(document.createElement("a"), { href: URL.createObjectURL(new Blob([csv], { type: "text/csv;charset=utf-8" })), download: "emendas.csv" });
        a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      });
    };
    await desenhar();
  }
  // Por último: a busca usa as funções acima.
  if (PAG && pergunta && saida) iniciar();
</script>

