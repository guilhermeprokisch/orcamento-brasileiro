---
/**
 * As emendas parlamentares (/emendas): a história, de cima para baixo (o que é uma emenda, os tipos, como
 * cresceram, para onde vão, onde chega mais por morador e quem manda), com o submenu das três páginas das emendas:
 * esta, o explorador (/emendas/explorar) e a busca emenda por emenda (/emendas/buscar).
 *
 * A busca morava aqui, em /emendas?ente=…, ?autor=…, ?entidade=…, ?q=…; esses endereços (os das páginas de cidade,
 * links já compartilhados) seguem para /emendas/buscar com os mesmos parâmetros, antes de a página aparecer.
 */
import Base from "../../layouts/Base.astro";
import HistoriaEmendas from "../../components/emendas/HistoriaEmendas.astro";
import EmendasAbas from "../../components/emendas/EmendasAbas.astro";
import { ANO, panorama, TOTAL, POR_MORADOR } from "../../lib/emendas-panorama";
import { moedaExtenso } from "../../lib/formato";

const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
const descricao = panorama
  ? `Em ${ANO}, deputados e senadores mandaram ${moedaExtenso(TOTAL)} em emendas, cerca de R$ ${nf0.format(POR_MORADOR)} por morador. O que são, para onde vão e quem manda.`
  : "O que são as emendas parlamentares, quanto são e para onde vão.";
---

<Base title="Emendas parlamentares · Orçamento Brasileiro" description={descricao}>
  <script is:inline>
    (function () {
      var p = new URLSearchParams(location.search);
      if (["q", "autor", "entidade", "ente", "uf", "fonte"].some(function (k) { return p.get(k); })) location.replace("/emendas/buscar" + location.search + location.hash);
    })();
  </script>
  <div class="wrap">
    <EmendasAbas ativa="inicio" />
    {panorama ? <HistoriaEmendas /> : <p>A visão geral das emendas ainda não foi gerada (<code>uv run explorador-emendas --so-panorama</code>).</p>}
  </div>
</Base>
