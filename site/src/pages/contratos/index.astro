---
/**
 * Explorador de contratos: todos os contratos de prefeituras, estados (e, quando o download completo
 * terminar, da União) publicados no PNCP no último ano fechado. A página inicial sai pronta do build
 * (resumo.json); a busca, os filtros e a página de cada empresa consultam no navegador, com o DuckDB,
 * o Parquet guardado no bucket público (pipeline/…/explorador_contratos.py), baixando só os blocos
 * de que cada pergunta precisa.
 */
import Base from "../../layouts/Base.astro";
import { moedaCurta, moedaExtenso } from "../../lib/formato";
import "../../styles/onde.css";
import "../../styles/degraus.css";

interface Empresa { cnpj: string; nome: string; lugares: number; n: number; valor: number; teto: boolean }
interface Resumo {
  ano: number; fonte: string; arquivo: string; porCnpj: string;
  total: { n: number; valor: number };
  esferas: Record<string, { n: number; valor: number }>;
  tipos: [string, number, number][];
  merenda: { n: number; valor: number };
  fora: number;
  lugares: Empresa[];
  maiores: Empresa[];
}
const arquivos = import.meta.glob<Resumo>("../../../public/data/contratos/resumo.json", { eager: true, import: "default" });
const r: Resumo | null = Object.values(arquivos)[0] ?? null;
const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
const pequenas = new Set(["de", "da", "do", "das", "dos", "e"]);
const SIGLAS = /^(S\/?A|S\.A\.?|LTDA|ME|EPP|EIRELI|CIEE|MGS|II|III)$/;
/** "CENTERMEDI COMERCIO DE PROD. HOSPITAL. LTDA" → "Centermedi Comercio de Prod. Hospital. Ltda". */
const nome = (s: string) => (s === s.toUpperCase()
  ? s.toLowerCase().split(/\s+/).map((p, i) => (SIGLAS.test(p.toUpperCase()) && !/^ltda$/i.test(p) ? p.toUpperCase() : i > 0 && pequenas.has(p) ? p : p.charAt(0).toUpperCase() + p.slice(1))).join(" ")
  : s);
const tem = (e: string) => !!r?.esferas[e];
---

<Base title="Contratos · Orçamento Brasileiro" description="Busque os contratos que prefeituras, governos estaduais e o governo federal assinaram e publicaram no Portal Nacional de Contratações Públicas.">
  <div class="wrap explorador" data-explorador data-arquivo={r?.arquivo} data-por-cnpj={r?.porCnpj} data-ano={r?.ano}
    data-total={r?.total.valor} data-total-texto={r ? `${moedaCurta(r.total.valor)} · ${nf0.format(r.total.n)} contratos` : undefined}>
    <nav class="degraus" aria-label="Caminho" data-voltar hidden></nav>
    <section class="topo" data-topo>
      <span class="sobretitulo" data-sobretitulo hidden></span>
      <h1 data-titulo>Os contratos</h1>
      {r && (
        <p data-frase>
          Todos os contratos que {tem("Governo federal") ? "prefeituras, governos estaduais e o governo federal" : "prefeituras e governos estaduais"} assinaram
          em {r.ano} e publicaram no Portal Nacional de Contratações Públicas: <strong>{nf0.format(r.total.n)} contratos</strong>,
          que somam {moedaExtenso(r.total.valor)}. Procure pelo que foi comprado, pela empresa ou pelo lugar.
        </p>
      )}
    </section>

    <form class="busca" action="/contratos" method="get" data-form>
      <label class="campo-grande">
        <span>O que você procura</span>
        <input type="search" name="q" placeholder="Ex.: merenda, coleta de lixo, nome da empresa ou CNPJ" autocomplete="off" />
      </label>
      <div class="filtros">
        <div class="onde" data-onde>
          <span id="onde-rotulo">Onde</span>
          <div class="onde-campo">
            <span class="chip" data-chip hidden><span data-chip-texto></span><button type="button" aria-label="Tirar o lugar e voltar a todo o Brasil" data-chip-tirar>✕</button></span>
            <input type="search" data-onde-input role="combobox" aria-labelledby="onde-rotulo" aria-expanded="false" aria-controls="onde-lista" aria-autocomplete="list" placeholder="Todo o Brasil · digite uma cidade ou um estado" autocomplete="off" />
          </div>
          <div class="onde-lista" id="onde-lista" role="listbox" data-onde-lista hidden></div>
        </div>
        <label data-quem><span>Quem contratou</span>
          <select name="esfera">
            <option value="">Todos</option>
            <option value="Prefeitura">Prefeituras</option>
            <option value="Governo estadual">Governos estaduais</option>
            {tem("Governo federal") && <option value="Governo federal">Governo federal</option>}
          </select>
        </label>
        <label><span>Tipo</span>
          <select name="tipo"><option value="">Todos</option>{r?.tipos.map(([t]) => <option value={t}>{t}</option>)}</select>
        </label>
        <label><span>Valor a partir de</span>
          <select name="min">
            <option value="">Qualquer valor</option><option value="100000">R$ 100 mil</option><option value="1000000">R$ 1 milhão</option><option value="10000000">R$ 10 milhões</option>
          </select>
        </label>
        <input type="hidden" name="ente" />
        <input type="hidden" name="uf" />
        <input type="hidden" name="empresa" />
        <button type="submit">Procurar</button>
      </div>
      <div class="escopo" role="radiogroup" aria-label="No estado" data-escopo hidden>
        <label><input type="radio" name="escopo" value="governo" checked /> <span data-escopo-governo>Só o governo do estado</span></label>
        <label><input type="radio" name="escopo" value="tudo" /> <span data-escopo-tudo>O governo e as prefeituras do estado</span></label>
      </div>
      <p class="exemplos" data-exemplos>Exemplos: <a href="/contratos?q=merenda ou gêneros alimentícios&uf=CE">merenda no Ceará</a> · <a href="/contratos?q=coleta de lixo">coleta de lixo</a> · <a href="/contratos?q=show artístico">shows</a> · <a href="/contratos?q=locação de veículos">aluguel de carros</a></p>
    </form>

    <div class="voltar-resultado" data-voltar-botao hidden></div>
    <section class="resultado" data-resultado hidden aria-live="polite"></section>

    {r && (
      <div class="inicio" data-inicio>
        <div class="duas">
          <section>
            <h2>As empresas em mais lugares</h2>
            <p class="menor">Quantas prefeituras e governos contrataram cada empresa em {r.ano}.</p>
            <ol class="lista">
              {r.lugares.map((e) => <li><a href={`/contratos?empresa=${e.cnpj}`}>{nome(e.nome)}</a><span>{nf0.format(e.lugares)} lugares · {moedaCurta(e.valor)}</span></li>)}
            </ol>
          </section>
          <section>
            <h2>As empresas com os maiores valores</h2>
            <p class="menor">A soma dos contratos assinados em {r.ano}, que podem durar mais de um ano.</p>
            <ol class="lista">
              {r.maiores.map((e) => (
                <li>
                  <span class="col"><a href={`/contratos?empresa=${e.cnpj}`}>{nome(e.nome)}</a>{e.teto && <small class="aviso">Na maior parte, valor máximo estimado (credenciamento), não o contratado</small>}</span>
                  <span>{moedaCurta(e.valor)}</span>
                </li>
              ))}
            </ol>
          </section>
        </div>
        <section class="tipos">
          <h2>No que se gasta</h2>
          <div class="cartoes">
            <a href="/contratos?q=merenda ou gêneros alimentícios ou alimentação escolar"><span>Merenda e alimentos</span><strong>{moedaCurta(r.merenda.valor)}</strong><span>{nf0.format(r.merenda.n)} contratos</span></a>
            {r.tipos.slice(0, 5).map(([t, n, v]) => <a href={`/contratos?tipo=${encodeURIComponent(t)}`}><span>{t}</span><strong>{moedaCurta(v)}</strong><span>{nf0.format(n)} contratos</span></a>)}
          </div>
        </section>
      </div>
    )}

    <p class="nota">
      O valor de um contrato é o de toda a duração dele, que pode passar de um ano. Nem toda prefeitura publica tudo no
      portal nacional. Nos credenciamentos, o valor publicado é o máximo que se pode gastar, não o contratado. Contratos
      maiores que metade do orçamento do ano de quem contratou ficam de fora, por erro de digitação; no governo federal, os
      acima de R$ 5 bilhões, e todos os de uma unidade que publicou mais de um assim{r && r.fora > 0 && <> ({nf0.format(r.fora)} casos)</>}.
      Os nomes dos fornecedores são os publicados no portal; o CPF de pessoas físicas não aparece.
      Fonte: {r?.fonte}. <a href="/dados">Baixe todos os dados</a>.
    </p>
  </div>
</Base>

<script is:inline type="module">
  // A busca: o DuckDB lê, no navegador, só os blocos do Parquet de que cada pergunta precisa.
  const raiz = document.querySelector("[data-explorador]");
  const ARQ = raiz?.dataset.arquivo, POR_CNPJ = raiz?.dataset.porCnpj;
  const params = new URLSearchParams(location.search);
  const form = document.querySelector("[data-form]");
  for (const [k, v] of params) { const campo = form?.elements.namedItem(k); if (campo) campo.value = v; }
  const pergunta = ["q", "uf", "esfera", "tipo", "min", "ente", "orgao", "empresa"].some((k) => params.get(k));
  const saida = document.querySelector("[data-resultado]");
  // Os degraus (public/explorador/trilha.js): por onde a pessoa veio, um degrau por passo, com o valor de cada um.
  const { ligarTrilha } = await import("/explorador/trilha.js");
  const trilha = ligarTrilha(document.querySelector("[data-voltar]"), {
    chave: "contratos", botao: document.querySelector("[data-voltar-botao]"),
    inicio: { url: "/contratos", tipo: "Todos os contratos", titulo: `Brasil, ${raiz?.dataset.ano ?? ""}`, valor: raiz?.dataset.totalTexto,
      v: Number(raiz?.dataset.total), base: "contratos", ano: raiz?.dataset.ano, de: "do Brasil", volta: "todos os contratos" },
  });
  // O tipo do passo e como o seguinte se refere a ele ("12% da cidade").
  const [tipoPasso, dePasso] = params.get("empresa") ? ["Empresa", "da empresa"] : params.get("q") ? ["O que você procurou", "da busca"]
    : params.get("orgao") ? ["Quem contratou", "do órgão"] : params.get("ente") ? ["Onde", params.get("ente").length === 2 ? "do governo" : "da cidade"]
    : params.get("uf") ? ["Onde", "do estado"] : ["Filtros", "do resultado"];
  trilha.passo({ tipo: tipoPasso, de: dePasso, titulo: params.get("q") ? `“${params.get("q")}”` : "Resultado" });

  // O campo "Onde" (public/explorador/onde.js): cidade ou estado. Num estado, a pergunta: só o governo
  // ou o governo e as prefeituras. Numa cidade, nada mais de lugar faz sentido.
  const { ligarOnde, carregarLugares } = await import("/explorador/onde.js");
  const escopo = document.querySelector("[data-escopo]");
  const quemContratou = document.querySelector("[data-quem]");
  const mostrarLugar = (l) => {
    escopo.hidden = !l || l.tipo !== "uf";
    quemContratou.hidden = !!l;
    if (l?.tipo === "uf") {
      const prep = { BA: "da", PB: "da", AL: "de", GO: "de", MG: "de", MS: "de", MT: "de", PE: "de", RO: "de", RR: "de", SC: "de", SE: "de", SP: "de" }[l.sigla] ?? "do";
      document.querySelector("[data-escopo-governo]").textContent = `Só o governo ${prep} ${l.nome}`;
      document.querySelector("[data-escopo-tudo]").textContent = `O governo e as prefeituras ${prep === "da" ? "da" : prep === "do" ? "do" : "de"} ${l.nome}`;
    }
  };
  // Escolher (ou tirar) um lugar, ou trocar a opção do estado, já aplica o filtro.
  const onde = ligarOnde(document.querySelector("[data-onde]"), (l) => { mostrarLugar(l); form.requestSubmit(); });
  escopo.addEventListener("change", () => form.requestSubmit());
  // Vindo do endereço: ?ente= (cidade ou governo estadual) ou ?uf= (governo e prefeituras do estado).
  const doEndereco = params.get("ente") || (params.get("uf") ? (await carregarLugares()).porSigla.get(params.get("uf"))?.codigo : null);
  if (doEndereco) {
    mostrarLugar(await onde.definir(doEndereco));
    if (params.get("uf") && !params.get("ente")) form.querySelector('input[name="escopo"][value="tudo"]').checked = true;
  }
  form?.addEventListener("submit", (ev) => {
    ev.preventDefault();
    const l = onde.escolhido, q = new URLSearchParams();
    for (const [k, v] of new FormData(form)) if (v && !["ente", "uf", "orgao", "empresa", "escopo", "esfera"].includes(k)) q.set(k, v);
    if (!l) { const e = form.elements.namedItem("esfera").value; if (e) q.set("esfera", e); }
    else if (l.tipo === "mun") q.set("ente", l.codigo);
    else if (new FormData(form).get("escopo") === "tudo") q.set("uf", l.sigla);
    else q.set("ente", l.codigo);
    trilha.novaBusca();
    location.href = `/contratos${q.size ? `?${q}` : ""}`;   // procurar sai da página da empresa
  });

  /** O topo da página assume o que foi escolhido: a cidade, o estado ou a empresa. */
  function topo(titulo_, frase, sobretitulo) {
    document.querySelector("[data-titulo]").textContent = titulo_;
    const p = document.querySelector("[data-frase]"); if (p) p.innerHTML = frase;
    const s = document.querySelector("[data-sobretitulo]"); s.hidden = !sobretitulo; s.textContent = sobretitulo || "";
    if (!params.get("q")) trilha.titulo(titulo_);   // numa busca, o degrau é o que se procurou
    document.querySelector("[data-exemplos]")?.setAttribute("hidden", "");
    document.title = `${titulo_} · Contratos · Orçamento Brasileiro`;
  }

  const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
  const nf1 = new Intl.NumberFormat("pt-BR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const curto = (v) => (v >= 1e9 ? `R$ ${nf1.format(v / 1e9)} bi` : v >= 1e6 ? `R$ ${nf1.format(v / 1e6)} mi` : v >= 1e3 ? `R$ ${nf0.format(v / 1e3)} mil` : `R$ ${nf0.format(v)}`);
  const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
  const sem = (s) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  const pequenas = new Set(["de", "da", "do", "das", "dos", "e"]);
  const titulo = (s) => (s && s === s.toUpperCase() ? s.toLowerCase().split(/\s+/).map((p, i) => (/^(s\/?a|me|epp|eireli)$/.test(p) ? p.toUpperCase() : i > 0 && pequenas.has(p) ? p : p.charAt(0).toUpperCase() + p.slice(1))).join(" ") : s);
  const frase = (s) => { const t = s && s === s.toUpperCase() && /[A-ZÀ-Ú]{4}/.test(s) ? s.toLowerCase() : s || ""; return t.charAt(0).toUpperCase() + t.slice(1); };
  /** A fatia de um valor no total: "24%", "<1%". */
  const fatia = (v, total) => { const p = total > 0 ? (v / total) * 100 : 0; return p >= 99.5 ? "100%" : p >= 1 ? `${nf0.format(p)}%` : "<1%"; };
  const mes = (d) => { const x = new Date(d); return isNaN(x) ? "" : x.toLocaleDateString("pt-BR", { month: "short", year: "numeric", timeZone: "UTC" }).replace(" de ", "/").replace(".", ""); };
  // "08924078000104-2-000013/2025" → a página do contrato no PNCP
  const linkPncp = (id) => { const m = /^(\d{14})-\d-0*(\d+)\/(\d{4})$/.exec(id || ""); return m ? `https://pncp.gov.br/app/contratos/${m[1]}/${m[3]}/${m[2]}` : null; };

  let conn;
  /** O painel de carregamento: o passo atual e uma barra em movimento, no lugar do resultado. */
  function etapa(n, texto) {
    saida.hidden = false;
    saida.innerHTML = `<div class="carregando" role="status" aria-live="polite">
      <div class="barra-carga" aria-hidden="true"><i></i></div>
      <p><strong>${esc(texto)}</strong></p>
      <p class="menor">Passo ${n} de 3. A primeira consulta baixa o motor de busca e a parte dos dados de que precisa; as seguintes são mais rápidas.</p>
    </div>`;
  }
  async function conectar() {
    etapa(1, "Preparando o motor de consulta…");
    const duckdb = await import("https://cdn.jsdelivr.net/npm/@duckdb/duckdb-wasm@1.29.0/+esm");
    const bundle = await duckdb.selectBundle(duckdb.getJsDelivrBundles());
    const url = URL.createObjectURL(new Blob([`importScripts("${bundle.mainWorker}");`], { type: "text/javascript" }));
    const db = new duckdb.AsyncDuckDB(new duckdb.VoidLogger(), new Worker(url));
    await db.instantiate(bundle.mainModule, bundle.pthreadWorker);
    URL.revokeObjectURL(url);
    conn = await db.connect();
    await conn.query(`CREATE VIEW c AS SELECT * FROM read_parquet('${ARQ}')`);
  }
  const consulta = async (sql, valores = []) => {
    const stmt = await conn.prepare(sql);
    const t = await stmt.query(...valores);
    await stmt.close();
    return t.toArray().map((l) => l.toJSON());
  };

  /** O WHERE da busca, com os valores à parte (nada do que a pessoa digita entra no SQL). */
  function filtros() {
    const onde = [], v = [];
    const q = (params.get("q") || "").trim();
    if (q) {
      const termos = q.split(/\s+ou\s+|,/i).map((t) => sem(t.trim())).filter(Boolean);
      const partes = termos.map((t) => {
        if (/^\d{8,14}$/.test(t.replace(/\D/g, "")) && t.replace(/\D/g, "").length >= 8) { v.push(t.replace(/\D/g, "").slice(0, 8) + "%"); return "cnpj LIKE ?"; }
        v.push(`%${t}%`, `%${t}%`);
        return "(strip_accents(lower(objeto)) LIKE ? OR strip_accents(lower(fornecedor)) LIKE ?)";
      });
      if (partes.length) onde.push(`(${partes.join(" OR ")})`);
    }
    for (const [k, col] of [["uf", "uf"], ["esfera", "esfera"], ["tipo", "tipo"], ["ente", "ente"]]) {
      const x = params.get(k); if (x) { onde.push(`${col} = ?`); v.push(x); }
    }
    // Um estado inteiro é o governo e as prefeituras: os órgãos federais com sede nele ficam de fora.
    if (params.get("uf") && !params.get("ente")) onde.push("esfera <> 'Governo federal'");
    // Um órgão federal (o Exército, o DNIT…): não tem código de ente, vai pelo nome.
    if (params.get("orgao")) { onde.push("esfera = 'Governo federal' AND quem = ?"); v.push(params.get("orgao")); }
    const min = Number(params.get("min")); if (min > 0) { onde.push("valor >= ?"); v.push(min); }
    return { where: onde.length ? `WHERE ${onde.join(" AND ")}` : "", v };
  }

  async function iniciar() {
    document.querySelector("[data-inicio]")?.setAttribute("hidden", "");
    // Enquanto consulta: a busca fica travada e o título já mostra o lugar escolhido.
    form.inert = true;
    form.classList.add("travado");
    if (params.get("ente") || params.get("uf")) topo("Carregando…", "", "Contratos");   // na hora, sem esperar a lista de cidades
    if (params.get("ente")) carregarLugares().then((l) => { const r = l.porCodigo.get(params.get("ente")); if (r) topo(r.rotulo, "Carregando os contratos…", "Contratos"); });
    if (params.get("empresa")) topo("Procurando a empresa…", "", "Empresa");
    try {
      await conectar();
      if (params.get("empresa")) await empresa();
      else await busca();
    } catch (erro) {
      saida.innerHTML = `<p class="erro">Não foi possível consultar os contratos agora (${esc(erro.message || erro)}). Tente de novo em instantes.</p>`;
    } finally {
      form.inert = false;
      form.classList.remove("travado");
    }
  }

  /** Quem contratou, com link: a prefeitura ou o governo pelo código; o órgão federal pelo nome. */
  const linkQuem = (ente, quem) => `<a href="/contratos?${ente ? `ente=${esc(ente)}` : `orgao=${esc(encodeURIComponent(quem))}`}">${esc(quem)}</a>`;

  const linhaContrato = (x, total) => {
    const pncp = linkPncp(x.id);
    return `<div class="linha" role="row">
      <span role="cell" class="quem">${linkQuem(x.ente, x.quem)}<small>${esc(x.uf)}</small></span>
      <span role="cell">${esc(frase(x.objeto)) || "Sem descrição"}${x.teto ? `<small class="aviso">Valor máximo estimado (credenciamento)</small>` : ""}${pncp ? ` <a class="pncp" href="${pncp}" rel="noopener">ver no PNCP</a>` : ""}</span>
      <span role="cell">${x.pessoa === "PJ" && x.cnpj ? `<a href="/contratos?empresa=${esc(x.cnpj.slice(0, 8))}">${esc(titulo(x.fornecedor))}</a>` : `${esc(titulo(x.fornecedor))}<small>pessoa física</small>`}</span>
      <span role="cell" class="d">${mes(x.data)}</span>
      <span role="cell" class="d"><strong>${curto(x.valor)}</strong>${total ? `<small title="Fatia deste contrato no valor de todos os encontrados">${fatia(x.valor, total)} do total</small>` : ""}</span>
    </div>`;
  };

  async function busca() {
    const filtro = filtros();
    etapa(2, params.get("q") ? "Procurando nos contratos…" : "Lendo os contratos…");
    // O arquivo é lido uma vez; trocar o agrupamento ou ver mais linhas consulta só o que foi achado.
    await consulta(`CREATE OR REPLACE TEMP TABLE r AS SELECT * FROM c ${filtro.where}`, filtro.v);
    etapa(3, "Organizando o resultado…");
    const where = "", v = [];
    const [s] = await consulta(`SELECT count(*)::INTEGER AS n, coalesce(sum(valor), 0) AS valor, count(DISTINCT coalesce(nullif(ente, ''), quem))::INTEGER AS lugares, count(DISTINCT fornecedor)::INTEGER AS fornecedores FROM r`);
    trilha.passo({ valor: `${curto(s.valor)} · ${s.n === 1 ? "1 contrato" : `${nf0.format(s.n)} contratos`}`, v: s.valor, base: "contratos", ano: raiz.dataset.ano });
    const ente = params.get("ente");
    const orgao = params.get("orgao");
    const outros = ["q", "esfera", "tipo", "min"].some((k) => params.get(k)) || (!!ente && !!params.get("uf"));
    let titulo_ = "Contratos encontrados";
    // Um estado inteiro (o governo e as prefeituras): ?uf=
    const ufp = !ente && params.get("uf");
    if (ufp) {
      const l = (await carregarLugares()).porSigla.get(ufp);
      if (l) {
        topo(l.nome, outros
          ? `Contratos do governo e das prefeituras do estado assinados em ${raiz.dataset.ano}, com os filtros escolhidos abaixo.`
          : `Os contratos que o governo e as prefeituras do estado assinaram em ${raiz.dataset.ano} e publicaram no Portal Nacional de Contratações Públicas.`,
          "Governo e prefeituras do estado");
        titulo_ = outros ? "Com estes filtros" : "Todos os contratos";
      }
    }
    if (ente) {
      const [q] = await consulta(`SELECT quem FROM c WHERE ente = ? LIMIT 1`, [ente]);
      const quem = q?.quem || (await carregarLugares()).porCodigo.get(ente)?.rotulo || "Este lugar";
      topo(quem, outros
        ? `Contratos ${quem.startsWith("Governo") ? "do governo" : "da prefeitura"} assinados em ${raiz.dataset.ano}, com os filtros escolhidos abaixo.`
        : `Os contratos que ${quem.startsWith("Governo") ? "o governo" : "a prefeitura"} assinou em ${raiz.dataset.ano} e publicou no Portal Nacional de Contratações Públicas. Procure dentro deles pelo que foi comprado ou pela empresa.`,
        quem.startsWith("Governo") ? "Contratos do governo estadual" : "Contratos da prefeitura");
      titulo_ = outros ? "Com estes filtros" : "Todos os contratos";
    }
    if (orgao) {
      topo(orgao, outros
        ? `Contratos do órgão assinados em ${raiz.dataset.ano}, com os filtros escolhidos abaixo.`
        : `Os contratos que o órgão assinou em ${raiz.dataset.ano} e publicou no Portal Nacional de Contratações Públicas, em todas as suas unidades. Procure dentro deles pelo que foi comprado ou pela empresa.`,
        "Contratos do governo federal");
      titulo_ = outros ? "Com estes filtros" : "Todos os contratos";
    }
    let por = "contrato", pagina = 0;
    /** Quanto do dinheiro fica com os maiores: os contratos, os fornecedores ou os lugares. */
    const concentracao = async () => {
      if (!s.n || !(s.valor > 0)) return "";
      const grupo = por === "contrato" ? "SELECT valor FROM r" : `SELECT sum(valor) AS valor FROM r GROUP BY ${por === "lugar" ? "quem" : "fornecedor"}`;
      const [c] = await consulta(`WITH g AS (${grupo}), o AS (SELECT valor, row_number() OVER (ORDER BY valor DESC) AS i FROM g)
        SELECT count(*)::INTEGER AS n, sum(valor) FILTER (WHERE i = 1) AS t1, sum(valor) FILTER (WHERE i <= 3) AS t3, sum(valor) FILTER (WHERE i <= 10) AS t10 FROM o`);
      const pc = (v) => `<strong>${fatia(v, s.valor)}</strong>`;
      if (por === "contrato") {
        if (c.n <= 10) return "";
        return `Os 10 maiores contratos, de ${nf0.format(c.n)}, ficam com ${pc(c.t10)} do valor.${c.t1 / s.valor >= 0.1 ? ` Só o maior é ${pc(c.t1)}.` : ""}`;
      }
      if (c.n <= 3) return "";
      const quem = por === "lugar" ? ["lugares que mais contrataram", "lugares"] : ["maiores fornecedores", "fornecedores"];
      return `Os 3 ${quem[0]}, de ${nf0.format(c.n)} ${quem[1]}, ficam com ${pc(c.t3)} do valor${c.n > 10 ? `; os 10 maiores, com ${pc(c.t10)}` : ""}.`;
    };
    const desenhar = async () => {
      let corpo;
      const frase_ = await concentracao();
      if (por === "contrato") {
        const l = await consulta(`SELECT id, quem, ente, uf, objeto, fornecedor, pessoa, cnpj, data, valor, teto FROM r ORDER BY valor DESC LIMIT 50 OFFSET ${pagina * 50}`);
        corpo = `<div class="tabela" role="table" aria-label="Contratos"><div class="linha cab" role="row"><span role="columnheader">Quem contratou</span><span role="columnheader">O que foi contratado</span><span role="columnheader">Fornecedor</span><span role="columnheader" class="d">Data</span><span role="columnheader" class="d">Valor</span></div>${l.map((x) => linhaContrato(x, s.valor)).join("")}</div>
          <div class="pe"><span>Mostrando ${nf0.format(Math.min(s.n, (pagina + 1) * 50))} de ${nf0.format(s.n)}, do maior para o menor valor.</span>${(pagina + 1) * 50 < s.n ? `<button type="button" data-mais>Mostrar mais</button>` : ""}</div>`;
      } else {
        const col = por === "lugar" ? "quem" : "fornecedor";
        const l = await consulta(`SELECT ${col} AS nome, any_value(ente) AS ente, any_value(cnpj) AS cnpj, any_value(pessoa) AS pessoa, count(*)::INTEGER AS n, sum(valor) AS valor FROM r GROUP BY ${col} ORDER BY valor DESC LIMIT 100`);
        corpo = `<ol class="lista">${l.map((x) => `<li><span>${por === "lugar"
          ? linkQuem(x.ente, x.nome)
          : (x.pessoa === "PJ" && x.cnpj ? `<a href="/contratos?empresa=${esc(x.cnpj.slice(0, 8))}">${esc(titulo(x.nome))}</a>` : esc(titulo(x.nome)))}</span><span>${x.n === 1 ? "1 contrato" : `${nf0.format(x.n)} contratos`} · ${curto(x.valor)}</span><span class="fatia" title="Fatia no valor de todos os contratos encontrados"><i style="width:${Math.max(1, (x.valor / (l[0].valor || 1)) * 70)}px"></i><b>${fatia(x.valor, s.valor)}</b></span></li>`).join("")}</ol>`;
      }
      saida.innerHTML = `
        <h2>${esc(titulo_)}</h2>
        <div class="numeros"><div><span>Contratos</span><strong>${nf0.format(s.n)}</strong></div><div><span>Somam</span><strong>${curto(s.valor)}</strong></div>${ente || orgao ? `<div><span>Fornecedores</span><strong>${nf0.format(s.fornecedores)}</strong></div>` : `<div><span>Em</span><strong>${nf0.format(s.lugares)} ${params.get("esfera") === "Governo federal" ? (s.lugares === 1 ? "órgão" : "órgãos") : s.lugares === 1 ? "lugar" : "lugares"}</strong></div>`}</div>
        ${s.n ? `<div class="agrupar"><span>Agrupar por:</span>${[["contrato", "Contrato"], ["lugar", "Quem contratou"], ["empresa", "Fornecedor"]].map(([k, t]) => `<button type="button" data-por="${k}" aria-pressed="${por === k}">${t}</button>`).join("")}<span class="espaco"></span><button type="button" class="link" data-csv>Baixar estes contratos (planilha)</button></div>${frase_ ? `<p class="concentracao">${frase_}</p>` : ""}${corpo}` : `<div class="vazio"><p><strong>Nenhum contrato com esses filtros.</strong></p><p class="menor">Tente outras palavras: cada prefeitura descreve o contrato do seu jeito (“resíduos” ou “limpeza urbana” em vez de “lixo”, por exemplo). Ou tire um filtro, ou procure em todo o Brasil.</p></div>`}
        <p class="menor">A busca procura as palavras no texto do contrato e no nome do fornecedor, com e sem acento; separe alternativas com “ou”. Contratos descritos de outro jeito podem ficar de fora.</p>`;
      saida.querySelectorAll("[data-por]").forEach((b) => b.addEventListener("click", () => { por = b.dataset.por; pagina = 0; desenhar(); }));
      saida.querySelector("[data-mais]")?.addEventListener("click", () => { pagina += 1; desenhar(); });
      saida.querySelector("[data-csv]")?.addEventListener("click", baixarCsv);
    };
    await desenhar();
  }

  async function baixarCsv() {
    const l = await consulta(`SELECT quem AS contratante, uf, objeto, fornecedor, CASE WHEN pessoa = 'PJ' THEN cnpj ELSE '' END AS cnpj, tipo, data, valor, id AS controle_pncp FROM ${params.get("empresa") ? "e" : "r"} ORDER BY valor DESC LIMIT 100000`);
    const cols = Object.keys(l[0] || { contratante: "" });
    const cel = (x) => { const s = x instanceof Date ? x.toISOString().slice(0, 10) : String(x ?? ""); return /[";\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s; };
    const csv = "﻿" + [cols.join(";"), ...l.map((x) => cols.map((k) => cel(x[k])).join(";"))].join("\n");
    const a = Object.assign(document.createElement("a"), { href: URL.createObjectURL(new Blob([csv], { type: "text/csv;charset=utf-8" })), download: "contratos.csv" });
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  }

  async function empresa() {
    const raizCnpj0 = (params.get("empresa") || "").replace(/\D/g, "").slice(0, 8).padStart(8, "0");
    etapa(2, "Procurando os contratos da empresa…");
    // A cópia por CNPJ está ordenada: a faixa [raiz, raiz + 1) fica em poucos blocos do arquivo.
    const ate = String(Number(raizCnpj0) + 1).padStart(8, "0");
    await consulta(`CREATE OR REPLACE TEMP TABLE e AS SELECT * FROM read_parquet('${POR_CNPJ}') WHERE cnpj >= ? AND cnpj < ?`, [raizCnpj0, ate]);
    const where = "", v = [];
    const [s] = await consulta(`SELECT mode(fornecedor) AS nome, any_value(cnpj) AS cnpj, count(*)::INTEGER AS n, sum(valor) AS valor, count(DISTINCT coalesce(nullif(ente, ''), quem))::INTEGER AS lugares FROM e`);
    if (!s.n) { saida.innerHTML = `<p>Nenhum contrato dessa empresa em ${raiz.dataset.ano}.</p>`; return; }
    const ufs = await consulta(`SELECT uf, sum(valor) AS valor FROM e GROUP BY uf ORDER BY valor DESC LIMIT 10`);
    const quem = await consulta(`SELECT quem, any_value(ente) AS ente, count(*)::INTEGER AS n, sum(valor) AS valor FROM e GROUP BY quem ORDER BY valor DESC LIMIT 10`);
    const contratos = await consulta(`SELECT id, quem, ente, uf, objeto, fornecedor, pessoa, cnpj, data, valor, teto FROM e ORDER BY valor DESC LIMIT 30`);
    const maior = ufs[0]?.valor || 1;
    trilha.passo({ valor: `${curto(s.valor)} · ${s.n === 1 ? "1 contrato" : `${nf0.format(s.n)} contratos`}`, v: s.valor, base: "contratos", ano: raiz.dataset.ano });
    const raizCnpj = (s.cnpj || "").slice(0, 8);
    topo(titulo(s.nome), `Em ${raiz.dataset.ano}, <strong>${nf0.format(s.lugares)} ${s.lugares === 1 ? "lugar" : "lugares"}</strong> assinaram com ela <strong>${nf0.format(s.n)} ${s.n === 1 ? "contrato" : "contratos"}</strong>, que somam ${curto(s.valor)}.`,
      `Empresa · CNPJ ${raizCnpj.replace(/^(\d{2})(\d{3})(\d{3})$/, "$1.$2.$3")}`);
    saida.innerHTML = `
      <div class="duas">
        <section><h3>Por estado</h3><ol class="barras">${ufs.map((x) => `<li><span>${esc(x.uf)}</span><i style="width:${(x.valor / maior) * 100}%"></i><strong>${curto(x.valor)}</strong></li>`).join("")}</ol></section>
        <section><h3>Quem mais contratou</h3><ol class="lista">${quem.map((x) => `<li><span>${linkQuem(x.ente, x.quem)}</span><span>${nf0.format(x.n)} · ${curto(x.valor)}</span></li>`).join("")}</ol></section>
      </div>
      <h3>Os maiores contratos</h3>
      <div class="tabela" role="table" aria-label="Contratos da empresa"><div class="linha cab" role="row"><span role="columnheader">Quem contratou</span><span role="columnheader">O que foi contratado</span><span role="columnheader">Fornecedor</span><span role="columnheader" class="d">Data</span><span role="columnheader" class="d">Valor</span></div>${contratos.map((x) => linhaContrato(x, s.valor)).join("")}</div>
      <p class="menor">Uma empresa contratada por muitos lugares não é sinal de problema: distribuidores de remédios e material hospitalar vencem pregões em centenas de cidades. Filiais da mesma empresa (a mesma raiz de CNPJ) aparecem juntas.</p>`;
  }
  // Por último: a busca usa as funções acima.
  if (ARQ && pergunta && saida) iniciar();
</script>

