---
/**
 * Quem publica onde gasta: os 27 estados pela transparência do gasto em cada município
 * (o governo do estado) e dos pagamentos das prefeituras (o Tribunal de Contas).
 * Os dados ficam em lib/quem-publica.ts.
 */
import Base from "../layouts/Base.astro";
import { caminhoEstado, deUf, NOMES_UF } from "../lib/cidades";
import { FAIXAS, PESQUISA, PREFEITURAS, QUEM_PUBLICA, porFaixa, type Estado } from "../lib/quem-publica";

const REPO = "https://github.com/guilhermeprokisch/orcamento-brasileiro/blob/main/docs";

// Grade com a forma aproximada do país: [sigla, coluna, linha].
const GRADE: [string, number, number][] = [
  ["RR", 2, 1], ["AP", 4, 1],
  ["AM", 2, 2], ["PA", 3, 2], ["MA", 4, 2], ["CE", 5, 2], ["RN", 6, 2],
  ["AC", 1, 3], ["RO", 2, 3], ["TO", 3, 3], ["PI", 4, 3], ["PE", 5, 3], ["PB", 6, 3],
  ["MT", 2, 4], ["GO", 3, 4], ["BA", 4, 4], ["SE", 5, 4], ["AL", 6, 4],
  ["MS", 2, 5], ["DF", 3, 5], ["MG", 4, 5], ["ES", 5, 5],
  ["PR", 2, 6], ["SP", 3, 6], ["RJ", 4, 6],
  ["SC", 2, 7],
  ["RS", 2, 8],
];
const por = new Map(QUEM_PUBLICA.map((e) => [e.uf, e]));
const nInteiro = porFaixa("inteiro").length;
const nPrefeituras = QUEM_PUBLICA.filter((e) => e.prefeituras.situacao === "sim").length;
const noSiteEstado = QUEM_PUBLICA.filter((e) => e.noSite).map((e) => deUf(e.uf));
const noSitePref = QUEM_PUBLICA.filter((e) => e.prefeituras.noSite).map((e) => deUf(e.uf));
const lista = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(", ")} e ${xs.at(-1)}` : xs[0] ?? "");

const mapas: { id: string; titulo: string; classe: (e: Estado) => string; noSite: (e: Estado) => boolean; legenda: { classe: string; nome: string; n: number }[] }[] = [
  {
    id: "estado", titulo: "O governo do estado publica quanto gasta em cada cidade?",
    classe: (e) => `f-${e.faixa}`, noSite: (e) => !!e.noSite,
    legenda: FAIXAS.map((f) => ({ classe: `f-${f.id}`, nome: f.curto, n: porFaixa(f.id).length })),
  },
  {
    id: "prefeituras", titulo: "O Tribunal de Contas publica os pagamentos de todas as prefeituras?",
    classe: (e) => `p-${e.prefeituras.situacao}`, noSite: (e) => !!e.prefeituras.noSite,
    legenda: PREFEITURAS.map((p) => ({ classe: `p-${p.id}`, nome: p.nome, n: QUEM_PUBLICA.filter((e) => e.prefeituras.situacao === p.id).length })),
  },
];
---

<Base title="Quem publica onde gasta · Orçamento Brasileiro" description="Quais estados publicam quanto gastam em cada cidade, e quais Tribunais de Contas publicam os pagamentos das prefeituras.">
  <div class="wrap">
    <section class="topo">
      <span class="sobretitulo">Pesquisa de {PESQUISA.texto}</span>
      <h1>Quem publica onde gasta</h1>
      <p>
        O governo do estado paga escolas, hospitais, polícia e estradas em todas as cidades. Mas só {nInteiro} dos 27
        publicam quanto gastaram em cada município: a Paraíba e Minas Gerais. Nos outros, não dá para saber, ou só se vê
        uma parte.
      </p>
      <p class="menor">
        Esta página mostra o que cada estado publica e onde. Ela também diz se o Tribunal de Contas do estado publica para quem
        cada prefeitura pagou: {nPrefeituras} publicam, com o nome de quem recebeu.
      </p>
    </section>

    <section class="bloco mapas" aria-label="Os 27 estados">
      {mapas.map((m) => (
        <figure class="mapa">
          <figcaption>{m.titulo}</figcaption>
          <div class="grade">
            {GRADE.map(([uf, c, l]) => {
              const e = por.get(uf)!;
              return (
                <a href={`#${uf.toLowerCase()}`} class:list={["uf", m.classe(e), { "no-site": m.noSite(e) }]} style={`grid-column:${c};grid-row:${l}`}
                  title={`${NOMES_UF[uf]}${m.noSite(e) ? " (já no site)" : ""}`}>
                  {uf}
                </a>
              );
            })}
          </div>
          <ul class="legenda">
            {m.legenda.filter((x) => x.n).map((x) => (
              <li><span class:list={["amostra", x.classe]}></span>{x.nome} <span class="n">{x.n}</span></li>
            ))}
            <li><span class="amostra ponto"></span>O site já usa</li>
          </ul>
        </figure>
      ))}
    </section>

    <p class="no-site-texto">
      O site já usa o gasto estadual por município {lista(noSiteEstado)}, na página de cada cidade, e os pagamentos das
      prefeituras {lista(noSitePref)}.
    </p>

    {FAIXAS.map((f) => {
      const estados = porFaixa(f.id);
      return (
        <section class="bloco faixa" id={f.id}>
          <div class="faixa-cab">
            <span class:list={["amostra grande", `f-${f.id}`]}></span>
            <h2>{f.nome} <span class="n">{estados.length}</span></h2>
          </div>
          <p>{f.explica}</p>
          <div class="estados">
            {estados.map((e) => {
              const p = PREFEITURAS.find((x) => x.id === e.prefeituras.situacao)!;
              return (
                <article class="estado" id={e.uf.toLowerCase()}>
                  <h3><a href={caminhoEstado(e.uf)}>{NOMES_UF[e.uf]}</a> <span class="sigla">{e.uf}</span></h3>
                  <dl>
                    <div>
                      <dt>Governo do estado {e.noSite && <span class="selo">no site</span>}</dt>
                      <dd>
                        {e.publica}
                        {e.falta && <> <span class="falta">{e.falta}</span></>}
                        {e.fonte.url && <> <a class="fonte" href={e.fonte.url} rel="noopener">{e.fonte.nome}</a></>}
                      </dd>
                    </div>
                    <div>
                      <dt>
                        Prefeituras <span class:list={["tag", `p-${p.id}`]}>{p.nome}</span>
                        {e.prefeituras.noSite && <span class="selo">no site</span>}
                      </dt>
                      <dd>
                        {e.prefeituras.texto}
                        {e.prefeituras.fonte?.url
                          ? <> <a class="fonte" href={e.prefeituras.fonte.url} rel="noopener">{e.prefeituras.fonte.nome}</a></>
                          : e.prefeituras.fonte && <> <span class="fonte">{e.prefeituras.fonte.nome}</span></>}
                      </dd>
                    </div>
                  </dl>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="bloco">
      <h2>Como foi feita a pesquisa</h2>
      <ul class="cuidados">
        <li>
          <strong>O que procuramos.</strong> Para cada estado, em {PESQUISA.estado}, qualquer caminho até o gasto por cidade:
          a nota de cada gasto, a folha de pagamento com o local de trabalho, obras, convênios, o orçamento por região. Para
          cada Tribunal de Contas, em {PESQUISA.prefeituras}, se dá para baixar de uma vez, sem cadastro, o que cada
          prefeitura pagou e a quem.
        </li>
        <li>
          <strong>Não é o mesmo que os repasses.</strong> O que o estado manda para a prefeitura (a parte do ICMS e do IPVA,
          os convênios) já está no site para todas as cidades. O que falta é o que o estado gasta ele mesmo na cidade: a
          escola estadual, o hospital regional, a polícia.
        </li>
        <li>
          <strong>Quanto confiar.</strong> Paraíba e Minas Gerais foram conferidas baixando os dados e somando. Nos outros
          estados, os dados foram abertos e os campos vistos, mas o gasto ainda não foi somado. Um portal pode mudar, e um
          dado que não abriu pode existir.
        </li>
        <li>
          <strong>Pedidos de informação.</strong> Para o que não está publicado, mandamos pedidos pela Lei de Acesso à
          Informação aos tribunais que não publicam os pagamentos das prefeituras. O prazo de resposta vence em dezembro de 2026.
        </li>
        <li>
          <strong>Os detalhes</strong>, com os endereços de cada arquivo e o que foi conferido: <a href={`${REPO}/gasto-estadual-por-municipio.md`}>o gasto
          dos estados por município</a> e <a href={`${REPO}/levantamento-pagamentos-tce.md`}>os pagamentos das prefeituras</a>.
          Achou um dado que não está aqui? <a href="https://github.com/guilhermeprokisch/orcamento-brasileiro/issues">Conte para a gente</a>.
        </li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .topo { padding: 44px 0 28px; display: flex; flex-direction: column; gap: 12px; max-width: 820px; }
  .topo h1 { font-size: 60px; line-height: 1; letter-spacing: -0.025em; }
  .topo p { margin: 0; font-size: 20px; line-height: 1.55; color: var(--texto-2); }
  .topo p.menor { font-size: 16px; color: var(--texto-3); }
  .bloco { border-top: 2px solid var(--tinta); padding: 28px 0; display: flex; flex-direction: column; gap: 14px; }
  .bloco h2 { font-size: 30px; }
  .bloco > p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--texto-2); max-width: 820px; }

  /* cores das faixas (governo do estado) e das respostas (prefeituras) */
  .f-inteiro, .p-sim { background: #0a4a29; color: #ffffff; }
  .f-folha { background: #4fae73; color: var(--tinta); }
  .f-obras, .p-parte { background: #b3dfc4; color: var(--tinta); }
  .f-nada, .p-nao { background: var(--papel-escuro); color: var(--texto-3); box-shadow: inset 0 0 0 1px var(--regra); }
  .p-nao-se-aplica { background: transparent; color: var(--texto-4); box-shadow: inset 0 0 0 1px var(--regra); border: 1px dashed var(--regra); }

  .mapas { flex-direction: row; gap: 48px; flex-wrap: wrap; }
  .mapa { margin: 0; display: flex; flex-direction: column; gap: 14px; flex: 1 1 360px; max-width: 520px; }
  .mapa figcaption { font-family: var(--serifa); font-weight: 700; font-size: 20px; line-height: 1.3; letter-spacing: -0.01em; }
  .grade { display: grid; grid-template-columns: repeat(6, 52px); grid-template-rows: repeat(8, 44px); gap: 4px; }
  .uf {
    position: relative; display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 600; text-decoration: none; letter-spacing: 0.02em;
  }
  .uf:hover { outline: 2px solid var(--tinta); outline-offset: 1px; }
  .uf.f-inteiro:hover, .uf.p-sim:hover { color: #ffffff; }
  .uf.no-site::after, .amostra.ponto {
    content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--marca-texto);
    box-shadow: 0 0 0 1.5px var(--tinta);
  }
  .uf.no-site::after { position: absolute; top: 4px; right: 4px; }
  .legenda { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; color: var(--texto-2); }
  .legenda li { display: flex; align-items: center; gap: 6px; }
  .amostra { display: inline-block; width: 14px; height: 14px; flex: none; }
  .amostra.ponto { width: 9px; height: 9px; margin: 0 2.5px; }
  .n { color: var(--texto-3); font-variant-numeric: tabular-nums; }
  .no-site-texto { margin: 0 0 28px; font-size: 14px; color: var(--texto-3); max-width: 820px; }

  .faixa-cab { display: flex; align-items: center; gap: 12px; }
  .amostra.grande { width: 22px; height: 22px; }
  .faixa h2 .n { font-family: var(--sans); font-size: 18px; font-weight: 500; }
  .estados { display: flex; flex-direction: column; border-top: 1px solid var(--tinta); max-width: 980px; }
  .estado { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 20px; padding: 16px 0; border-bottom: 1px solid var(--regra); scroll-margin-top: 16px; }
  .estado:target { background: var(--marca-texto-fundo); }
  .estado h3 { font-size: 22px; line-height: 1.2; }
  .estado h3 a { color: var(--tinta); text-decoration: none; }
  .estado h3 a:hover { text-decoration: underline; }
  .sigla { font-family: var(--sans); font-size: 13px; font-weight: 500; color: var(--texto-3); }
  .estado dl { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .estado dt { font-size: 12px; color: var(--texto-3); text-transform: uppercase; letter-spacing: 0.06em; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .estado dd { margin: 2px 0 0; font-size: 15px; line-height: 1.5; color: var(--texto-2); }
  .falta { color: var(--texto-3); }
  .fonte { font-size: 14px; white-space: nowrap; }
  span.fonte { color: var(--texto-3); }
  .fonte::before { content: "Fonte: "; color: var(--texto-3); }
  .tag { padding: 1px 6px; font-size: 11px; letter-spacing: 0.04em; }
  .selo { padding: 1px 6px; font-size: 11px; letter-spacing: 0.04em; background: var(--marca-texto); color: var(--tinta); }

  .cuidados { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 16px; line-height: 1.55; color: var(--texto-2); max-width: 820px; }
  .cuidados strong { color: var(--tinta); }

  @media (max-width: 900px) {
    .topo { padding: 28px 0 20px; }
    .topo h1 { font-size: 38px; }
    .topo p { font-size: 17px; }
    .bloco h2 { font-size: 24px; }
    .mapas { gap: 32px; }
    .estado { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .fonte { white-space: normal; }
  }
  @media (max-width: 420px) {
    .grade { grid-template-columns: repeat(6, minmax(0, 1fr)); grid-template-rows: repeat(8, 38px); gap: 3px; }
    .uf { font-size: 13px; }
  }
</style>
