---
/**
 * PROTÓTIPO (rascunho para escolher, sai do site quando a página /impostos ficar pronta): três jeitos de contar o
 * caminho dos impostos, com os dados de verdade. A versão vem de ?v=1, ?v=2 ou ?v=3 (sem o parâmetro, a 1).
 */
import Base from "../layouts/Base.astro";
import VersaoRio from "../components/impostos/VersaoRio.astro";
import VersaoCem from "../components/impostos/VersaoCem.astro";
import VersaoRotas from "../components/impostos/VersaoRotas.astro";
import { docCaminho as doc } from "../lib/caminho-impostos";

const deixa = doc?.deixa?.uniao ? { uniao: doc.deixa.uniao.total, estados: doc.deixa.estados?.total ?? 0 } : null;
const VERSOES = [
  { v: "1", nome: "O rio", desc: "diagrama de fluxos montado ao rolar" },
  { v: "2", nome: "De cada R$ 100", desc: "100 quadradinhos que mudam de mão" },
  { v: "3", nome: "Siga o seu imposto", desc: "o dia a dia, imposto por imposto" },
];
---

<Base title="Protótipo: o caminho dos impostos · Orçamento Brasileiro" description="Rascunho de três versões da página sobre o caminho dos impostos.">
  <div class="faixa-prototipo">
    <div class="wrap">
      <strong>Protótipo</strong> para escolher a versão. Não é a página final.
      <nav aria-label="Versões">
        {VERSOES.map((x) => <a href={`?v=${x.v}`} data-v={x.v}><b>{x.v}.</b> {x.nome} <span>· {x.desc}</span></a>)}
      </nav>
    </div>
  </div>
  <div class="wrap">
    {!doc ? <p>Os dados do caminho dos impostos ainda não foram gerados (<code>uv run caminho-impostos</code>).</p> : (
      <>
        <div class="versao" data-versao="1"><VersaoRio doc={doc} deixa={deixa} /></div>
        <div class="versao" data-versao="2" hidden><VersaoCem doc={doc} deixa={deixa} /></div>
        <div class="versao" data-versao="3" hidden><VersaoRotas doc={doc} deixa={deixa} /></div>
      </>
    )}
  </div>
</Base>

<style>
  .faixa-prototipo { background: var(--marca-texto); border-bottom: 1px solid var(--tinta); font-size: 14px; }
  .faixa-prototipo .wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; padding-top: 10px; padding-bottom: 10px; }
  .faixa-prototipo nav { display: flex; flex-wrap: wrap; gap: 6px; }
  .faixa-prototipo a { padding: 4px 10px; border: 1px solid var(--tinta); color: var(--tinta); text-decoration: none; background: var(--papel); }
  .faixa-prototipo a[aria-current] { background: var(--tinta); color: var(--papel); }
  .faixa-prototipo a span { color: inherit; opacity: 0.7; }
  @media (max-width: 640px) { .faixa-prototipo a span { display: none; } }
</style>

<script>
  const v = new URLSearchParams(location.search).get("v") ?? "1";
  const existe = document.querySelector(`.versao[data-versao="${v}"]`);
  document.querySelectorAll<HTMLElement>(".versao").forEach((el) => (el.hidden = existe ? el.dataset.versao !== v : el.dataset.versao !== "1"));
  document.querySelectorAll<HTMLAnchorElement>(".faixa-prototipo a").forEach((a) => {
    if (a.dataset.v === (existe ? v : "1")) a.setAttribute("aria-current", "page");
  });
  // As versões escondidas medem errado o que está na tela; avisa quando a versão aparece.
  window.dispatchEvent(new Event("resize"));
</script>
