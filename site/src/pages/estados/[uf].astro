---
import Base from "../../layouts/Base.astro";
import AnoEmAndamento from "../../components/gasto/AnoEmAndamento.astro";
import Avisos from "../../components/gasto/Avisos.astro";
import DividaEstado from "../../components/gasto/DividaEstado.astro";
import PessoalResultado from "../../components/gasto/PessoalResultado.astro";
import PrevidenciaServidores from "../../components/gasto/PrevidenciaServidores.astro";
import SupersalariosEstado from "../../components/gasto/SupersalariosEstado.astro";
import IrMoradores from "../../components/gasto/IrMoradores.astro";
import SaiuVoltou from "../../components/gasto/SaiuVoltou.astro";
import EmendasResultado from "../../components/gasto/EmendasResultado.astro";
import ContratosResultado from "../../components/gasto/ContratosResultado.astro";
import NestaPagina, { type GrupoDaPagina } from "../../components/NestaPagina.astro";
import CapagNota from "../../components/gasto/CapagNota.astro";
import SaudeResultado from "../../components/gasto/SaudeResultado.astro";
import SegurancaEstado from "../../components/gasto/SegurancaEstado.astro";
import SaneamentoResultado from "../../components/gasto/SaneamentoResultado.astro";
import EducacaoEstado from "../../components/gasto/EducacaoEstado.astro";
import ObrasParadasEstado from "../../components/obras/ObrasParadasEstado.astro";
import { moedaCompleta, moedaCurta, moedaExtenso, pct } from "../../lib/formato";
import { fatorIpca, resumo } from "../../lib/perfis";
import { caminhoCidade, deUf, docCidades, docEstados, habitantes, NOMES_UF, porPessoa, type Cidade } from "../../lib/cidades";
import { anosDe, fichaDe, pacoteDe } from "../../lib/ficha";
import { estadoDe, faixaDe } from "../../lib/quem-publica";
import { areasHtml, contasHtml, fraseHtml, numerosHtml, type Contexto } from "../../lib/ficha-html";
import type { BaseDaPagina } from "../../lib/troca-de-ano";
import "../../styles/ficha.css";
import Seguir from "../../components/Seguir.astro";

export function getStaticPaths() {
  return (docEstados?.cidades ?? []).map((e) => ({ params: { uf: e.uf.toLowerCase() }, props: { e } }));
}

const { e } = Astro.props as { e: Cidade };
const doc = docEstados!;
const temDados = e.ano !== null && !!e.total;
const ehDF = e.ibge === 53;
const nome = NOMES_UF[e.uf] ?? e.nome;
const noEstado = ehDF ? "no Distrito Federal" : deUf(e.uf).replace(/^(do|da|de) /, (x) => ({ "do ": "no ", "da ": "na ", "de ": "em " })[x] ?? x);
const quem = ehDF ? "o Governo do Distrito Federal" : `o governo ${deUf(e.uf)}`;

// Em que faixa da página "Quem publica onde gasta" o estado está.
const publica = estadoDe(e.uf);
const quemMaiusculo = quem.charAt(0).toUpperCase() + quem.slice(1);

const [emp] = e.total ?? [0, 0];
const perCapita = temDados ? emp / e.pop : 0;

// As partes que mudam com o ano: montadas aqui com o ano mais recente e, no navegador, com o ano escolhido.
const onde = ehDF ? "no Distrito Federal" : "no estado";
const destaques = [{ cod: "10", titulo: "Saúde" }, { cod: "12", titulo: "Educação" }, { cod: "06", titulo: "Segurança" }];
const ficha = temDados ? await fichaDe(e, "uf", e.ano!) : null;
const pacote = temDados ? await pacoteDe("uf", e.ano!) : null;
const ctx: Contexto | null = ficha && pacote ? { ano: e.ano!, esfera: "uf", ibge: e.ibge, nome, uf: e.uf, quem, onde, destaques, ficha, pacote } : null;
const anos = anosDe(e);
const base: BaseDaPagina | null = ctx
  ? { ibge: e.ibge, nome, uf: e.uf, esfera: "uf", quem, onde, destaques, anos, padrao: e.ano!, grupo: "estados" }
  : null;

// Evolução: total empenhado de cada ano, corrigido pelo IPCA (mesma base do resto do site).
const baseIpca = resumo?.ipca?.base ?? null;
const serie = Object.entries(e.hist ?? {})
  .map(([ano, v]) => ({ ano: Number(ano), nominal: v, real: v * fatorIpca(Number(ano)) }))
  .sort((a, b) => a.ano - b.ano);
const maxSerie = Math.max(1, ...serie.map((p) => p.real));
const crescimento = serie.length > 1 ? serie.at(-1)!.real / serie[0].real - 1 : null;

// Municípios do estado, do maior para o menor.
const LIMITE = 15;
const cidades = ehDF ? [] : (docCidades?.cidades ?? []).filter((c) => c.uf === e.uf).sort((a, b) => b.pop - a.pop);
// A lista "Nesta página": os grupos na ordem em que aparecem; um item sem conteúdo some no navegador.
const SUMARIO: GrupoDaPagina[] = [
  { id: "em-que-gasta", n: 1, titulo: "Em que gasta", itens: [["areas", "Para onde vai o dinheiro"], ["com-o-que", "Com o quê gasta"], ["contratos", "Os contratos"], ["evolucao", "Ao longo dos anos"]] },
  { id: "contas", n: 2, titulo: "As contas fecham", itens: [["receitas", "De onde vem o dinheiro, o que sobrou e o que deve"], ["divida", "A dívida frente ao limite"], ["pessoal", "O gasto com pessoal"], ["previdencia", "A aposentadoria dos servidores"], ["teto", "Juízes e promotores acima do teto"], ["capag", "A nota do Tesouro"], ["ano-atual", "O ano em andamento"]] },
  { id: "chega-e-sai", n: 3, titulo: "O que chega e o que sai daqui", itens: [["saiu-voltou", "Saiu daqui, voltou"], ["beneficios", "Aposentadorias e benefícios"], ["ir", "Imposto de renda dos moradores"], ["emendas", "Emendas parlamentares"], ["obras-paradas", "Obras federais paradas"]] },
  { id: "como-esta", n: 4, titulo: ehDF ? "Como está o Distrito Federal" : "Como está o estado", itens: [["educacao", "Educação: gasto por aluno"], ["saude", "Saúde: mortalidade infantil"], ["seguranca", "Segurança: homicídios"], ["saneamento", "Saneamento: água e esgoto"]] },
  ...(cidades.length ? [{ id: "grupo-cidades", n: 5, titulo: `As cidades ${deUf(e.uf)}`, itens: [["cidades", "As cidades"]] as [string, string][] }] : []),
];
const ph = (c: Cidade, f: string) => (c.f?.[f]?.[0] ?? 0) / c.pop;
const descricao = temDados
  ? `Quanto ${quem} gastou em ${e.ano}: ${moedaExtenso(emp)}, ${porPessoa(perCapita)} por morador, por área.`
  : `Gastos do governo ${deUf(e.uf)}.`;
---

<Base title={`${nome} · Orçamento Brasileiro`} description={descricao}>
  <div class="wrap">
    <nav aria-label="Caminho" class="caminho">
      <a href="/estados">Estados</a><span aria-hidden="true">/</span><span>{nome}</span>
    </nav>

    <section class="cabeca">
      <div>
        <span class="sobretitulo">{ehDF ? "Distrito Federal" : "Governo estadual"} · {habitantes(e.pop)}</span>
        <h1>{nome}</h1>
        {ctx ? (
          <>
            <div class="topo-acoes">
              {anos.length > 1 && (
                <label class="escolha-ano">Ano das contas
                  <select id="ano-ficha">{anos.map((a) => <option value={a} selected={a === e.ano}>{a}</option>)}</select>
                  <small>{anos.at(-1)} a {anos[0]}</small>
                </label>
              )}
              <a class="comparar-com" href={`/comparar?a=${e.ibge}`}><span aria-hidden="true">⇄</span> Comparar com outro estado</a>
              <Seguir nome={ehDF ? "o Distrito Federal" : nome} alvos={[{ alvo: `uf-${e.uf}`, nome, papel: ehDF ? "o governo do DF" : "o governo do estado", marcado: true }]} />
            </div>
            <div class="ficha" data-parte="frase" set:html={fraseHtml(ctx)} />
          </>
        ) : (
          <p>O estado não entregou ao Tesouro a prestação de contas anual de nenhum ano entre {doc.anos[0]} e {doc.anos.at(-1)}.</p>
        )}
        {publica && (
          <p class="quem-publica">
            {quemMaiusculo} {ehDF ? faixaDe(publica.faixa).frase.replace("cada município", "cada região administrativa") : faixaDe(publica.faixa).frase}{publica.noSite ? `, e o site mostra ${publica.faixa === "folha" ? "essa folha" : "esse gasto"} na página de cada cidade` : ""}.{" "}
            <a href={`/quem-publica#${e.uf.toLowerCase()}`}>Quem publica onde gasta</a>
          </p>
        )}
      </div>
    </section>

    {ctx && <div class="ficha" data-parte="numeros" set:html={numerosHtml(ctx)} />}
    {ctx && <p class="aviso-ano" id="aviso-ano" hidden></p>}
    {ctx && <Avisos ibge={e.ibge} esfera="uf" quem={quem} />}
    {ctx && <NestaPagina grupos={SUMARIO} />}

    {ctx && <p class="grupo-pagina" id="em-que-gasta" data-grupo="em-que-gasta">1 · Em que gasta</p>}
    {ctx && <div class="ficha" id="areas" data-parte="areas" set:html={areasHtml(ctx)} />}
    {ctx && <div class="ficha" id="com-o-que" data-parte="natureza" set:html={contasHtml(ctx, "natureza")} />}
    {temDados && <div id="contratos" data-so-padrao="os contratos"><ContratosResultado cidade={e} esfera="uf" quem={quem} /></div>}
    <div id="evolucao">
    {serie.length > 2 && (
      <section class="evolucao">
        <div class="evolucao-texto">
          <h2>Ao longo dos anos</h2>
          <p>
            Gasto empenhado de cada ano{baseIpca && <>, em reais de {baseIpca} (corrigido pelo IPCA)</>}.
            {crescimento !== null && (
              <> De {serie[0].ano} a {serie.at(-1)!.ano}, o gasto {crescimento >= 0 ? "cresceu" : "caiu"} <strong>{pct(Math.abs(crescimento))}</strong> acima da inflação.</>
            )}
          </p>
        </div>
        <ol class="anos">
          {serie.map((p) => (
            <li data-ano={p.ano} class:list={{ atual: p.ano === e.ano }} title={`${moedaCompleta(p.nominal)} em valores da época`}>
              <span class="num ano">{p.ano}</span>
              <span class="trilho"><span style={`width:${(p.real / maxSerie) * 100}%`}></span></span>
              <strong class="num">{moedaCurta(p.real)}</strong>
            </li>
          ))}
        </ol>
      </section>
    )}
    </div>

    {ctx && <p class="grupo-pagina" id="contas" data-grupo="contas">2 · As contas fecham</p>}
    {ctx && <div class="ficha" id="receitas" data-parte="receitas" set:html={contasHtml(ctx, "receitas")} />}
    <div id="divida"><DividaEstado ibge={e.ibge} quem={quem} ano={e.ano} /></div>
    <div id="pessoal"><PessoalResultado ibge={e.ibge} quem={quem} ano={e.ano} grupo={ehDF ? null : "dos estados"} /></div>
    <div id="previdencia" data-so-padrao="a aposentadoria dos servidores"><PrevidenciaServidores ibge={e.ibge} esfera="uf" quem={quem} grupo={ehDF ? null : "dos estados"} /></div>
    <div id="teto" data-so-padrao="os salários acima do teto"><SupersalariosEstado uf={e.uf} ente={e} /></div>
    <div id="capag"><CapagNota ente={e} esfera="uf" quem={quem} grupo="dos estados" /></div>
    {temDados && <div id="ano-atual"><AnoEmAndamento ente={e} esfera="uf" quem={quem} /></div>}

    {ctx && <p class="grupo-pagina" id="chega-e-sai" data-grupo="chega-e-sai">3 · O que chega e o que sai daqui</p>}
    <div id="saiu-voltou" data-so-padrao="o saiu daqui, voltou"><SaiuVoltou esfera="uf" chave={e.uf} deOnde={ehDF ? "do Distrito Federal" : deUf(e.uf)} onde={noEstado} /></div>
    {ctx && <div class="ficha" id="beneficios" data-parte="inss" set:html={contasHtml(ctx, "inss")} />}
    {temDados && <div id="ir" data-so-padrao="o imposto de renda dos moradores"><IrMoradores cidade={e} esfera="uf" deOnde={ehDF ? "do Distrito Federal" : deUf(e.uf)} grupo={ehDF ? null : "dos estados"} /></div>}
    {temDados && <div id="emendas" data-so-padrao="as emendas parlamentares"><EmendasResultado ente={e} esfera="uf" paraOnde={ehDF ? "para o Distrito Federal" : `para ${deUf(e.uf).replace(/^(do|da|de) /, (x) => ({ "do ": "o ", "da ": "a ", "de ": "" })[x] ?? x)}`} grupo={ehDF ? null : "dos estados"} /></div>}
    <div id="obras-paradas" data-so-padrao="as obras federais paradas"><ObrasParadasEstado uf={e.uf} /></div>

    {temDados && <p class="grupo-pagina" id="como-esta" data-grupo="como-esta">4 · Como está {ehDF ? "o Distrito Federal" : "o estado"}</p>}
    {temDados && <div id="educacao" data-so-padrao="o gasto por aluno"><EducacaoEstado estado={e} quem={quem} /></div>}
    {temDados && <div id="saude" data-so-padrao="a mortalidade infantil"><SaudeResultado ente={e} esfera="uf" quem={quem} grupo={ehDF ? null : "dos estados"} onde={noEstado} /></div>}
    {temDados && <div id="seguranca" data-so-padrao="os homicídios"><SegurancaEstado estado={e} quem={quem} onde={noEstado} /></div>}
    {temDados && <div id="saneamento" data-so-padrao="a água e o esgoto"><SaneamentoResultado ente={e} esfera="uf" quem={quem} grupo={ehDF ? null : "dos estados"} onde={noEstado} /></div>}

    {cidades.length > 0 && <p class="grupo-pagina" id="grupo-cidades" data-grupo="grupo-cidades">5 · As cidades</p>}
    <div id="cidades">
    {cidades.length > 0 && (
      <section class="cidades">
        <h2>As cidades {deUf(e.uf)}</h2>
        <p>O que cada prefeitura gastou por morador, <span data-cidades-quando>no último ano entregue</span>.</p>
        <div class="tabela" role="table" aria-label={`Municípios de ${nome}`}>
          <div class="linha cab" role="row">
            <span role="columnheader">Cidade</span>
            <span role="columnheader" class="d so-largo">Moradores</span>
            <span role="columnheader" class="d">Por morador</span>
            <span role="columnheader" class="d so-largo">Saúde/hab.</span>
            <span role="columnheader" class="d so-largo">Educação/hab.</span>
          </div>
          {cidades.map((c, i) => (
            <a href={caminhoCidade(c)} class:list={["linha", { extra: i >= LIMITE }]} role="row" data-ibge={c.ibge} data-href={caminhoCidade(c)}>
              <span role="cell" class="nome">{c.nome}</span>
              <span role="cell" class="d num so-largo muted" data-col="pop">{c.pop.toLocaleString("pt-BR")}</span>
              <span role="cell" class:list={["d num", { muted: !c.total }]} data-col="ph">{c.total ? porPessoa(c.total[0] / c.pop) : "não entregou"}</span>
              <span role="cell" class="d num so-largo" data-col="saude">{c.total ? porPessoa(ph(c, "10")) : ""}</span>
              <span role="cell" class="d num so-largo" data-col="edu">{c.total ? porPessoa(ph(c, "12")) : ""}</span>
            </a>
          ))}
          {cidades.length > LIMITE && (
            <button type="button" class="mais" data-mais>
              <span>+ {cidades.length - LIMITE} cidades menores</span><span>mostrar todas</span>
            </button>
          )}
        </div>
      </section>
    )}
    </div>

    <p class="nota">
      Fonte: Declaração de Contas Anuais (DCA, Anexo I-E) entregue pelo governo estadual ao Tesouro Nacional pelo SICONFI.
      Os números são os declarados pelo próprio estado e incluem Assembleia Legislativa, Tribunal de Justiça, Ministério Público
      e Tribunal de Contas. Empenhado é o gasto comprometido no ano; não inclui despesas intraorçamentárias.
      {ehDF
        ? " O DF acumula funções de estado e de município e por isso não é comparado com os estados."
        : <> Mediana calculada entre os 26 estados (sem o DF) que entregaram a DCA de <span data-ano-texto>{e.ano}</span>.</>}
    </p>
  </div>
</Base>

{base && <script type="application/json" id="ficha-base" set:html={JSON.stringify(base).replace(/</g, "\\u003c")} />}

<script>
  import { arquivoDoAno, iniciarTrocaDeAno } from "../../lib/troca-de-ano";

  // Ao trocar o ano, a lista de cidades do estado e o gráfico de anos acompanham.
  const linhas = [...document.querySelectorAll<HTMLElement>(".cidades [data-ibge]")];
  const originais = new Map(linhas.map((l) => [l, [...l.querySelectorAll<HTMLElement>("[data-col]")].map((c) => [c.textContent, c.className] as const)]));
  const quando = document.querySelector<HTMLElement>("[data-cidades-quando]");
  const textoQuando = quando?.textContent ?? "";
  const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
  const porPessoa = (v: number) => `R$ ${nf0.format(Math.round(v))}`;
  iniciarTrocaDeAno(async (ano, base) => {
    document.querySelectorAll<HTMLElement>(".anos [data-ano], .anos-divida [data-ano]").forEach((li) => li.classList.toggle("atual", Number(li.dataset.ano) === ano));
    // Cada cidade da lista abre no mesmo ano.
    for (const l of linhas) l.setAttribute("href", `${l.dataset.href}${ano === base.padrao ? "" : `?ano=${ano}`}`);
    if (!linhas.length) return;
    if (ano === base.padrao) {
      for (const [l, cols] of originais) l.querySelectorAll<HTMLElement>("[data-col]").forEach((c, k) => { c.textContent = cols[k][0]; c.className = cols[k][1]; });
      if (quando) quando.textContent = textoQuando;
      return;
    }
    const arq = await arquivoDoAno(ano, base.uf.toLowerCase());
    if (!arq) return;
    if (quando) quando.textContent = `em ${ano}`;
    for (const l of linhas) {
      const f = arq.entes[l.dataset.ibge!];
      const col = (nome: string) => l.querySelector<HTMLElement>(`[data-col="${nome}"]`)!;
      if (f) col("pop").textContent = f.pop.toLocaleString("pt-BR");
      col("ph").textContent = f ? porPessoa(f.total[0] / f.pop) : "não entregou";
      col("ph").classList.toggle("muted", !f);
      col("saude").textContent = f ? porPessoa((f.f["10"]?.[0] ?? 0) / f.pop) : "";
      col("edu").textContent = f ? porPessoa((f.f["12"]?.[0] ?? 0) / f.pop) : "";
    }
  });

  document.querySelector<HTMLButtonElement>("[data-mais]")?.addEventListener("click", (ev) => {
    const botao = ev.currentTarget as HTMLButtonElement;
    botao.closest(".tabela")?.classList.add("todos");
    botao.hidden = true;
  });
</script>

<style>
  .caminho { padding: 14px 0; border-bottom: 1px solid var(--regra); font-size: 14px; display: flex; gap: 10px; flex-wrap: wrap; }
  .caminho span[aria-hidden] { color: var(--texto-4); }
  .cabeca { padding: 40px 0 32px; }
  .cabeca > div { display: flex; flex-direction: column; gap: 14px; max-width: 860px; }
  .cabeca h1 { font-size: 68px; line-height: 0.98; letter-spacing: -0.025em; }
  .cabeca p { margin: 0; font-size: 20px; line-height: 1.55; color: var(--texto-2); }
  .cabeca p strong { color: var(--tinta); }
  .cabeca p.quem-publica { font-size: 15px; line-height: 1.5; color: var(--texto-3); }

  .evolucao { border-top: 2px solid var(--tinta); padding: 32px 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 32px; }
  .evolucao-texto { grid-column: span 4; display: flex; flex-direction: column; gap: 12px; }
  .evolucao h2 { font-size: 34px; }
  .evolucao-texto p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--texto-2); }
  .evolucao-texto p strong { color: var(--tinta); }
  .anos { grid-column: span 8; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .anos li { display: grid; grid-template-columns: 44px minmax(0, 1fr) 90px; gap: 14px; align-items: center; font-size: 14px; }
  .anos .ano { color: var(--texto-3); }
  .anos strong { text-align: right; }
  .anos .trilho { display: block; height: 14px; }
  .anos .trilho > span { display: block; height: 100%; background: var(--verde); }
  .anos li.atual .trilho > span { background: var(--verde-escuro); }
  .anos li.atual .ano { color: var(--tinta); font-weight: 700; }
  .cidades { border-top: 2px solid var(--tinta); padding: 32px 0; display: flex; flex-direction: column; gap: 12px; }
  .cidades h2 { font-size: 34px; }
  .cidades > p { margin: 0 0 8px; font-size: 14px; color: var(--texto-3); }
  .tabela { display: flex; flex-direction: column; }
  .linha {
    display: grid; grid-template-columns: minmax(0, 1fr) 130px 120px 120px 120px; gap: 20px; align-items: center;
    padding: 10px 0; border-bottom: 1px solid var(--regra-leve); color: var(--tinta); text-decoration: none;
  }
  a.linha:hover { background: var(--marca-texto-fundo); color: var(--tinta); }
  a.linha:hover .nome { text-decoration: underline; }
  .cab {
    font-size: 12px; color: var(--texto-3); text-transform: uppercase; letter-spacing: 0.06em;
    padding: 8px 0; border-top: 1px solid var(--tinta); border-bottom: 1px solid var(--tinta);
  }
  .d { text-align: right; }
  .nome { font-weight: 600; min-width: 0; }
  .tabela:not(.todos) .extra { display: none; }
  .mais {
    display: flex; justify-content: space-between; padding: 14px 0; font: inherit; font-size: 14px;
    color: var(--texto-3); background: none; border: 0; cursor: pointer;
  }
  .mais:hover { color: var(--verde); }
  .nota { margin: 0 0 24px; font-size: 12px; line-height: 1.5; color: var(--texto-3); max-width: 860px; }

  @media (max-width: 900px) {
    .cabeca { padding: 28px 0 24px; }
    .cabeca h1 { font-size: 40px; }
    .cabeca p { font-size: 17px; }
    .cidades h2, .evolucao h2 { font-size: 28px; }
    .evolucao { display: flex; flex-direction: column; gap: 20px; }
  }
  /* mesmo corte do .so-largo (global.css), que esconde as colunas extras */
  @media (max-width: 640px) {
    .linha { grid-template-columns: minmax(0, 1fr) auto; gap: 12px; }
  }
</style>
