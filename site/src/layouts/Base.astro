---
import "../styles/global.css";
import Busca from "../components/Busca";
import marca from "../assets/marca.svg";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "O orçamento federal brasileiro, explicado e explorável." } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="topo">
      <div class="topo-inner">
        <a class="marca" href="/">
          <img class="marca-ico" src={marca.src} width="40" height="28" alt="" />
          <span class="marca-nome"><b>Orçamento</b> <span>Brasileiro</span></span>
        </a>
        <div class="topo-direita">
          <nav aria-label="Principal">
            <a class="so-largo" href="/" aria-current={path === "/" ? "page" : undefined}>Início</a>
            <a href="/explorer" aria-current={path.startsWith("/explorer") ? "page" : undefined}>Explorer</a>
            <a href="/orgaos" aria-current={path.startsWith("/orgaos") ? "page" : undefined}>Órgãos</a>
          </nav>
          <Busca client:idle />
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="rodape">
      <div class="wrap small muted">
        Dados: <a href="https://portaldatransparencia.gov.br/download-de-dados/orcamento-despesa">Portal da
        Transparência (CGU) — Orçamento da Despesa</a>. Projeto independente, sem vínculo com o Governo Federal.
      </div>
    </footer>
  </body>
</html>

<style>
  .topo {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .topo-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; height: 64px; padding: 0 16px;
  }
  .marca {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 1.375rem; color: var(--text); text-decoration: none; text-transform: uppercase; letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .marca-ico { width: 40px; height: auto; flex: none; }
  .marca-nome b { font-weight: 700; }
  .marca-nome span { font-weight: 300; }
  .marca-nome { display: inline-flex; gap: 0; }
  .topo-direita { display: flex; align-items: center; gap: 12px; }
  nav { display: flex; gap: 4px; }
  @media (max-width: 640px) {
    .so-largo { display: none; }
    .marca { font-size: 0.9375rem; gap: 8px; }
    .marca-ico { width: 34px; }
    .marca-nome { flex-direction: column; line-height: 1.05; }
    nav a { padding: 6px 8px; }
  }
  nav a {
    color: var(--text); font-weight: 600; text-decoration: none; padding: 6px 12px; border-radius: var(--radius);
  }
  nav a:hover { color: var(--link); }
  nav a[aria-current="page"] { color: var(--link); box-shadow: inset 0 -3px 0 var(--link); border-radius: 0; }
  main { min-height: calc(100vh - 64px - 60px); }
  .rodape { border-top: 1px solid var(--border); padding: 20px 0; }
</style>
