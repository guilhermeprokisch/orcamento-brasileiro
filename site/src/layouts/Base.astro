---
import "../styles/global.css";
import Busca from "../components/Busca";
import marca from "../assets/marca.svg";

interface Props {
  title: string;
  description?: string;
  /** Linha fina abaixo do cabeçalho (data e exercício), como na página inicial. */
  dateline?: { esquerda: string; direita: string; celular: string };
}
const { title, description = "O orçamento federal brasileiro, explicado e explorável.", dateline } = Astro.props;
const path = Astro.url.pathname;
const ativo = (p: string) => (path.startsWith(p) ? "page" : undefined);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Inter:wght@400;500;600&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="wrap">
      <header class="topo">
        <a class="marca-site" href="/">
          <img src={marca.src} width="38" height="27" alt="" />
          <span>Orçamento Brasileiro</span>
        </a>
        <nav class="nav so-largo" aria-label="Principal">
          <a href="/explorer" aria-current={ativo("/explorer")}>Explorer</a>
          <a href="/orgaos" aria-current={ativo("/orgaos")}>Órgãos</a>
          <a href="/mapa/">Mapa</a>
          <a href="/aprenda" aria-current={ativo("/aprenda")}>Aprenda</a>
          <a href="/glossario" aria-current={ativo("/glossario")}>Glossário</a>
          <Busca client:idle />
        </nav>
        <div class="nav-celular so-celular">
          <Busca client:idle compacto />
          <details class="menu">
            <summary aria-label="Menu">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </summary>
            <nav aria-label="Principal no celular">
              <a href="/">Início</a>
              <a href="/explorer">Explorer</a>
              <a href="/orgaos">Órgãos</a>
              <a href="/mapa/">Mapa</a>
              <a href="/aprenda">Aprenda</a>
              <a href="/glossario">Glossário</a>
            </nav>
          </details>
        </div>
      </header>
      {dateline && (
        <div class="dateline">
          <span class="so-largo">{dateline.esquerda}</span>
          <span class="so-largo">{dateline.direita}</span>
          <span class="so-celular">{dateline.celular}</span>
        </div>
      )}
    </div>

    <main>
      <slot />
    </main>

    <div class="wrap">
      <footer class="rodape">
        <span>Fontes: <a href="https://portaldatransparencia.gov.br/download-de-dados/orcamento-despesa">Portal da Transparência (CGU)</a>, SIOP, IBGE.</span>
        <span>Projeto independente, sem vínculo com o Governo Federal.</span>
      </footer>
    </div>
  </body>
</html>

<style>
  .topo {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    height: 76px; border-bottom: 2px solid var(--tinta);
  }
  .marca-site {
    display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--tinta);
    font-family: var(--serifa); font-size: 25px; font-weight: 700; letter-spacing: -0.01em; white-space: nowrap;
  }
  .marca-site:hover { color: var(--tinta); }
  .nav { display: flex; align-items: center; gap: 28px; font-size: 15px; }
  .nav a { color: var(--tinta); text-decoration: none; padding-bottom: 2px; }
  .nav a:hover { color: var(--verde); }
  .nav a[aria-current="page"] { border-bottom: 2px solid var(--tinta); }
  .dateline {
    display: flex; justify-content: space-between; gap: 12px; padding: 10px 0;
    border-bottom: 1px solid var(--regra); font-size: 13px; color: var(--texto-3);
  }
  .rodape {
    border-top: 2px solid var(--tinta); margin-top: 48px; padding: 20px 0 28px;
    display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    font-size: 13px; color: var(--texto-3);
  }
  .rodape a { color: var(--texto-3); }

  .nav-celular { display: flex; align-items: center; gap: 4px; }
  .menu { position: relative; }
  .menu summary {
    list-style: none; width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer; color: var(--tinta);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu nav {
    position: absolute; right: 0; top: 48px; z-index: 30; min-width: 200px;
    background: var(--papel); border: 2px solid var(--tinta); box-shadow: 6px 6px 0 var(--tinta);
    display: flex; flex-direction: column;
  }
  .menu nav a { padding: 14px 18px; color: var(--tinta); text-decoration: none; border-bottom: 1px solid var(--regra-leve); }
  .menu nav a:last-child { border-bottom: 0; }

  @media (max-width: 640px) {
    .topo { height: 60px; }
    .marca-site { font-size: 19px; gap: 10px; }
    .marca-site img { width: 30px; height: auto; }
    .dateline { font-size: 12px; padding: 8px 0; }
    .rodape { flex-direction: column; font-size: 12px; margin-top: 32px; }
  }
</style>
