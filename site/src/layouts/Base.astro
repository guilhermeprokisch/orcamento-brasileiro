---
import "../styles/global.css";
import Busca from "../components/Busca";
import marca from "../assets/marca.svg";

interface Props {
  title: string;
  description?: string;
  /** Linha fina abaixo do cabeçalho (data e exercício), como na página inicial. */
  dateline?: { esquerda: string; direita: string; celular: string };
}
const { title, description = "De onde vem e para onde vai o dinheiro público da sua cidade, do seu estado e do país.", dateline } = Astro.props;
// Endereço absoluto desta página (canonical e prévia do link) e a imagem da prévia.
const site = Astro.site ?? new URL("https://orcamentobrasileiro.com.br");
const urlPagina = new URL(Astro.url.pathname, site).href;
const imagemPrevia = new URL("/previa.png", site).href;
const path = Astro.url.pathname;
// O item do menu desta página: o de endereço mais longo que começa o caminho (/emendas/explorar acende
// "Explorar", não "O que são").
const todosHrefs = () => GRUPOS.flatMap((g) => g.itens.flatMap((i) => (i.sub ? i.sub.map((s) => s.href) : [i.href])));
const ativo = (p: string) => {
  const melhor = todosHrefs().filter((h) => path.startsWith(h)).sort((a, b) => b.length - a.length)[0];
  return p === melhor ? "page" : undefined;
};

// Menu principal: as páginas agrupadas pela pergunta de quem chega. Para incluir uma página,
// acrescente um item ao grupo dela; o menu do computador e o do celular saem desta lista. Um item com
// "sub" é um título com as suas páginas embaixo, recuadas (as abas das emendas: components/emendas/EmendasAbas.astro).
interface ItemMenu { href: string; nome: string; desc: string; sub?: { href: string; nome: string; desc: string }[] }
const GRUPOS: { nome: string; itens: ItemMenu[] }[] = [
  { nome: "Governo federal", itens: [
    { href: "/explorer", nome: "Gastos", desc: "Para onde vai o dinheiro: por órgão, área, programa e ação, em blocos ou em cascata." },
    { href: "/receitas", nome: "Receitas", desc: "De onde vem o dinheiro: impostos, contribuições, royalties e empréstimos." },
    { href: "/orgaos", nome: "Órgãos", desc: "Cada ministério e órgão: quanto pode gastar e com o quê." },
    { href: "/divida", nome: "Dívida", desc: "Quanto o governo federal deve, a quem, e quanto paga de juros." },
    { href: "/contas", nome: "As contas fecham?", desc: "Se o governo gasta mais do que arrecada e quanto do gasto já está amarrado." },
  ] },
  { nome: "Estados e cidades", itens: [
    { href: "/cidades", nome: "Cidades", desc: "Quanto a prefeitura gastou em saúde, educação e outras áreas, por morador." },
    { href: "/estados", nome: "Estados", desc: "Quanto cada governo estadual gastou, área por área, por morador." },
    { href: "/mapa/", nome: "Mapa", desc: "Todas as cidades do país num mapa, para comparar." },
    { href: "/comparar", nome: "Comparar", desc: "Duas cidades ou dois estados lado a lado." },
    { href: "/quem-publica", nome: "Quem publica", desc: "Quais estados mostram quanto gastam em cada cidade." },
  ] },
  { nome: "Contratos e emendas", itens: [
    { href: "/contratos", nome: "Contratos", desc: "O que prefeituras, governos estaduais e o governo federal contrataram, e de quem." },
    { href: "/emendas", nome: "Emendas parlamentares", desc: "O que são, quanto são e para onde vão.", sub: [
      { href: "/emendas", nome: "O que são", desc: "a história, com os números" },
      { href: "/emendas/explorar", nome: "Explorar", desc: "todas as listas, por quem, onde e para quê" },
      { href: "/emendas/buscar", nome: "Buscar emenda por emenda", desc: "por lugar, parlamentar ou assunto" },
      { href: "/emendas/mapa", nome: "No mapa", desc: "para onde vai e quem manda" },
    ] },
    { href: "/obras-paradas", nome: "Obras paradas", desc: "As obras com dinheiro federal que não andam: onde estão, quanto custariam e há quanto tempo." },
  ] },
  { nome: "Políticos e servidores", itens: [
    { href: "/politicos", nome: "Políticos eleitos", desc: "Governadores, senadores e deputados: quanto custa cada um, em que gasta a verba e para onde manda emendas." },
    { href: "/supersalarios", nome: "Acima do teto", desc: "Juízes, promotores e servidores que recebem mais que o teto, órgão por órgão, e quanto isso custa." },
  ] },
  { nome: "Impostos", itens: [
    { href: "/impostos", nome: "Para quem vai o seu imposto", desc: "Quem cobra cada imposto, o que é repassado a estados e prefeituras e quem fica com o dinheiro." },
    { href: "/impostos/empresas", nome: "Quem deixa de pagar", desc: "As empresas que declaram benefícios fiscais: quanto cada uma deixa de pagar e com o quê." },
    { href: "/bndes", nome: "BNDES e estatais", desc: "Quem pega empréstimo do BNDES, com que juro, quanto custa o subsídio e o que entra e sai das estatais." },
  ] },
  { nome: "Aprenda", itens: [
    { href: "/aprenda", nome: "Lições", desc: "Como funciona o orçamento e como ler os números." },
    { href: "/glossario", nome: "Glossário", desc: "O que querem dizer empenho, dotação e outros termos." },
    { href: "/dados", nome: "Os dados", desc: "Baixe os arquivos das fontes oficiais e os dados já tratados." },
  ] },
];
const grupoAtual = (g: (typeof GRUPOS)[number]) => g.itens.some((i) => (i.sub ? i.sub.some((s) => ativo(s.href)) : ativo(i.href)));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={urlPagina} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Orçamento Brasileiro" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:image" content={imagemPrevia} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Orçamento Brasileiro: de onde vem e para onde vai o dinheiro público" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Inter:wght@400;500;600&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="wrap">
      <header class="topo">
        <a class="marca-site" href="/">
          <img src={marca.src} width="38" height="27" alt="" />
          <span>Orçamento Brasileiro</span>
        </a>
        <nav class="nav so-largo" aria-label="Principal">
          {GRUPOS.map((g, n) => (
            <details class:list={["grupo", { "a-direita": n >= GRUPOS.length - 2 }]}>
              <summary class:list={{ atual: grupoAtual(g) }}>
                {g.nome}
                <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
              </summary>
              <div class="grupo-lista">
                {g.itens.map((i) => i.sub ? (
                  <div class="grupo-bloco">
                    <a class:list={["grupo-pai", { atual: i.sub.some((s) => ativo(s.href)) }]} href={i.href} aria-haspopup="true">
                      <span class="grupo-texto">
                        <span class="grupo-nome">{i.nome}</span>
                        <span class="grupo-desc">{i.desc}</span>
                      </span>
                      <svg width="7" height="12" viewBox="0 0 7 12" aria-hidden="true"><path d="M1 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
                    </a>
                    <div class="grupo-sub">
                      {i.sub.map((s) => (
                        <a href={s.href} aria-current={ativo(s.href)}>
                          <span class="grupo-nome">{s.nome}</span>
                          <span class="grupo-desc">{s.desc}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                ) : (
                  <a href={i.href} aria-current={ativo(i.href)}>
                    <span class="grupo-nome">{i.nome}</span>
                    <span class="grupo-desc">{i.desc}</span>
                  </a>
                ))}
              </div>
            </details>
          ))}
          <Busca client:idle />
          <a class="gh" href="https://github.com/orcamento-brasileiro/orcamento-brasileiro" aria-label="O código do site no GitHub" title="O código é aberto: veja no GitHub">
            <svg width="22" height="22" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" /></svg>
          </a>
        </nav>
        <div class="nav-celular so-celular">
          <Busca client:idle compacto />
          <a class="gh" href="https://github.com/orcamento-brasileiro/orcamento-brasileiro" aria-label="O código do site no GitHub" title="O código é aberto: veja no GitHub">
            <svg width="22" height="22" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" /></svg>
          </a>
          <details class="menu">
            <summary aria-label="Menu">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </summary>
            <nav aria-label="Principal no celular">
              <a href="/">Início</a>
              {GRUPOS.map((g) => (
                <>
                  <span class="menu-grupo">{g.nome}</span>
                  {g.itens.map((i) => i.sub ? (
                    <>
                      <span class="menu-sub-titulo">{i.nome}</span>
                      <div class="menu-sub">
                        {i.sub.map((s) => <a class="menu-sub-item" href={s.href} aria-current={ativo(s.href)}>{s.nome}</a>)}
                      </div>
                    </>
                  ) : <a class="menu-item" href={i.href} aria-current={ativo(i.href)}>{i.nome}</a>)}
                </>
              ))}
              <a class="menu-codigo" href="https://github.com/orcamento-brasileiro/orcamento-brasileiro">O código no GitHub</a>
            </nav>
          </details>
        </div>
      </header>
      {dateline && (
        <div class="dateline">
          <span class="so-largo">{dateline.esquerda}</span>
          <span class="so-largo">{dateline.direita}</span>
          <span class="so-celular">{dateline.celular}</span>
        </div>
      )}
    </div>

    <main>
      <slot />
    </main>

    <div class="wrap">
      <footer class="rodape">
        <span>Dados abertos do Tesouro, da CGU, da Receita, do IBGE, do DATASUS e de outras fontes oficiais. <a href="/dados">Baixe todos os dados</a>.</span>
        <span>Projeto independente, sem vínculo com o Governo Federal. O código é aberto: <a href="https://github.com/orcamento-brasileiro/orcamento-brasileiro">veja no GitHub</a>.</span>
      </footer>
    </div>
    <script>
      // Balões das palavras técnicas (components/Termo.astro): abrem com o mouse, o teclado ou um toque,
      // fecham com Esc ou tocando fora, e são empurrados para dentro da tela quando passariam da borda.
      const posicionar = (t: HTMLElement) => requestAnimationFrame(() => {
        const b = t.querySelector<HTMLElement>(".balao");
        if (!b) return;
        t.classList.remove("abaixo");
        t.style.removeProperty("--desvio");
        const r = b.getBoundingClientRect();
        if (!r.width) return;
        if (r.top < 8) t.classList.add("abaixo");
        const d = r.left < 8 ? 8 - r.left : r.right > innerWidth - 8 ? innerWidth - 8 - r.right : 0;
        if (d) t.style.setProperty("--desvio", `${d}px`);
      });
      const termo = (alvo: EventTarget | null) => (alvo instanceof Element ? alvo.closest<HTMLElement>(".termo") : null);
      const abrir = (ev: Event) => {
        const t = termo(ev.target);
        if (t) { t.classList.remove("fechado"); posicionar(t); }
      };
      document.addEventListener("mouseover", abrir);
      document.addEventListener("focusin", abrir);
      document.addEventListener("click", (ev) => {
        const t = termo(ev.target);
        if (ev.target instanceof Element && ev.target.closest(".balao")) return;   // o link do glossário
        document.querySelectorAll<HTMLElement>(".termo.aberto").forEach((o) => { if (o !== t) o.classList.remove("aberto"); });
        if (!t) return;
        const abre = !t.classList.contains("aberto");
        t.classList.toggle("aberto", abre);
        t.classList.toggle("fechado", !abre);
        if (abre) posicionar(t);
      });
      document.addEventListener("keydown", (ev) => {
        if (ev.key !== "Escape") return;
        document.querySelectorAll<HTMLElement>(".termo").forEach((t) => { t.classList.remove("aberto"); t.classList.add("fechado"); });
      });

      // Menu principal (grupos no computador, ☰ no celular): são <details>, então abrem com clique, Enter
      // ou espaço mesmo sem JavaScript. Aqui: um aberto por vez, e fecham com Esc, com um clique fora
      // ou quando o foco sai deles.
      const menus = () => document.querySelectorAll<HTMLDetailsElement>("details.grupo, details.menu");
      document.addEventListener("toggle", (ev) => {
        const d = ev.target;
        if (d instanceof HTMLDetailsElement && d.open && d.matches(".grupo, .menu")) menus().forEach((o) => { if (o !== d) o.open = false; });
      }, true);
      document.addEventListener("click", (ev) => {
        const dentro = ev.target instanceof Element ? ev.target.closest("details.grupo, details.menu") : null;
        menus().forEach((o) => { if (o !== dentro) o.open = false; });
      });
      document.addEventListener("focusout", (ev) => {
        const d = ev.target instanceof Element ? ev.target.closest<HTMLDetailsElement>("details.grupo") : null;
        if (d?.open && ev.relatedTarget instanceof Node && !d.contains(ev.relatedTarget)) d.open = false;
      });
      document.addEventListener("keydown", (ev) => {
        if (ev.key !== "Escape") return;
        const aberto = [...menus()].find((d) => d.open);
        if (!aberto) return;
        aberto.open = false;
        aberto.querySelector("summary")?.focus();
      });
    </script>
  </body>
</html>

<style>
  .topo {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    height: 76px; border-bottom: 2px solid var(--tinta);
  }
  .marca-site {
    display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--tinta);
    font-family: var(--serifa); font-size: 25px; font-weight: 700; letter-spacing: -0.01em; white-space: nowrap;
  }
  .marca-site:hover { color: var(--tinta); }
  .nav { display: flex; align-items: center; gap: 18px; font-size: 15px; }

  /* Grupos do menu: o nome abre uma lista com uma frase por página. */
  .grupo { position: relative; }
  .grupo summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: 7px; white-space: nowrap;
    color: var(--tinta); padding: 8px 0 4px; border-bottom: 2px solid transparent;
  }
  .grupo summary::-webkit-details-marker { display: none; }
  .grupo summary:hover { color: var(--verde); }
  .grupo summary.atual { border-bottom-color: var(--tinta); }
  .grupo[open] summary { border-bottom-color: var(--verde); }
  .grupo summary svg { transition: transform 0.15s; }
  .grupo[open] summary svg { transform: rotate(180deg); }
  .grupo-lista {
    position: absolute; top: calc(100% + 12px); left: 0; z-index: 30; width: 360px;
    background: var(--papel); border: 2px solid var(--tinta); box-shadow: 6px 6px 0 var(--tinta);
    display: flex; flex-direction: column;
  }
  .grupo.a-direita .grupo-lista { left: auto; right: 0; }
  .grupo-lista > a {
    display: flex; flex-direction: column; gap: 3px; padding: 14px 18px;
    color: var(--tinta); text-decoration: none; border-bottom: 1px solid var(--regra-leve);
  }
  .grupo-lista > :last-child { border-bottom: 0; }
  .grupo-lista a:hover, .grupo-lista a:focus-visible { background: var(--marca-texto-fundo); }
  .grupo-lista a[aria-current="page"] { box-shadow: inset 4px 0 0 var(--verde); }
  /* Um item com páginas embaixo (as abas das emendas): a linha leva a /emendas e, ao passar o mouse
     ou chegar pelo teclado, abre ao lado um submenu com as páginas. */
  .grupo-bloco { position: relative; border-bottom: 1px solid var(--regra-leve); }
  .grupo-pai {
    display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 14px 18px;
    color: var(--tinta); text-decoration: none;
  }
  .grupo-texto { display: flex; flex-direction: column; gap: 3px; }
  .grupo-pai svg { flex: none; color: var(--texto-3); }
  .grupo-pai.atual { box-shadow: inset 4px 0 0 var(--verde); }
  .grupo-bloco:hover > .grupo-pai, .grupo-bloco:focus-within > .grupo-pai { background: var(--marca-texto-fundo); }
  .grupo-bloco:hover > .grupo-pai svg, .grupo-bloco:focus-within > .grupo-pai svg { color: var(--tinta); }
  .grupo-sub {
    display: none; position: absolute; top: -2px; left: 100%; z-index: 31; width: 280px;
    flex-direction: column; background: var(--papel); border: 2px solid var(--tinta); box-shadow: 6px 6px 0 var(--tinta);
  }
  .grupo-bloco:hover > .grupo-sub, .grupo-bloco:focus-within > .grupo-sub { display: flex; }
  .grupo.a-direita .grupo-sub { left: auto; right: 100%; }
  .grupo-sub a {
    display: flex; flex-direction: column; gap: 3px; padding: 14px 18px;
    color: var(--tinta); text-decoration: none; border-bottom: 1px solid var(--regra-leve);
  }
  .grupo-sub a:last-child { border-bottom: 0; }
  .grupo-nome { font-weight: 600; }
  .grupo-desc { font-size: 14px; line-height: 1.45; color: var(--texto-3); }
  .dateline {
    display: flex; justify-content: space-between; gap: 12px; padding: 10px 0;
    border-bottom: 1px solid var(--regra); font-size: 13px; color: var(--texto-3);
  }
  .rodape {
    border-top: 2px solid var(--tinta); margin-top: 48px; padding: 20px 0 28px;
    display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    font-size: 13px; color: var(--texto-3);
  }
  .rodape a { color: var(--texto-3); }

  .nav-celular { display: flex; align-items: center; gap: 4px; }
  /* O ícone do GitHub: o código do site é aberto. */
  .gh { width: 40px; height: 40px; display: grid; place-items: center; color: var(--tinta); flex: none; }
  .gh:hover, .gh:focus-visible { color: var(--verde); }
  .nav .gh { width: 28px; }
  /* No celular estreito não cabe ao lado da busca e do menu: vai para dentro do menu. */
  .menu .menu-codigo { display: none; border-top: 1px solid var(--regra-leve); }
  @media (max-width: 420px) {
    .nav-celular .gh { display: none; }
    .menu nav a.menu-codigo { display: block; }
  }
  .menu { position: relative; }
  .menu summary {
    list-style: none; width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer; color: var(--tinta);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu nav {
    position: absolute; right: 0; top: 48px; z-index: 30; width: min(290px, calc(100vw - 40px));
    background: var(--papel); border: 2px solid var(--tinta); box-shadow: 6px 6px 0 var(--tinta);
    display: flex; flex-direction: column;
  }
  .menu nav a { padding: 14px 18px; color: var(--tinta); text-decoration: none; border-bottom: 1px solid var(--regra-leve); }
  .menu nav a:last-child { border-bottom: 0; }
  .menu nav { max-height: calc(100dvh - 90px); overflow-y: auto; }
  .menu .menu-grupo {
    padding: 14px 18px 4px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--texto-3); border-top: 1px solid var(--regra-leve);
  }
  .menu nav a.menu-item { padding: 10px 18px 10px 30px; border-bottom: 0; }
  /* as abas das emendas: o título e, recuadas com um fio, as três páginas */
  .menu .menu-sub-titulo { padding: 10px 18px 2px 30px; font-weight: 600; }
  .menu .menu-sub { display: flex; flex-direction: column; margin: 0 0 6px 30px; border-left: 2px solid var(--regra); }
