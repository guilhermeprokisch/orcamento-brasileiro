---
import "../styles/global.css";
import Busca from "../components/Busca";
import marca from "../assets/marca.svg";

interface Props {
  title: string;
  description?: string;
  /** Linha fina abaixo do cabeçalho (data e exercício), como na página inicial. */
  dateline?: { esquerda: string; direita: string; celular: string };
}
const { title, description = "De onde vem e para onde vai o dinheiro público da sua cidade, do seu estado e do país.", dateline } = Astro.props;
// Endereço absoluto desta página (canonical e prévia do link) e a imagem da prévia.
const site = Astro.site ?? new URL("https://orcamentobrasileiro.com.br");
const urlPagina = new URL(Astro.url.pathname, site).href;
const imagemPrevia = new URL("/previa.png", site).href;
const path = Astro.url.pathname;
const ativo = (p: string) => (path.startsWith(p) ? "page" : undefined);

// Menu principal: as páginas agrupadas pela pergunta de quem chega. Para incluir uma página,
// acrescente um item ao grupo dela; o menu do computador e o do celular saem desta lista.
const GRUPOS = [
  { nome: "Governo federal", itens: [
    { href: "/explorer", nome: "Gastos", desc: "Para onde vai o dinheiro: por órgão, área, programa e ação." },
    { href: "/receitas", nome: "Receitas", desc: "De onde vem o dinheiro: impostos, contribuições, royalties e empréstimos." },
    { href: "/orgaos", nome: "Órgãos", desc: "Cada ministério e órgão: quanto pode gastar e com o quê." },
  ] },
  { nome: "Estados e cidades", itens: [
    { href: "/cidades", nome: "Cidades", desc: "Quanto a prefeitura gastou em saúde, educação e outras áreas, por morador." },
    { href: "/estados", nome: "Estados", desc: "Quanto cada governo estadual gastou, área por área, por morador." },
    { href: "/mapa/", nome: "Mapa", desc: "Todas as cidades do país num mapa, para comparar." },
  ] },
  { nome: "Contratos e emendas", itens: [
    { href: "/contratos", nome: "Contratos", desc: "O que prefeituras e governos estaduais contrataram, e de quem." },
    { href: "/emendas", nome: "Emendas", desc: "O dinheiro que deputados e senadores mandam: para onde e para quem." },
  ] },
  { nome: "Aprenda", itens: [
    { href: "/aprenda", nome: "Lições", desc: "Como funciona o orçamento e como ler os números." },
    { href: "/glossario", nome: "Glossário", desc: "O que querem dizer empenho, dotação e outros termos." },
    { href: "/dados", nome: "Os dados", desc: "Baixe os arquivos das fontes oficiais e os dados já tratados." },
  ] },
];
const grupoAtual = (g: (typeof GRUPOS)[number]) => g.itens.some((i) => ativo(i.href));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={urlPagina} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Orçamento Brasileiro" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:image" content={imagemPrevia} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Orçamento Brasileiro: de onde vem e para onde vai o dinheiro público" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Inter:wght@400;500;600&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="wrap">
      <header class="topo">
        <a class="marca-site" href="/">
          <img src={marca.src} width="38" height="27" alt="" />
          <span>Orçamento Brasileiro</span>
        </a>
        <nav class="nav so-largo" aria-label="Principal">
          {GRUPOS.map((g, n) => (
            <details class:list={["grupo", { "a-direita": n >= 2 }]}>
              <summary class:list={{ atual: grupoAtual(g) }}>
                {g.nome}
                <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
              </summary>
              <div class="grupo-lista">
                {g.itens.map((i) => (
                  <a href={i.href} aria-current={ativo(i.href)}>
                    <span class="grupo-nome">{i.nome}</span>
                    <span class="grupo-desc">{i.desc}</span>
                  </a>
                ))}
              </div>
            </details>
          ))}
          <Busca client:idle />
        </nav>
        <div class="nav-celular so-celular">
          <Busca client:idle compacto />
          <details class="menu">
            <summary aria-label="Menu">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </summary>
            <nav aria-label="Principal no celular">
              <a href="/">Início</a>
              {GRUPOS.map((g) => (
                <>
                  <span class="menu-grupo">{g.nome}</span>
                  {g.itens.map((i) => <a class="menu-item" href={i.href} aria-current={ativo(i.href)}>{i.nome}</a>)}
                </>
              ))}
            </nav>
          </details>
        </div>
      </header>
      {dateline && (
        <div class="dateline">
          <span class="so-largo">{dateline.esquerda}</span>
          <span class="so-largo">{dateline.direita}</span>
          <span class="so-celular">{dateline.celular}</span>
        </div>
      )}
    </div>

    <main>
      <slot />
    </main>

    <div class="wrap">
      <footer class="rodape">
        <span>Dados abertos do Tesouro, da CGU, da Receita, do IBGE, do DATASUS e de outras fontes oficiais. <a href="/dados">Baixe todos os dados</a>.</span>
        <span>Projeto independente, sem vínculo com o Governo Federal.</span>
      </footer>
    </div>
    <script>
      // Balões das palavras técnicas (components/Termo.astro): abrem com o mouse, o teclado ou um toque,
      // fecham com Esc ou tocando fora, e são empurrados para dentro da tela quando passariam da borda.
      const posicionar = (t: HTMLElement) => requestAnimationFrame(() => {
        const b = t.querySelector<HTMLElement>(".balao");
        if (!b) return;
        t.classList.remove("abaixo");
        t.style.removeProperty("--desvio");
        const r = b.getBoundingClientRect();
        if (!r.width) return;
        if (r.top < 8) t.classList.add("abaixo");
        const d = r.left < 8 ? 8 - r.left : r.right > innerWidth - 8 ? innerWidth - 8 - r.right : 0;
        if (d) t.style.setProperty("--desvio", `${d}px`);
      });
      const termo = (alvo: EventTarget | null) => (alvo instanceof Element ? alvo.closest<HTMLElement>(".termo") : null);
      const abrir = (ev: Event) => {
        const t = termo(ev.target);
        if (t) { t.classList.remove("fechado"); posicionar(t); }
      };
      document.addEventListener("mouseover", abrir);
      document.addEventListener("focusin", abrir);
      document.addEventListener("click", (ev) => {
        const t = termo(ev.target);
        if (ev.target instanceof Element && ev.target.closest(".balao")) return;   // o link do glossário
        document.querySelectorAll<HTMLElement>(".termo.aberto").forEach((o) => { if (o !== t) o.classList.remove("aberto"); });
        if (!t) return;
        const abre = !t.classList.contains("aberto");
        t.classList.toggle("aberto", abre);
        t.classList.toggle("fechado", !abre);
        if (abre) posicionar(t);
      });
      document.addEventListener("keydown", (ev) => {
        if (ev.key !== "Escape") return;
        document.querySelectorAll<HTMLElement>(".termo").forEach((t) => { t.classList.remove("aberto"); t.classList.add("fechado"); });
      });

      // Menu principal (grupos no computador, ☰ no celular): são <details>, então abrem com clique, Enter
      // ou espaço mesmo sem JavaScript. Aqui: um aberto por vez, e fecham com Esc, com um clique fora
      // ou quando o foco sai deles.
      const menus = () => document.querySelectorAll<HTMLDetailsElement>("details.grupo, details.menu");
      document.addEventListener("toggle", (ev) => {
        const d = ev.target;
        if (d instanceof HTMLDetailsElement && d.open && d.matches(".grupo, .menu")) menus().forEach((o) => { if (o !== d) o.open = false; });
      }, true);
      document.addEventListener("click", (ev) => {
        const dentro = ev.target instanceof Element ? ev.target.closest("details.grupo, details.menu") : null;
        menus().forEach((o) => { if (o !== dentro) o.open = false; });
      });
      document.addEventListener("focusout", (ev) => {
        const d = ev.target instanceof Element ? ev.target.closest<HTMLDetailsElement>("details.grupo") : null;
        if (d?.open && ev.relatedTarget instanceof Node && !d.contains(ev.relatedTarget)) d.open = false;
      });
      document.addEventListener("keydown", (ev) => {
        if (ev.key !== "Escape") return;
        const aberto = [...menus()].find((d) => d.open);
        if (!aberto) return;
        aberto.open = false;
        aberto.querySelector("summary")?.focus();
      });
    </script>
  </body>
</html>

<style>
  .topo {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    height: 76px; border-bottom: 2px solid var(--tinta);
  }
  .marca-site {
    display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--tinta);
    font-family: var(--serifa); font-size: 25px; font-weight: 700; letter-spacing: -0.01em; white-space: nowrap;
  }
  .marca-site:hover { color: var(--tinta); }
  .nav { display: flex; align-items: center; gap: 28px; font-size: 15px; }

  /* Grupos do menu: o nome abre uma lista com uma frase por página. */
  .grupo { position: relative; }
  .grupo summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: 7px; white-space: nowrap;
    color: var(--tinta); padding: 8px 0 4px; border-bottom: 2px solid transparent;
  }
  .grupo summary::-webkit-details-marker { display: none; }
  .grupo summary:hover { color: var(--verde); }
  .grupo summary.atual { border-bottom-color: var(--tinta); }
  .grupo[open] summary { border-bottom-color: var(--verde); }
  .grupo summary svg { transition: transform 0.15s; }
  .grupo[open] summary svg { transform: rotate(180deg); }
  .grupo-lista {
    position: absolute; top: calc(100% + 12px); left: 0; z-index: 30; width: 340px;
    background: var(--papel); border: 2px solid var(--tinta); box-shadow: 6px 6px 0 var(--tinta);
    display: flex; flex-direction: column;
  }
  .grupo.a-direita .grupo-lista { left: auto; right: 0; }
  .grupo-lista a {
    display: flex; flex-direction: column; gap: 3px; padding: 14px 18px;
    color: var(--tinta); text-decoration: none; border-bottom: 1px solid var(--regra-leve);
  }
  .grupo-lista a:last-child { border-bottom: 0; }
  .grupo-lista a:hover, .grupo-lista a:focus-visible { background: var(--marca-texto-fundo); }
  .grupo-lista a[aria-current="page"] { box-shadow: inset 4px 0 0 var(--verde); }
  .grupo-nome { font-weight: 600; }
  .grupo-desc { font-size: 14px; line-height: 1.45; color: var(--texto-3); }
  .dateline {
    display: flex; justify-content: space-between; gap: 12px; padding: 10px 0;
    border-bottom: 1px solid var(--regra); font-size: 13px; color: var(--texto-3);
  }
  .rodape {
    border-top: 2px solid var(--tinta); margin-top: 48px; padding: 20px 0 28px;
    display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    font-size: 13px; color: var(--texto-3);
  }
  .rodape a { color: var(--texto-3); }

  .nav-celular { display: flex; align-items: center; gap: 4px; }
  .menu { position: relative; }
  .menu summary {
    list-style: none; width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer; color: var(--tinta);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu nav {
    position: absolute; right: 0; top: 48px; z-index: 30; min-width: 200px;
    background: var(--papel); border: 2px solid var(--tinta); box-shadow: 6px 6px 0 var(--tinta);
    display: flex; flex-direction: column;
  }
  .menu nav a { padding: 14px 18px; color: var(--tinta); text-decoration: none; border-bottom: 1px solid var(--regra-leve); }
  .menu nav a:last-child { border-bottom: 0; }
  .menu nav { max-height: calc(100dvh - 90px); overflow-y: auto; }
  .menu .menu-grupo {
    padding: 14px 18px 4px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--texto-3); border-top: 1px solid var(--regra-leve);
  }
  .menu nav a.menu-item { padding: 10px 18px 10px 30px; border-bottom: 0; }
  .menu nav a[aria-current="page"] { background: var(--marca-texto-fundo); box-shadow: inset 4px 0 0 var(--verde); }

  /* Entre o celular e a tela larga o menu completo não cabe ao lado da marca: fica o menu
     recolhido, como no celular (as classes so-largo e so-celular trocam em 640px). A marca, os
     quatro grupos e a busca pedem ~1.040px, ou seja, uma tela de ~1.170px. Páginas novas entram
     dentro dos grupos e não mudam essa conta. */
  @media (min-width: 641px) and (max-width: 1180px) {
    .topo .nav.so-largo { display: none !important; }
    .topo .nav-celular.so-celular { display: flex !important; }
  }
  @media (max-width: 640px) {
    .topo { height: 60px; }
    .marca-site { font-size: 19px; gap: 10px; }
    .marca-site img { width: 30px; height: auto; }
    .dateline { font-size: 12px; padding: 8px 0; }
    .rodape { flex-direction: column; font-size: 12px; margin-top: 32px; }
  }
</style>
